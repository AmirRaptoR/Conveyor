#!/usr/bin/env bash
# testing — review the pull request before it is called done.
#
# A different agent on purpose: the model that wrote the code is the worst
# reviewer of it. Swap this for any reviewer without touching the pipeline.
set -euo pipefail

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")

pr=$(gh pr list --repo "$REPO" --state open --search "$ref" --json number --jq '.[0].number' 2>/dev/null)
if [[ -z "$pr" ]]; then
	echo "no open PR for #$ref to review" >&2
	exit 20
fi

echo "reviewing PR #$pr for issue #$ref"

read -r -d '' PROMPT <<PROMPT_END || true
Review pull request #$pr in $REPO, which closes issue #$ref.

Inspect the diff with: gh pr diff $pr --repo $REPO
Read the issue acceptance criteria: gh issue view $ref --repo $REPO

Judge only: does the diff actually satisfy the acceptance criteria, and does it
introduce a correctness bug? Ignore style.

Post findings with: gh pr comment $pr --repo $REPO --body-file -
Then print exactly APPROVED or CHANGES_REQUESTED as your final line.
PROMPT_END

set +e
out=$(codex exec "$PROMPT" --skip-git-repo-check 2>&1)
rc=$?
set -e
printf '%s\n' "$out"

[[ $rc -ne 0 ]] && exit $rc

# A review that wants changes is not a failure of this stage — it is a fact
# that needs a human, so it parks in `blocked` rather than retrying forever.
if grep -q 'CHANGES_REQUESTED' <<<"$out"; then
	echo "review requested changes on PR #$pr" >&2
	exit 20
fi
exit 0
