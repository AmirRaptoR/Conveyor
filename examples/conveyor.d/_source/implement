#!/usr/bin/env bash
# in-progress — implement the issue and open a pull request.
#
# The long stage. Conveyor's per-stage `timeout:` bounds it, and a timeout kills
# the whole process group, so agent subprocesses cannot outlive the deadline.
set -euo pipefail

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")

# A dirty tree means the previous run died mid-edit. Building on top of that is
# how one failure becomes a corrupted branch, so stop and ask for a human.
if [[ -n "$(git status --porcelain)" ]]; then
	echo "worktree is dirty; refusing to start" >&2
	exit 20
fi
# Only pull when there is something to pull from: `git pull` exits non-zero on
# a branch with no upstream, which under `set -e` would kill this script before
# the agent ever runs, with an error that looks nothing like the cause.
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
	git pull --ff-only
else
	echo "no upstream for $(git branch --show-current); skipping pull" >&2
fi

echo "implementing #$ref — $title"

read -r -d '' PROMPT <<PROMPT_END || true
Implement issue #$ref ("$title") in this repository.

Read it with: gh issue view $ref --repo $REPO

Work test-first where the repo has tests. Then:
  1. create a branch named issue-$ref
  2. implement until the issue acceptance criteria are met
  3. run the repo test suite and make it pass
  4. commit, push, and open a PR that closes #$ref

If the issue cannot be implemented as written, change nothing and write
{"blocked": true, "reason": "<why>"} to the file at \$CONVEYOR_RESULT.
PROMPT_END

set +e
claude -p "$PROMPT" \
	--max-turns "${MAX_TURNS:-200}" \
	--permission-mode acceptEdits \
	--allowedTools "Bash,Read,Edit,Write,Glob,Grep,Agent,Skill"
rc=$?
set -e

if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
	[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
	echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
	exit 20
fi

# GitHub is the record, never the agent's claim. If no PR references the issue,
# the work did not land no matter what the transcript said.
pr=$(gh pr list --repo "$REPO" --state open --search "$ref" --json number --jq '.[0].number' 2>/dev/null)
if [[ -z "$pr" ]]; then
	echo "no open PR references #$ref" >&2
	exit 20
fi
echo "opened PR #$pr"
exit $rc
