#!/usr/bin/env bash
# Exercise the OpenCode event adapter without making a model call.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/state"

cat >"$tmp/bin/opencode" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "--version" ]]; then
	echo "${OC_VERSION:-1.18.32}"
	exit 0
fi
if [[ "${1:-}" == "--pure" && "${2:-}" == "debug" && "${3:-}" == "config" ]]; then
	echo '{}'
	exit 0
fi
if [[ "${1:-}" == "--pure" && "${2:-}" == "debug" && "${3:-}" == "agent" ]]; then
	case "${4:-}" in
	build) echo '{"name":"build","mode":"primary"}' ;;
	general) echo '{"name":"general","mode":"subagent"}' ;;
	*) exit 1 ;;
	esac
	exit 0
fi
if [[ "${1:-}" == "--pure" && "${2:-}" == "models" ]]; then
	echo 'openai/gpt-test'
	exit 0
fi
printf '%s\n' "$@" >"$OC_ARGS"
cat >"$OC_PROMPT"
run_no=1
if [[ -s "$OC_CALLS" ]]; then run_no=$(($(cat "$OC_CALLS") + 1)); fi
printf '%s\n' "$run_no" >"$OC_CALLS"
cp "$OC_ARGS" "$OC_ARGS.$run_no"
cp "$OC_PROMPT" "$OC_PROMPT.$run_no"
printf '%s' "${OPENCODE_CONFIG_CONTENT:-}" >"$OC_CONFIG.$run_no"
printf '%s\n' "$run_no" >>"$OC_STARTS"
printf '%s\n' "$$" >>"$OC_PIDS"
printf '%s\n' "${CONVEYOR_RESULT+exposed}" >>"$OC_RESULT_ENV"
if [[ -n "${CONVEYOR_CONTROL_ACK:-}" && -s "${CONVEYOR_CONTROL_ACK:-}" ]] &&
	jq -e 'select(.type == "hello")' "$CONVEYOR_CONTROL_ACK" >/dev/null 2>&1; then
	printf 'yes\n' >>"$OC_HELLO_BEFORE_RUN"
else
	printf 'no\n' >>"$OC_HELLO_BEFORE_RUN"
fi
case "${OC_SCENE:-success}" in
success)
	printf '%s\n' \
		'{"type":"step_start","timestamp":1,"sessionID":"ses-good","part":{"id":"p1","type":"step-start"}}' \
		'{"type":"text","timestamp":2,"sessionID":"ses-good","part":{"id":"p2","type":"text","text":"{\"v\":1,\"outcome\":\"success\",\"summary\":\"work complete\"}"}}' \
		'{"type":"text","timestamp":2,"sessionID":"ses-good","part":{"id":"p2","type":"text","text":"{\"v\":1,\"outcome\":\"success\",\"summary\":\"work complete\"}"}}' \
		'{"type":"tool_use","timestamp":3,"sessionID":"ses-good","part":{"id":"p3","type":"tool","tool":"bash","state":{"status":"completed","title":"run tests","output":"SECRET TOOL OUTPUT"}}}' \
		'{"type":"step_finish","timestamp":4,"sessionID":"ses-good","part":{"id":"p4","type":"step-finish","reason":"stop","tokens":{"input":10,"output":2}}}'
	;;
secrets)
	text=$(jq -nc --arg summary "saw $SHORT_KEY and $API_SECRET" '{v:1,outcome:"success",summary:$summary}')
	printf 'provider stderr: %s / %s\n' "$API_SECRET" "$ESCAPED_SECRET" >&2
	jq -nc '{type:"step_start",timestamp:1,sessionID:"ses-secrets",part:{id:"start",type:"step-start"}}'
	jq -nc --arg text "$text" '{type:"text",timestamp:2,sessionID:"ses-secrets",part:{id:"text",type:"text",text:$text}}'
	jq -nc '{type:"step_finish",timestamp:3,sessionID:"ses-secrets",part:{id:"finish",type:"step-finish",reason:"stop"}}'
	;;
waiting)
	printf '%s\n' \
		'{"type":"step_start","timestamp":1,"sessionID":"ses-waiting","part":{"id":"start","type":"step-start"}}' \
		'{"type":"text","timestamp":2,"sessionID":"ses-waiting","part":{"id":"text","type":"text","text":"{\"v\":1,\"outcome\":\"waiting\",\"waiting\":{\"why\":\"checks are running\"}}"}}' \
		'{"type":"step_finish","timestamp":3,"sessionID":"ses-waiting","part":{"id":"finish","type":"step-finish","reason":"stop"}}'
	;;
split-fenced)
	jq -nc --arg text $'```json\n' '{type:"step_start",timestamp:1,sessionID:"ses-fenced",part:{id:"start",type:"step-start"}}, {type:"text",timestamp:2,sessionID:"ses-fenced",part:{id:"one",type:"text",text:$text}}'
	jq -nc --arg text $'{"v":1,"outcome":"success","summary":"split fenced"}\n' '{type:"text",timestamp:3,sessionID:"ses-fenced",part:{id:"two",type:"text",text:$text}}'
	jq -nc --arg text '```' '{type:"text",timestamp:4,sessionID:"ses-fenced",part:{id:"three",type:"text",text:$text}}'
	jq -nc '{type:"step_finish",timestamp:5,sessionID:"ses-fenced",part:{id:"finish",type:"step-finish",reason:"stop"}}'
	;;
terminal-truncated)
	printf '%s\n' \
		'{"type":"step_start","timestamp":1,"sessionID":"ses-truncated","part":{"id":"start-one","type":"step-start"}}' \
		'{"type":"text","timestamp":2,"sessionID":"ses-truncated","part":{"id":"text-one","type":"text","text":"{\"v\":1,\"outcome\":\"success\"}"}}' \
		'{"type":"step_finish","timestamp":3,"sessionID":"ses-truncated","part":{"id":"finish-one","type":"step-finish","reason":"stop"}}' \
		'{"type":"step_start","timestamp":4,"sessionID":"ses-truncated","part":{"id":"start-two","type":"step-start"}}' \
		'{"type":"text","timestamp":5,"sessionID":"ses-truncated","part":{"id":"text-two","type":"text","text":"partial"}}'
	;;
invalid-once|invalid-always)
	text='not json'
	if [[ "$OC_SCENE" == invalid-once && "$run_no" -gt 1 ]]; then
		text='{"v":1,"outcome":"success","summary":"corrected"}'
	fi
	jq -nc --arg text "$text" '{type:"step_start",timestamp:1,sessionID:"ses-invalid",part:{id:"start",type:"step-start"}}'
	jq -nc --arg text "$text" '{type:"text",timestamp:2,sessionID:"ses-invalid",part:{id:"text",type:"text",text:$text}}'
	jq -nc '{type:"step_finish",timestamp:3,sessionID:"ses-invalid",part:{id:"finish",type:"step-finish",reason:"stop"}}'
	;;
duplicate-once|duplicate-always)
	if [[ "$OC_SCENE" == duplicate-once && "$run_no" -gt 1 ]]; then
		printf '%s\n' \
			'{"type":"step_start","timestamp":1,"sessionID":"ses-duplicate","part":{"id":"correct-start","type":"step-start"}}' \
			'{"type":"text","timestamp":2,"sessionID":"ses-duplicate","part":{"id":"correct-text","type":"text","text":"{\"v\":1,\"outcome\":\"success\",\"summary\":\"corrected duplicate\"}"}}' \
			'{"type":"step_finish","timestamp":3,"sessionID":"ses-duplicate","part":{"id":"correct-finish","type":"step-finish","reason":"stop"}}'
	else
		printf '%s\n' \
			'{"type":"step_start","timestamp":1,"sessionID":"ses-duplicate","part":{"id":"duplicate-start","type":"step-start"}}' \
			'{"type":"text","timestamp":2,"sessionID":"ses-duplicate","part":{"id":"duplicate-text","type":"text","text":"{\"v\":1,\"outcome\":\"success\",\"summary\":\"ambiguous\"}"}}' \
			'{"type":"step_finish","timestamp":3,"sessionID":"ses-duplicate","part":{"id":"finish-one","type":"step-finish","reason":"stop"}}' \
			'{"type":"step_finish","timestamp":4,"sessionID":"ses-duplicate","part":{"id":"finish-two","type":"step-finish","reason":"stop"}}'
	fi
	;;
limit)
	printf '%s\n' '{"type":"error","timestamp":1,"sessionID":"ses-limit","error":{"name":"FreeUsageLimitError","data":{"message":"free usage limit reached","responseBody":"SECRET PROVIDER BODY"}}}'
	;;
generic429)
	printf '%s\n' '{"type":"error","timestamp":1,"sessionID":"ses-rate","error":{"name":"APIError","data":{"message":"too many requests","statusCode":429}}}'
	;;
malformed)
	trap 'echo TERM >"$OC_ABORTED"; exit 0' TERM
	echo 'not-json'
	deadline=$((SECONDS + 3))
	while ((SECONDS < deadline)); do :; done
	;;
incomplete)
	trap 'echo TERM >"$OC_ABORTED"; exit 0' TERM
	printf '%s\n' '{"type":"text","timestamp":1,"sessionID":"ses-incomplete","part":{"id":"p","type":"text","text":"partial"}}'
	exec 1>&-
	deadline=$((SECONDS + 3))
	while ((SECONDS < deadline)); do :; done
	;;
mismatch)
	printf '%s\n' \
		'{"type":"step_start","timestamp":1,"sessionID":"ses-one","part":{"id":"p1","type":"step-start"}}' \
		'{"type":"step_finish","timestamp":2,"sessionID":"ses-two","part":{"id":"p2","type":"step-finish"}}'
	;;
sleep)
	sleep 300 &
	echo "$!" >"$OC_CHILD"
	wait
	;;
steering|delivery-fail|pause)
	if ((run_no > 1)); then
		if jq -e --arg id "${OC_COMMAND_ID:-}" 'select(.type == "ack" and .id == $id)' \
			"$CONVEYOR_CONTROL_ACK" >/dev/null 2>&1; then
			echo early >"$OC_EARLY_ACK"
		fi
		if [[ "$OC_SCENE" == delivery-fail ]]; then exit 73; fi
		printf '%s\n' \
			'{"type":"step_start","timestamp":6,"sessionID":"ses-steer","part":{"id":"continued-start","type":"step-start"}}' \
			'{"type":"text","timestamp":7,"sessionID":"ses-steer","part":{"id":"continued-text","type":"text","text":"{\"v\":1,\"outcome\":\"success\",\"summary\":\"continued\"}"}}' \
			'{"type":"step_finish","timestamp":8,"sessionID":"ses-steer","part":{"id":"continued-finish","type":"step-finish"}}'
		exit 0
	fi
	if [[ "${OC_STOP_MODE:-term}" == term ]]; then
		trap 'echo TERM >>"$OC_SIGNALS"; exit 0' TERM
	else
		trap '' TERM
	fi
	mapfile -t boundary_lines <"$OC_BOUNDARY_FIXTURE"
	printf '%s\n' "${boundary_lines[@]:0:3}"
	sleep 0.2
	if jq -e --arg id "${OC_COMMAND_ID:-}" 'select(.type == "ack" and .id == $id)' \
		"$CONVEYOR_CONTROL_ACK" >/dev/null 2>&1; then
		echo unsafe >"$OC_UNSAFE_ACK"
	fi
	printf '%s\n' "${boundary_lines[@]:3}"
	while :; do sleep 0.05; done
	;;
boundary-exit)
	cat "$OC_BOUNDARY_FIXTURE"
	;;
esac
STUB
chmod +x "$tmp/bin/opencode"

export PATH="$tmp/bin:$PATH"
export XDG_STATE_HOME="$tmp/state"
export OC_ARGS="$tmp/args" OC_PROMPT="$tmp/prompt" OC_CALLS="$tmp/calls" OC_STARTS="$tmp/starts" OC_PIDS="$tmp/pids"
export OC_HELLO_BEFORE_RUN="$tmp/hello-before-run" OC_SIGNALS="$tmp/signals"
export OC_EARLY_ACK="$tmp/early-ack" OC_UNSAFE_ACK="$tmp/unsafe-ack"
export OC_ABORTED="$tmp/aborted"
export OC_RESULT_ENV="$tmp/result-env"
export OC_CONFIG="$tmp/config"
export OC_BOUNDARY_FIXTURE="$here/fixtures/steering-boundaries-synthetic.jsonl"
export MODEL=openai/gpt-test VARIANT=high AGENT=build
export CONVEYOR_SOURCE=test CONVEYOR_STAGE=working CONVEYOR_ITEM_REF=7
export CONVEYOR_RESULT="$tmp/result.json"

source "$here/_stream"
trap 'rm -rf "$tmp" "$_OPENCODE_TMP"' EXIT

fail=0
chk() { if [[ "$2" == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fail=1; fi; }

reset_invocations() {
	rm -f "$OC_CALLS" "$OC_STARTS" "$OC_PIDS" "$OC_HELLO_BEFORE_RUN" "$OC_SIGNALS" \
		"$OC_EARLY_ACK" "$OC_UNSAFE_ACK" "$OC_ABORTED" "$OC_RESULT_ENV" "$OC_ARGS".* "$OC_PROMPT".* "$OC_CONFIG".*
}

reset_control() {
	export CONVEYOR_CONTROL="$tmp/control.jsonl"
	export CONVEYOR_CONTROL_ACK="$tmp/control-ack.jsonl"
	export CONVEYOR_RESULT="$tmp/control-result.json"
	: >"$CONVEYOR_CONTROL"
	: >"$CONVEYOR_CONTROL_ACK"
	rm -f "$CONVEYOR_RESULT"
	unset _CONTROL_SESSION _CONTROL_ACCEPTS _OPENCODE_CONTROL_HELLO_SENT RESUME_SESSION
}

append_command() {
	# append_command <seq> <id> <kind> <text> <session>
	jq -nc --argjson seq "$1" --arg id "$2" --arg kind "$3" --arg text "$4" --arg session "$5" \
		'{v:1,type:"command",seq:$seq,id:$id,at:"2026-09-25T12:00:00Z",kind:$kind,text:$text,itemId:"test:7",runId:"run-1",session:$session,by:"amir"}' \
		>>"$CONVEYOR_CONTROL"
}

OC_SCENE=success
export OC_SCENE
set +e
out=$(run_claude 'do the work' 2>&1)
rc=$?
set -e
chk "a valid event stream succeeds" "$rc" "0"
chk "text events become logs" "$(grep -c 'work complete' <<<"$out")" "1"
chk "tool output is not logged" "$(grep -c 'SECRET TOOL OUTPUT' <<<"$out" || true)" "0"
chk "the session is captured" "$(claude_session)" "ses-good"
chk "the selected model is recorded" "$(record_model)" "model: openai/gpt-test variant: high agent: build"
export API_SECRET=gpt-test
chk "OpenCode model metadata is redacted" "$(record_model)" "model: openai/[REDACTED] variant: high agent: build"
unset API_SECRET
chk "the task leads the prompt" "$(sed -n '1p' "$OC_PROMPT")" "do the work"
chk "the result contract is appended" "$(grep -c 'versioned result contract' "$OC_PROMPT")" "1"
chk "the model child cannot see CONVEYOR_RESULT" "$(grep -c exposed "$OC_RESULT_ENV" || true)" "0"
for arg in '--format' 'json' '--model' 'openai/gpt-test' '--variant' 'high' '--agent' 'build'; do
	chk "run receives $arg" "$(grep -Fx -- "$arg" "$OC_ARGS" || true)" "$arg"
done

reset_invocations
export OC_SCENE=secrets SHORT_KEY=abc API_SECRET='quoted"secret\value'
ESCAPED_SECRET=$(jq -nr --arg value "$API_SECRET" '$value | @json')
ESCAPED_SECRET=${ESCAPED_SECRET:1:${#ESCAPED_SECRET}-2}
export ESCAPED_SECRET
set +e
out=$(run_claude 'return secrets for the fixture' 2>&1)
rc=$?
set -e
escaped_secret=$(jq -nr --arg value "$API_SECRET" '$value | @json')
escaped_secret=${escaped_secret:1:${#escaped_secret}-2}
chk "a secret-bearing result succeeds after redaction" "$rc" "0"
chk "a short secret is absent from backend logs" "$(grep -Fc -- "$SHORT_KEY" <<<"$out" || true)" "0"
chk "a literal complex secret is absent from backend logs" "$(grep -Fc -- "$API_SECRET" <<<"$out" || true)" "0"
chk "a JSON-escaped secret is absent from backend logs" "$(grep -Fc -- "$escaped_secret" <<<"$out" || true)" "0"
chk "secret values are absent from the persisted result" "$(jq -r .summary "$CONVEYOR_RESULT")" "saw [REDACTED] and [REDACTED]"
unset SHORT_KEY API_SECRET ESCAPED_SECRET

reset_invocations
export OC_SCENE=waiting
set +e
run_claude 'wait for checks' >/dev/null 2>&1
rc=$?
set -e
chk "an OpenCode waiting final returns the deferral exit" "$rc" "10"
chk "the OpenCode waiting reason is persisted" "$(jq -r .waiting.why "$CONVEYOR_RESULT")" "checks are running"

for collision in 1 v waiting; do
	reset_invocations
	export API_KEY=$collision
	if [[ "$collision" == waiting ]]; then export OC_SCENE=waiting; expected=10; else export OC_SCENE=success; expected=0; fi
	set +e
	run_claude 'return a result despite schema-shaped secrets' >/dev/null 2>&1
	rc=$?
	set -e
	chk "secret value '$collision' cannot corrupt raw result parsing" "$rc" "$expected"
	chk "secret value '$collision' preserves the result discriminator" "$(jq -r .outcome "$CONVEYOR_RESULT")" "$([[ "$collision" == waiting ]] && echo waiting || echo success)"
	unset API_KEY
done

reset_invocations
export OC_SCENE=split-fenced
set +e
run_claude 'return a split fence' >/dev/null 2>&1
rc=$?
set -e
chk "split fenced text preserves boundary newlines" "$rc:$(cat "$OC_CALLS")" "0:1"
chk "the split fenced payload is persisted" "$(jq -r .summary "$CONVEYOR_RESULT")" "split fenced"

reset_invocations
export OC_SCENE=terminal-truncated
before=$(cat "$CONVEYOR_RESULT")
set +e
run_claude 'do not accept an earlier terminal' >/dev/null 2>&1
rc=$?
set -e
chk "a step truncated after an earlier terminal fails closed" "$rc:$(cat "$OC_CALLS")" "2:1"
chk "the truncated later step preserves the prior complete result" "$(cat "$CONVEYOR_RESULT")" "$before"

reset_invocations
export OC_SCENE=invalid-once
set +e
run_claude 'return a result' >/dev/null 2>&1
rc=$?
set -e
chk "one malformed final gets one correction" "$rc:$(cat "$OC_CALLS")" "0:2"
chk "the valid correction is persisted" "$(jq -r .summary "$CONVEYOR_RESULT")" "corrected"
chk "the correction reuses the session" "$(grep -A1 -Fx -- '--session' "$OC_ARGS.2" | tail -1)" "ses-invalid"
chk "the correction uses the no-tool agent" "$(grep -A1 -Fx -- '--agent' "$OC_ARGS.2" | tail -1)" "conveyor-result"
chk "the correction denies every tool" "$(jq -r '.agent["conveyor-result"].permission["*"]' "$OC_CONFIG.2")" "deny"

reset_invocations
export OC_SCENE=invalid-always
set +e
run_claude 'return a result' >/dev/null 2>&1
rc=$?
set -e
chk "an invalid correction is quarantined after two calls" "$rc:$(cat "$OC_CALLS")" "20:2"
chk "the quarantine names invalid-result" "$(jq -r .kind "$CONVEYOR_RESULT")" "invalid-result"
chk "the quarantine is a condition" "$(jq -r .asked "$CONVEYOR_RESULT")" "false"

reset_invocations
export OC_SCENE=duplicate-once
set +e
run_claude 'return one result' >/dev/null 2>&1
rc=$?
set -e
chk "duplicate terminal results get one correction" "$rc:$(cat "$OC_CALLS")" "0:2"
chk "the duplicate correction is persisted" "$(jq -r .summary "$CONVEYOR_RESULT")" "corrected duplicate"
chk "the duplicate correction reuses the session" "$(grep -A1 -Fx -- '--session' "$OC_ARGS.2" | tail -1)" "ses-duplicate"
chk "the duplicate correction denies every tool" "$(jq -r '.agent["conveyor-result"].permission["*"]' "$OC_CONFIG.2")" "deny"

reset_invocations
export OC_SCENE=duplicate-always
set +e
run_claude 'return one result' >/dev/null 2>&1
rc=$?
set -e
chk "a second ambiguous correction is quarantined" "$rc:$(cat "$OC_CALLS")" "20:2"
chk "the ambiguous quarantine names invalid-result" "$(jq -r .kind "$CONVEYOR_RESULT")" "invalid-result"
chk "the ambiguous quarantine is a condition" "$(jq -r .asked "$CONVEYOR_RESULT")" "false"

set +e
fixture=$(render_stream <"$here/fixtures/tool-run-1.18.32.jsonl" 2>&1)
rc=$?
set -e
chk "the sanitized live 1.18.32 tool transcript parses" "$rc" "0"
chk "the live fixture renders its completed tool" "$(grep -c 'bash: pwd \[completed\]' <<<"$fixture")" "1"
chk "the live fixture renders final text" "$(grep -c '^done$' <<<"$fixture")" "1"

# The OpenCode boundary owns its child and only polls after a step_finish at
# which every observed tool part is terminal. The synthetic fixture puts an
# unsafe boundary first, then a safe one; the stub stays alive after the safe
# boundary so TERM/KILL behaviour is observable rather than a race with exit.
reset_invocations
reset_control
append_command 1 instruct-1 instruction "use the smaller API" ""
export OC_COMMAND_ID=instruct-1 OC_SCENE=steering OC_STOP_MODE=term CONTROL_STOP_GRACE=2
set +e
run_claude 'original task' >"$tmp/steering.log" 2>&1
rc=$?
set -e
chk "a delivered instruction keeps the run successful" "$rc" "0"
chk "hello is present before the first model child starts" "$(sed -n '1p' "$OC_HELLO_BEFORE_RUN")" "yes"
chk "hello is the first ack record" "$(jq -rs '.[0].type' "$CONVEYOR_CONTROL_ACK")" "hello"
chk "the first event records its opaque adapter session" "$(jq -rs '.[1] | [.type,.session] | join(":")' "$CONVEYOR_CONTROL_ACK")" "session:opencode:ses-steer"
chk "the unsafe step boundary was not polled" "$([[ -e "$OC_UNSAFE_ACK" ]] && echo polled || echo skipped)" "skipped"
chk "the first child receives TERM at the safe boundary" "$(grep -c '^TERM$' "$OC_SIGNALS" || true)" "1"
chk "an instruction starts a second child" "$(cat "$OC_CALLS")" "2"
chk "the resumed child gets the same session" "$(grep -A1 -Fx -- '--session' "$OC_ARGS.2" | tail -1)" "ses-steer"
chk "the resumed prompt carries the instruction" "$(grep -c 'use the smaller API' "$OC_PROMPT.2")" "1"
chk "the resumed prompt says the original task still stands" "$(grep -c 'original task still stands' "$OC_PROMPT.2")" "1"
chk "the resumed prompt requires reading partial work" "$(grep -c 'read the current status' "$OC_PROMPT.2")" "1"
chk "the instruction is consumed after the second child starts" "$(jq -r 'select(.type=="ack" and .id=="instruct-1") | .state' "$CONVEYOR_CONTROL_ACK")" "consumed"
chk "the instruction was not acked before that child started" "$([[ -e "$OC_EARLY_ACK" ]] && echo early || echo ordered)" "ordered"

# If the stopped child ignores TERM it is killed after the grace. A replacement
# that then exits without one event did not start usefully, so the instruction
# is rejected instead of disappearing as consumed.
reset_invocations
reset_control
append_command 1 failed-1 instruction "try another route" ""
export OC_COMMAND_ID=failed-1 OC_SCENE=delivery-fail OC_STOP_MODE=ignore CONTROL_STOP_GRACE=1
set +e
run_claude 'original task' >"$tmp/delivery-fail.log" 2>&1
rc=$?
set -e
first_pid=$(sed -n '1p' "$OC_PIDS")
chk "a replacement start failure preserves its exit" "$rc" "73"
chk "TERM-ignoring child is gone after KILL fallback" "$(kill -0 "$first_pid" 2>/dev/null && echo alive || echo gone)" "gone"
chk "failed delivery is rejected" "$(jq -r 'select(.type=="ack" and .id=="failed-1") | .state' "$CONVEYOR_CONTROL_ACK")" "rejected"
chk "failed delivery has the stable reason" "$(jq -r 'select(.type=="ack" and .id=="failed-1") | .reason' "$CONVEYOR_CONTROL_ACK")" "delivery failed"

# Pause stops at the same boundary, writes the resumable marked result before
# acknowledging, and does not launch a replacement child.
reset_invocations
reset_control
append_command 1 pause-1 pause "ignored" ""
export OC_COMMAND_ID=pause-1 OC_SCENE=pause OC_STOP_MODE=term CONTROL_STOP_GRACE=2
set +e
run_claude 'original task' >"$tmp/pause.log" 2>&1
rc=$?
set -e
chk "pause exits 20" "$rc" "20"
chk "pause does not start a replacement child" "$(cat "$OC_CALLS")" "1"
chk "pause is acked consumed" "$(jq -r 'select(.type=="ack" and .id=="pause-1") | .state' "$CONVEYOR_CONTROL_ACK")" "consumed"
chk "pause writes a blocked result" "$(jq -r .blocked "$CONVEYOR_RESULT")" "true"
chk "pause has its own kind" "$(jq -r .kind "$CONVEYOR_RESULT")" "paused"
chk "pause is a person's question" "$(jq -r .asked "$CONVEYOR_RESULT")" "true"
chk "pause keeps the prefixed result session" "$(jq -r .session "$CONVEYOR_RESULT")" "opencode:ses-steer"
chk "pause names requester and request time" "$(jq -r .reason "$CONVEYOR_RESULT")" "paused by amir at 2026-09-25T12:00:00Z"

RESUME_SESSION=""
pause_payload=$(jq -c '. + {answer:"continue"}' "$CONVEYOR_RESULT")
resume_prompt "$pause_payload" 'original task' >/dev/null 2>&1
chk "a handed-back pause restores the raw OpenCode session" "$RESUME_SESSION" "ses-steer"
reset_invocations
unset CONVEYOR_CONTROL CONVEYOR_CONTROL_ACK _OPENCODE_CONTROL_HELLO_SENT
export OC_SCENE=success
run_claude 'continue' >/dev/null
chk "the handed-back pause resumes instead of starting cold" "$(grep -A1 -Fx -- '--session' "$OC_ARGS" | tail -1)" "ses-steer"

# The helper's rejection paths are exercised through the real adapter boundary,
# not only in agents/_control-selfcheck.
reset_invocations
reset_control
append_command 1 stale-1 instruction "old" "opencode:ses-other"
export OC_COMMAND_ID=stale-1 OC_SCENE=boundary-exit
run_claude 'reject stale' >/dev/null
chk "a stale session is rejected at the boundary" "$(jq -r 'select(.type=="ack" and .id=="stale-1") | .reason' "$CONVEYOR_CONTROL_ACK")" "stale session"

reset_invocations
reset_control
append_command 1 unsupported-1 dance "move" ""
export OC_COMMAND_ID=unsupported-1 OC_SCENE=boundary-exit
run_claude 'reject kind' >/dev/null
chk "an unadvertised kind is rejected at the boundary" "$(jq -r 'select(.type=="ack" and .id=="unsupported-1") | .reason' "$CONVEYOR_CONTROL_ACK")" "unsupported kind"

reset_invocations
reset_control
append_command 1 ceiling-1 instruction "one too many" ""
_CONTROL_MAX_DELIVERIES=0
export OC_COMMAND_ID=ceiling-1 OC_SCENE=boundary-exit
run_claude 'reject ceiling' >/dev/null
chk "the delivery ceiling is enforced at the boundary" "$(jq -r 'select(.type=="ack" and .id=="ceiling-1") | .reason' "$CONVEYOR_CONTROL_ACK")" "too many deliveries in one run"
_CONTROL_MAX_DELIVERIES=10

reset_invocations
reset_control
append_command 1 wrap-1 instruction "too late" ""
export CONVEYOR_DEADLINE=$(date -u -d '+60 seconds' +%Y-%m-%dT%H:%M:%SZ)
export OC_COMMAND_ID=wrap-1 OC_SCENE=boundary-exit
run_claude 'reject wrap-up' >/dev/null
chk "the wrap-up guard is enforced at the boundary" "$(jq -r 'select(.type=="ack" and .id=="wrap-1") | .reason' "$CONVEYOR_CONTROL_ACK")" "past wrap-up"
unset CONVEYOR_DEADLINE

unset CONVEYOR_CONTROL CONVEYOR_CONTROL_ACK _OPENCODE_CONTROL_HELLO_SENT _CONTROL_SESSION _CONTROL_ACCEPTS
for helper in hello session poll ack; do
	case "$helper" in
	hello) out=$(control_hello instruction 2>&1); rc=$? ;;
	session) out=$(control_session session-1 2>&1); rc=$? ;;
	poll) out=$(control_poll 2>&1); rc=$? ;;
	ack) out=$(control_ack command-1 consumed 2>&1); rc=$? ;;
	esac
	chk "control_$helper is a silent no-op without channels" "$rc:$out" "0:"
done
unset RESUME_SESSION OC_COMMAND_ID OC_STOP_MODE CONTROL_STOP_GRACE

export CONVEYOR_PLAN="$tmp/plan.jsonl"
: >"$CONVEYOR_PLAN"
render_stream <"$here/fixtures/todowrite-synthetic.jsonl" >/dev/null 2>&1 || true
chk "the todowrite fixture publishes one revision" "$(wc -l <"$CONVEYOR_PLAN" | tr -d ' ')" "1"
chk "its ids are used verbatim"     "$(jq -r '.todos[0].id' "$CONVEYOR_PLAN")" "step-1"
chk "content maps to text"          "$(jq -r '.todos[1].text' "$CONVEYOR_PLAN")" "write the fix"
chk "status passes through"         "$(jq -r '.todos[2].status' "$CONVEYOR_PLAN")" "pending"
chk "no active equivalent is set"   "$(jq -r '.todos[1].active // "absent"' "$CONVEYOR_PLAN")" "absent"
unset CONVEYOR_PLAN

incremental=$(printf '%s\n' \
	'{"type":"step_start","timestamp":1,"sessionID":"ses-progress","part":{"id":"s","type":"step-start"}}' \
	'{"type":"text","timestamp":2,"sessionID":"ses-progress","part":{"id":"t","type":"text","text":"work"}}' \
	'{"type":"text","timestamp":3,"sessionID":"ses-progress","part":{"id":"t","type":"text","text":"work complete"}}' \
	'{"type":"step_finish","timestamp":4,"sessionID":"ses-progress","part":{"id":"f","type":"step-finish"}}' |
	render_stream)
chk "a progressively growing text part keeps the new suffix" "$(tr '\n' ' ' <<<"$incremental" | tr -s ' ')" "work complete "

printf '%s\n' \
	'{"type":"step_start","timestamp":1,"sessionID":"ses-split","part":{"id":"s","type":"step-start"}}' \
	'{"type":"text","timestamp":2,"sessionID":"ses-split","part":{"id":"a","type":"text","text":"{\"v\":1,\"outcome\":"}}' \
	'{"type":"text","timestamp":3,"sessionID":"ses-split","part":{"id":"b","type":"text","text":"\"success\",\"summary\":\"split\"}"}}' \
	'{"type":"step_finish","timestamp":4,"sessionID":"ses-split","part":{"id":"f","type":"step-finish","reason":"stop"}}' |
	render_stream >/dev/null
result_accept "$(<"$CLAUDE_FINAL")" "opencode:ses-split"
chk "separate final text parts are joined deterministically" "$(jq -r .summary "$CONVEYOR_RESULT")" "split"

tool_progress=$(printf '%s\n' \
	'{"type":"step_start","timestamp":1,"sessionID":"ses-tool","part":{"id":"s","type":"step-start"}}' \
	'{"type":"tool_use","timestamp":2,"sessionID":"ses-tool","part":{"id":"tool","type":"tool","tool":"bash","state":{"status":"running","title":"slow check"}}}' \
	'{"type":"tool_use","timestamp":3,"sessionID":"ses-tool","part":{"id":"tool","type":"tool","tool":"bash","state":{"status":"completed","title":"slow check","output":"secret"}}}' \
	'{"type":"step_finish","timestamp":4,"sessionID":"ses-tool","part":{"id":"f","type":"step-finish"}}' |
	render_stream)
chk "a tool part may progress through a nonterminal state" "$(grep -c 'bash: slow check' <<<"$tool_progress")" "2"
chk "the progressive tool still hides its output" "$(grep -c secret <<<"$tool_progress" || true)" "0"

RESUME_SESSION=""
prompt=$(resume_prompt '{"answer":"continue","session":"opencode:ses-old"}' 'original' 2>/dev/null)
chk "an answer resumes with only the answer" "$prompt" "continue"
resume_prompt '{"answer":"continue","session":"opencode:ses-old"}' 'original' >/dev/null 2>&1
OC_SCENE=success run_claude "$prompt" >/dev/null
chk "resume uses the exact session" "$(grep -A1 -Fx -- '--session' "$OC_ARGS" | tail -1)" "ses-old"

RESUME_SESSION=""
legacy_answer=$'\n\n--- carried from the interrupted run 120000.000-old ---\ncontinue safely'
legacy_payload=$(jq -nc --arg answer "$legacy_answer" --arg session "ses-legacy" '{answer:$answer,session:$session,controlCarryover:true}')
prompt=$(resume_prompt "$legacy_payload" 'original' 2>/dev/null)
resume_prompt "$legacy_payload" 'original' >/dev/null 2>&1
chk "a legacy carried control session keeps its opaque handle" "$RESUME_SESSION" "ses-legacy"
chk "legacy carry-over resumes with the carried instruction" "$prompt" "$legacy_answer"

RESUME_SESSION=""
resume_prompt '{"answer":"continue","session":"foreign-session","controlCarryover":false}' 'original' >/dev/null 2>&1
chk "an ordinary unprefixed session remains foreign" "${RESUME_SESSION:-}" ""

export CONVEYOR_RESULT="$tmp/result"
printf '%s\n' '{"type":"text","timestamp":1,"sessionID":"ses-question","part":{"id":"p","type":"text","text":"x"}}' >"$CLAUDE_RAW"
echo '{"blocked":true,"kind":"decision","reason":"choose","questions":[{"header":"Mode","question":"Which?","options":[{"label":"Safe","description":"Use safe mode"}]}]}' >"$CONVEYOR_RESULT"
agent_asked
chk "questions remain questions" "$(jq -r .asked "$CONVEYOR_RESULT")" "true"
chk "questions retain their session" "$(jq -r .session "$CONVEYOR_RESULT")" "opencode:ses-question"

OC_SCENE=limit
export OC_SCENE
set +e
run_claude 'hit the quota' >/dev/null 2>&1
rc=$?
set -e
chk "an error event fails the run" "$rc" "1"
chk "an explicit quota event is recognised" "$(hit_limit && echo yes)" "yes"
chk "the quota refusal is cached for status" "$([[ -s "$XDG_STATE_HOME/conveyor/opencode/openai.json" ]] && echo yes)" "yes"
chk "provider response bodies are not cached" "$(grep -c 'SECRET PROVIDER BODY' "$XDG_STATE_HOME/conveyor/opencode/openai.json" || true)" "0"

OC_SCENE=success run_claude 'quota recovered' >/dev/null
chk "a successful provider run clears its quota cache" "$([[ -e "$XDG_STATE_HOME/conveyor/opencode/openai.json" ]] && echo present || echo absent)" "absent"

export OC_SCENE=generic429
set +e
run_claude 'transient rate limit' >/dev/null 2>&1
set -e
chk "a generic 429 is not called account quota" "$(hit_limit && echo limited || echo transient)" "transient"

for scene in malformed incomplete mismatch; do
	reset_invocations
	export OC_SCENE=$scene
	started=$SECONDS
	set +e
	run_claude 'bad protocol' >/dev/null 2>&1
	rc=$?
	set -e
	chk "$scene events fail closed" "$rc" "2"
	if [[ "$scene" == malformed || "$scene" == incomplete ]]; then
		chk "$scene output stops the still-running producer" "$([[ -e "$OC_ABORTED" ]] && echo stopped || echo alive)" "stopped"
		chk "$scene output does not wait for producer exit" "$((SECONDS - started < 2 && 1 || 0))" "1"
	fi
done

export AGENT=general OC_SCENE=success
set +e
run_claude 'wrong agent mode' >/dev/null 2>&1
rc=$?
set -e
chk "a subagent cannot silently replace a primary agent" "$rc" "2"
export AGENT=build

export OC_SCENE=sleep OC_CHILD="$tmp/child"
cat >"$tmp/cancel-driver" <<DRIVER
#!/usr/bin/env bash
set -euo pipefail
export PATH='$tmp/bin':\"\$PATH\"
export MODEL=openai/gpt-test AGENT=build OC_SCENE=sleep OC_ARGS='$tmp/args' OC_PROMPT='$tmp/prompt' OC_CHILD='$tmp/child'
export CONVEYOR_SOURCE=test CONVEYOR_STAGE=working CONVEYOR_ITEM_REF=7
source '$here/_stream'
run_claude wait
DRIVER
chmod +x "$tmp/cancel-driver"
setsid "$tmp/cancel-driver" >/dev/null 2>&1 &
driver=$!
for _ in {1..100}; do [[ -s "$OC_CHILD" ]] && break; sleep 0.02; done
child=$(cat "$OC_CHILD")
kill -TERM -- "-$driver"
wait "$driver" 2>/dev/null || true
for _ in {1..100}; do kill -0 "$child" 2>/dev/null || break; sleep 0.02; done
chk "process-group cancellation removes the CLI child" "$(kill -0 "$child" 2>/dev/null && echo alive || echo gone)" "gone"

export OC_VERSION=1.18.31 OC_SCENE=success
set +e
run_claude 'wrong version' >/dev/null 2>&1
rc=$?
set -e
chk "an unpinned OpenCode version is refused" "$rc" "2"

unset OC_VERSION RESUME_SESSION
export OC_SCENE=success PROMPT='Refine this item.' CONVEYOR_RESULT="$tmp/wrapper-result"
printf '%s\n' '{"item":{"ref":"7","title":"Wrapper test","description":"Body","url":"https://example.test/7"}}' |
	"$here/refine" >/dev/null
chk "agent: opencode selects the native backend" "$(grep -c 'Refine this item.' "$OC_PROMPT")" "1"

exit "$fail"
