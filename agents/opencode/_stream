#!/usr/bin/env bash
# OpenCode's structured-event backend for the shared stage adapters.
# Pinned because `run --format json` is a CLI projection, not a stable API.

OPENCODE_SUPPORTED_VERSION=1.18.32
CLAUDE_SAID=$(mktemp)
CLAUDE_RAW=$(mktemp)
trap 'rm -f "$CLAUDE_SAID" "$CLAUDE_RAW"' EXIT

opencode_bin() { printf '%s' "${OPENCODE_BIN:-opencode}"; }

claude_session() {
	[[ -s "$CLAUDE_RAW" ]] || return 0
	jq -r 'select(.sessionID != null) | .sessionID' "$CLAUDE_RAW" 2>/dev/null | head -1 || true
}

claude_model() { printf '%s' "${MODEL:-}"; }

record_model() {
	[[ -n "${MODEL:-}" ]] || return 0
	printf 'model: %s%s agent: %s\n' "$MODEL" "${VARIANT:+ variant: $VARIANT}" "${AGENT:-build}" || true
	return 0
}

resume_prompt() {
	local payload=$1 default=$2 answer session
	answer=$(jq -r '.answer // ""' <<<"$payload")
	session=$(jq -r '.session // ""' <<<"$payload")
	if [[ -z "$answer" ]]; then
		printf '%s' "$default"
		return 0
	fi
	if [[ "$session" == opencode:* ]]; then
		RESUME_SESSION=${session#opencode:}
		echo "resuming the conversation that asked (session ${RESUME_SESSION:0:8})" >&2
		printf '%s' "$answer"
		return 0
	fi
	printf '%s' "The question you stopped on has been answered: ${answer}

Carry on from there.

--- what you were asked to do originally ---
${default}"
}

limit_dir() { printf '%s/conveyor/opencode' "${XDG_STATE_HOME:-$HOME/.local/state}"; }
limit_file() {
	local provider=${MODEL%%/*}
	[[ "$provider" =~ ^[A-Za-z0-9._-]+$ ]] || provider=unknown
	printf '%s/%s.json' "$(limit_dir)" "$provider"
}

hit_limit() {
	local reason expires file tmp
	[[ -s "$CLAUDE_RAW" ]] || return 1
	if ! jq -s -e 'any(.[]; select(.type == "error") |
		[(.error.name // ""), (.error.data.message // ""),
		 (.error.data.responseBody // "" | if type == "string" then . else tostring end)] |
		join(" ") |
		test("FreeUsageLimitError|GoUsageLimitError|insufficient[_ ]quota|quota (is )?(exceeded|exhausted)|usage limit"; "i"))' \
		"$CLAUDE_RAW" >/dev/null 2>&1; then
		return 1
	fi
	# responseBody participates in classification but is never persisted: it
	# may be large and may carry provider internals. The board gets one bounded
	# name/message instead.
	reason=$(jq -rs '[.[] | select(.type == "error") |
		(.error.data.message // .error.message // .error.name // "explicit quota refusal") |
		tostring | gsub("[[:space:]]+"; " ") | .[0:300]][0]' "$CLAUDE_RAW")
	file=$(limit_file)
	mkdir -p "$(dirname "$file")" || return 0
	expires=$(($(date +%s) + ${OPENCODE_LIMIT_TTL:-900}))
	tmp=$(mktemp "${file}.XXXXXX") || return 0
	if jq -n --arg provider "${MODEL%%/*}" --arg reason "$reason" \
		--argjson expires "$expires" '{provider:$provider, limitedAt:(now|todate), expiresAt:$expires, reason:$reason}' >"$tmp"; then
		mv "$tmp" "$file"
	else
		rm -f "$tmp"
	fi
	return 0
}

# OpenCode has no turn-count ceiling. Conveyor's process deadline is the hard
# bound, and the session is still retained for model-declared unfinished stops.
hit_max_turns() { return 1; }

record_session() {
	local sess tmp base
	[[ -z "${CONVEYOR_RESULT:-}" ]] && return 0
	sess=$(claude_session)
	[[ -z "$sess" ]] && return 0
	tmp=$(mktemp)
	base='{}'
	[[ -s "$CONVEYOR_RESULT" ]] && jq -e . "$CONVEYOR_RESULT" >/dev/null 2>&1 && base=$(<"$CONVEYOR_RESULT")
	if jq --arg s "opencode:$sess" '. + {session: $s}' <<<"$base" >"$tmp" 2>/dev/null; then
		mv "$tmp" "$CONVEYOR_RESULT"
	else
		rm -f "$tmp"
	fi
}

declare -f is_condition_kind >/dev/null 2>&1 || source "$(dirname "${BASH_SOURCE[0]}")/../_blocked"
declare -f plan_publish >/dev/null 2>&1 || source "$(dirname "${BASH_SOURCE[0]}")/../_plan"

# _plan_publish_opencode_todos <event-line> — maps a todowrite tool part's
# completed input.todos into the plan protocol: OpenCode supplies its own id
# (used verbatim; plan_publish trims and caps it), content maps to text,
# status passes through unchanged. OpenCode has no equivalent of Claude's
# activeForm, so active is left unset and a reader falls back to text.
_plan_publish_opencode_todos() {
	local line=$1 mapped
	mapped=$(jq -c '[.part.state.input.todos[]? |
		{id: (.id // ""), text: (.content // ""), status: (.status // "")}]' <<<"$line" 2>/dev/null) || return 0
	plan_publish "$mapped"
}

agent_asked() {
	local sess kind asked tmp
	[[ -z "${CONVEYOR_RESULT:-}" || ! -s "$CONVEYOR_RESULT" ]] && return 0
	jq -e 'type == "object"' "$CONVEYOR_RESULT" >/dev/null 2>&1 || return 0
	kind=$(jq -r '.kind // "decision"' "$CONVEYOR_RESULT" 2>/dev/null) || return 0
	sess=$(claude_session)
	asked=true
	is_condition_kind "$kind" && asked=false
	if jq -e '(.questions // []) | type == "array" and length > 0 and all(.[]; type == "object")' \
		"$CONVEYOR_RESULT" >/dev/null 2>&1; then
		asked=true
	fi
	tmp=$(mktemp)
	[[ -n "$sess" ]] && sess="opencode:$sess"
	if jq --arg s "$sess" --arg kind "$kind" --argjson asked "$asked" \
		'. + {kind: $kind, asked: $asked} + (if $s == "" then {} else {session: $s} end)' \
		"$CONVEYOR_RESULT" >"$tmp" 2>/dev/null; then
		mv "$tmp" "$CONVEYOR_RESULT"
	else
		rm -f "$tmp"
	fi
}

last_said() {
	[[ -s "${CLAUDE_SAID:-}" ]] || return 0
	grep -v '^\s*$' "$CLAUDE_SAID" | tail -n 3 | tr -s '[:space:]' ' ' | cut -c1-300
}

render_stream() {
	local line type session="" current seen=0 finished=0 errors=0 detail id text previous status key
	declare -A parts=()
	declare -A texts=()
	declare -A tool_states=()
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" ]] && continue
		if ! jq -e 'type == "object" and (.type | type == "string" and length > 0)
			and (.timestamp | type == "number" and floor == .)
			and (.sessionID | type == "string" and length > 0)' \
			>/dev/null 2>&1 <<<"$line"; then
			echo "opencode emitted a malformed JSON event" >&2
			return 2
		fi
		current=$(jq -r .sessionID <<<"$line")
		if [[ -n "$session" && "$current" != "$session" ]]; then
			echo "opencode changed session id inside one event stream" >&2
			return 2
		fi
		session=$current
		type=$(jq -r .type <<<"$line")
		case "$type" in
		step_start)
			jq -e '.part | type == "object" and (.id | type == "string" and length > 0) and .type == "step-start"' >/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed step_start event" >&2; return 2; }
			id=$(jq -r .part.id <<<"$line"); [[ -n "${parts[$id]+seen}" ]] && continue; parts[$id]=1
			seen=1
			;;
		text)
			jq -e '.part | type == "object" and (.id | type == "string" and length > 0) and .type == "text" and (.text | type == "string")' >/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed text event" >&2; return 2; }
			id=$(jq -r .part.id <<<"$line")
			text=$(jq -r .part.text <<<"$line")
			previous=${texts[$id]-}
			[[ "$text" == "$previous" ]] && continue
			if [[ -n "$previous" && "$text" == "$previous"* ]]; then
				printf '%s\n' "${text:${#previous}}"
			else
				printf '%s\n' "$text"
			fi
			texts[$id]=$text
			seen=1
			;;
		reasoning)
			jq -e '.part | type == "object" and (.id | type == "string" and length > 0) and .type == "reasoning"' >/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed reasoning event" >&2; return 2; }
			id=$(jq -r .part.id <<<"$line"); [[ -n "${parts[$id]+seen}" ]] && continue; parts[$id]=1
			seen=1 # deliberately not logged
			;;
		tool_use)
			jq -e '.part | type == "object" and (.id | type == "string" and length > 0) and .type == "tool"
				and (.tool | type == "string" and length > 0)
				and (.state.status | type == "string" and length > 0)' \
				>/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed tool_use event" >&2; return 2; }
			id=$(jq -r .part.id <<<"$line")
			status=$(jq -r .part.state.status <<<"$line")
			key="$id:$status"
			[[ -n "${tool_states[$key]+seen}" ]] && continue
			tool_states[$key]=1
			if [[ "$(jq -r .part.tool <<<"$line")" == todowrite && "$status" == completed ]]; then
				_plan_publish_opencode_todos "$line"
			fi
			jq -r '"  · \(.part.tool): \(.part.state.title // .part.state.status) [\(.part.state.status)]"' <<<"$line"
			seen=1
			;;
		step_finish)
			jq -e '.part | type == "object" and (.id | type == "string" and length > 0) and .type == "step-finish"' >/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed step_finish event" >&2; return 2; }
			id=$(jq -r .part.id <<<"$line"); [[ -n "${parts[$id]+seen}" ]] && continue; parts[$id]=1
			finished=1
			seen=1
			;;
		error)
			jq -e '.error | type == "object"' >/dev/null 2>&1 <<<"$line" || {
				echo "opencode emitted a malformed error event" >&2; return 2; }
			detail=$(jq -r '.error.data.message // .error.message // .error.name // "unknown error"' <<<"$line")
			printf '[opencode stopped: %s] %s\n' "$(jq -r '.error.name // "error"' <<<"$line")" "$detail"
			errors=1
			seen=1
			;;
		*)
			echo "opencode event ignored: $type" >&2
			;;
		esac
	done
	[[ $seen -eq 1 ]] || { echo "opencode emitted no structured events" >&2; return 2; }
	[[ $errors -eq 0 ]] || return 1
	[[ $finished -eq 1 ]] || { echo "opencode stream ended without step_finish" >&2; return 2; }
}

validate_opencode() {
	local bin version agent_json provider
	bin=$(opencode_bin)
	if ! version=$(OPENCODE_DISABLE_AUTOUPDATE=1 "$bin" --version 2>/dev/null); then
		echo "opencode is not installed or did not report its version" >&2
		return 2
	fi
	if [[ "$version" != "$OPENCODE_SUPPORTED_VERSION" ]]; then
		echo "opencode $version is unsupported; install $OPENCODE_SUPPORTED_VERSION" >&2
		return 2
	fi
	if [[ -z "${MODEL:-}" ]]; then
		echo "MODEL is required for the OpenCode adapter (provider/model)" >&2
		return 2
	fi
	[[ "$MODEL" == */* ]] || { echo "MODEL must be provider/model, got: $MODEL" >&2; return 2; }
	AGENT=${AGENT:-build}
	if ! OPENCODE_DISABLE_AUTOUPDATE=1 "$bin" --pure debug config >/dev/null 2>&1; then
		echo "opencode could not resolve its configuration" >&2
		return 2
	fi
	if ! agent_json=$(OPENCODE_DISABLE_AUTOUPDATE=1 "$bin" --pure debug agent "$AGENT" 2>/dev/null) ||
		! jq -e --arg name "$AGENT" 'type == "object" and .name == $name and .mode == "primary"' >/dev/null 2>&1 <<<"$agent_json"; then
		echo "OpenCode AGENT '$AGENT' is missing or is not a primary agent" >&2
		return 2
	fi
	provider=${MODEL%%/*}
	if ! OPENCODE_DISABLE_AUTOUPDATE=1 "$bin" --pure models "$provider" 2>/dev/null | grep -Fxq -- "$MODEL"; then
		echo "OpenCode MODEL '$MODEL' is not available" >&2
		return 2
	fi
}

# Compatibility name used by the shared stage policy.
run_claude() {
	local prompt=$1 bin result
	local -a flags
	validate_opencode || return $?
	bin=$(opencode_bin)
	flags=(--pure run --format json --model "$MODEL" --agent "${AGENT:-build}" --dir "$PWD"
		--title "conveyor:${CONVEYOR_SOURCE:-unknown}:${CONVEYOR_ITEM_REF:-unknown}:${CONVEYOR_STAGE:-unknown}")
	[[ -n "${VARIANT:-}" ]] && flags+=(--variant "$VARIANT")
	[[ -n "${RESUME_SESSION:-}" ]] && flags+=(--session "$RESUME_SESSION")

	OPENCODE_DISABLE_AUTOUPDATE=1 "$bin" "${flags[@]}" <<<"$prompt" |
		tee "$CLAUDE_RAW" | render_stream | tee "$CLAUDE_SAID"
	local -a statuses=("${PIPESTATUS[@]}")
	if [[ ${statuses[0]} -ne 0 ]]; then return "${statuses[0]}"; fi
	if [[ ${statuses[1]} -ne 0 || ${statuses[3]} -ne 0 ]]; then return 1; fi
	result=${statuses[2]}
	if [[ $result -eq 0 ]]; then
		rm -f "$(limit_file)" 2>/dev/null || true
	fi
	return "$result"
}
