#!/usr/bin/env python3
"""Read-only OpenCode readiness and cached quota state for the board."""
import base64
import datetime as dt
import json
import os
import pathlib
import secrets
import socket
import subprocess
import sys
import time
import urllib.request

SUPPORTED = "1.18.32"


def result(state, summary, detail, resets_at=None):
    out = {"state": state, "summary": summary, "detail": detail}
    if resets_at:
        out["resetsAt"] = resets_at
    dest = os.environ.get("CONVEYOR_RESULT")
    if dest:
        pathlib.Path(dest).write_text(json.dumps(out))
    print(summary, file=sys.stderr)


def run(binary, *args):
    return subprocess.run(
        [binary, *args], text=True, capture_output=True, timeout=15,
        env={**os.environ, "OPENCODE_DISABLE_AUTOUPDATE": "1"},
    )


def request(port, path, username, password):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}")
    token = base64.b64encode(f"{username}:{password}".encode()).decode()
    req.add_header("Authorization", f"Basic {token}")
    with urllib.request.urlopen(req, timeout=2) as response:
        return json.load(response)


def active_limit():
    root = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state"))
    root = root / "conveyor" / "opencode"
    now = int(time.time())
    for path in sorted(root.glob("*.json")):
        try:
            item = json.loads(path.read_text())
            if int(item.get("expiresAt", 0)) <= now:
                path.unlink(missing_ok=True)
                continue
            return item
        except (OSError, ValueError, TypeError):
            continue
    return None


def main():
    binary = os.environ.get("OPENCODE_BIN", "opencode")
    try:
        version_run = run(binary, "--version")
    except (OSError, subprocess.TimeoutExpired) as exc:
        result("unknown", f"OpenCode unavailable: {exc}", [])
        return
    version = version_run.stdout.strip()
    details = [{"label": "version", "value": version or "unknown"}]
    if version_run.returncode or version != SUPPORTED:
        result("unknown", f"OpenCode {version or 'unknown'} is unsupported; install {SUPPORTED}", details)
        return
    try:
        config = run(binary, "--pure", "debug", "config")
    except subprocess.TimeoutExpired:
        result("unknown", "OpenCode configuration check timed out", details)
        return
    if config.returncode:
        result("unknown", "OpenCode configuration could not be resolved", details)
        return

    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        port = probe.getsockname()[1]
    username = "conveyor-status"
    password = secrets.token_urlsafe(32)
    env = {**os.environ, "OPENCODE_DISABLE_AUTOUPDATE": "1",
           "OPENCODE_SERVER_USERNAME": username,
           "OPENCODE_SERVER_PASSWORD": password}
    server = subprocess.Popen(
        [binary, "--pure", "serve", "--hostname", "127.0.0.1", "--port", str(port)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env,
    )
    try:
        deadline = time.monotonic() + 10
        health = providers = agents = None
        while time.monotonic() < deadline:
            if server.poll() is not None:
                break
            try:
                health = request(port, "/global/health", username, password)
                providers = request(port, "/provider", username, password)
                agents = request(port, "/agent", username, password)
                break
            except Exception:
                time.sleep(0.1)
        if health is None or providers is None or agents is None:
            result("unknown", "OpenCode local readiness API did not become available", details)
            return
        connected = providers.get("connected", []) if isinstance(providers, dict) else []
        if not isinstance(connected, list):
            connected = []
        connected = [name for name in connected if isinstance(name, str)]
        if not isinstance(agents, list):
            agents = []
        primary = sorted(a.get("name") for a in agents if isinstance(a, dict) and a.get("mode") == "primary" and isinstance(a.get("name"), str))
        details.extend([
            {"label": "providers", "value": ", ".join(sorted(connected)) or "none connected"},
            {"label": "primary agents", "value": ", ".join(primary) or "none"},
            {"label": "quota", "value": "no live endpoint; explicit refusals are cached"},
        ])
        if not isinstance(health, dict) or not health.get("healthy", False) or not connected or not primary:
            result("unknown", "OpenCode is installed but no authenticated provider or primary agent is ready", details)
            return
        limited = active_limit()
        if limited:
            reset = dt.datetime.fromtimestamp(int(limited["expiresAt"]), dt.timezone.utc).isoformat().replace("+00:00", "Z")
            result("limited", f"OpenCode provider {limited.get('provider', 'unknown')} is limited: {limited.get('reason', 'quota refusal')}", details, reset)
            return
        result("ok", f"OpenCode {version}; {len(connected)} provider(s) connected", details)
    finally:
        server.terminate()
        try:
            server.wait(timeout=5)
        except subprocess.TimeoutExpired:
            server.kill()
            server.wait(timeout=5)


if __name__ == "__main__":
    main()
