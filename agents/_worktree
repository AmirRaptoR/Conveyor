#!/usr/bin/env bash
# Sourced by the agent adapters. Not a verb: config resolves script names
# exactly, so a leading underscore can never be mistaken for one.
#
# One worktree per item, instead of one per repository.
#
# A source used to be a checkout, which made `perSource: 1` a safety rule rather
# than a throughput choice: two agents in one directory overwrite each other's
# edits. It also made one dead run everybody's problem — a tree left dirty at 2am
# stopped every other item in that repository until a person cleaned it, because
# the next item's first act was to refuse to build on someone else's mess.
#
# A worktree per item removes both. Agents get their own directory and their own
# index, sharing only the object store, which git already makes safe. A tree left
# dirty belongs to exactly one item and blocks exactly that one. And the
# repository the human works in is never touched at all — uncommitted work can
# sit in it for a week without the pipeline noticing or caring.
#
# Worktrees live OUTSIDE the repository, deliberately: a directory inside it is
# something an agent told to "commit everything" will eventually sweep into a
# pull request.
#
# Reclaim is a positive allowlist, not "anything that looks clean". A path is
# touched — created into, emptied, or removed — only when it is exactly
# `<managed root>/<source>/<ref>` (symlinks resolved) AND carries the marker
# `item_worktree` wrote into its git dir the one time it created it. The primary
# checkout, a directory a person made, an external `git worktree`, a path
# reached through a symlink escaping the managed root — none of that is ever
# Conveyor's, no matter how clean or how old it is. A held branch is refused,
# never reclaimed: Git allows a branch in exactly one worktree, and the only
# safe response to "something else already has it" is to say so and stop.

# worktree_root — where per-item checkouts go. Override with WORKTREES.
worktree_root() { printf '%s' "${WORKTREES:-$HOME/codes/.worktrees}"; }

# default_branch — what a new item branches from. Asks the remote rather than
# assuming "main": the answer is per repository and getting it wrong branches
# the work off nothing.
default_branch() {
	local b
	b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) && {
		printf '%s' "${b#origin/}"
		return 0
	}
	for b in main master; do
		git show-ref --verify --quiet "refs/remotes/origin/$b" && {
			printf '%s' "$b"
			return 0
		}
	done
	printf 'main'
}

# _realpath <path> — the resolved, symlink-free absolute path, or failure if it
# does not exist. Used for the ownership check: a symlink at the managed path
# pointing outside it must never be treated as ours.
_realpath() {
	(cd -- "$1" 2>/dev/null && pwd -P)
}

# _managed_root — the managed root, resolved. Created if missing so a path
# comparison against it never fails just because nothing has used it yet.
_managed_root() {
	mkdir -p -- "$(worktree_root)" 2>/dev/null || true
	_realpath "$(worktree_root)"
}

# _worktree_gitdir <dir> — the absolute git dir for a worktree, which for a
# linked worktree is its own private directory under the main repo's `.git`,
# not part of the checked-out tree. Where the ownership marker and the lease
# live, same as agents/_resume's attempt counter, so an agent told to "commit
# everything" cannot sweep either into a pull request.
_worktree_gitdir() {
	git -C "$1" rev-parse --absolute-git-dir 2>/dev/null
}

# _worktree_owned <source> <ref> <dir> — true only when dir is exactly this
# item's managed path (symlinks resolved) and carries the marker written when
# item_worktree created it. Never inferred from a clean status, an age, or the
# fact that something is sitting where an item's worktree would go.
_worktree_owned() {
	local source=$1 ref=$2 dir=$3 root want real gd
	[[ -e "$dir" ]] || return 1
	root=$(_managed_root) || return 1
	want="$root/$source/$ref"
	real=$(_realpath "$dir") || return 1
	[[ "$real" == "$want" ]] || return 1
	gd=$(_worktree_gitdir "$dir") || return 1
	[[ -f "$gd/conveyor-owner" ]] || return 1
	return 0
}

# _worktree_write_marker <source> <ref> <dir> — record that item_worktree made
# this directory, so a later call can tell "ours" from "something else is
# here" without asking anything but this file.
_worktree_write_marker() {
	local source=$1 ref=$2 dir=$3 gd
	gd=$(_worktree_gitdir "$dir") || return 1
	printf '%s\n%s\n' "$source" "$ref" >"$gd/conveyor-owner"
}

# _worktree_write_lease <dir> — record who is using this worktree right now:
# the calling process's PID (unaffected by running inside `$(...)`: bash keeps
# `$$` as the top-level script's PID, which is the PID the runner's process
# group is built from) and the run's deadline, if the stage has one. Written on
# every call, creation or reuse, so the lease always reflects whoever is
# holding the worktree at this moment rather than whoever made it.
_worktree_write_lease() {
	local dir=$1 gd
	gd=$(_worktree_gitdir "$dir") || return 1
	printf '%s %s\n' "$$" "${CONVEYOR_DEADLINE:-}" >"$gd/conveyor-lease"
}

# _worktree_lease_live <dir> — true while the lease names a PID that is still
# alive, or a deadline that has not passed yet. Neither age nor a clean status
# says anything about whether an agent is still using a worktree; this does.
# No lease at all (an old worktree from before leases existed, or one whose
# owning run never got as far as writing one) is not live — the sweep's other
# guards (dirty, unpushed, keep-ref) still apply.
_worktree_lease_live() {
	local dir=$1 gd f pid deadline epoch now
	gd=$(_worktree_gitdir "$dir") || return 1
	f="$gd/conveyor-lease"
	[[ -f "$f" ]] || return 1
	read -r pid deadline <"$f" || return 1
	if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
		return 0
	fi
	if [[ -n "$deadline" ]]; then
		epoch=$(date -u -d "$deadline" +%s 2>/dev/null) || epoch=""
		now=$(date -u +%s)
		[[ -n "$epoch" && "$epoch" -gt "$now" ]] && return 0
	fi
	return 1
}

# item_worktree <source> <ref> [existing-branch] — print the path to this item's
# worktree, creating it if it is not there. Run from the source's checkout.
#
# With an existing branch (review sent the work back, so there is a pull request
# to build on) the worktree tracks that branch. Without one it starts from the
# remote's default branch — never from whatever the local checkout happens to
# have, which is a human's working state and not a base anyone chose.
# Never name a local `path` here. In zsh `path` is tied to `PATH`, so assigning
# it inside a sourced function empties the caller's command search path and
# every later `git` becomes "command not found" — a failure that reads like
# anything except its cause. These files run under bash, but they are sourced,
# and whoever sources them next may not be.
item_worktree() {
	local source=$1 ref=$2 branch=${3:-} wt base held

	wt="$(worktree_root)/${source}/${ref}"

	# Records of worktrees whose directories are gone: cheap, and without it a
	# directory deleted by hand can never be recreated under the same name.
	git worktree prune 2>/dev/null || true

	# Housekeeping rides along with the work rather than on a timer of its own.
	# Every stage that needs a worktree calls this, so the spent ones go on the
	# next item instead of waiting for a sweeper nobody remembered to install.
	sweep_worktrees "$source" "$ref"

	if [[ -e "$wt" ]]; then
		if _worktree_owned "$source" "$ref" "$wt" && git -C "$wt" rev-parse --git-dir >/dev/null 2>&1; then
			_worktree_write_lease "$wt"
			printf '%s' "$wt"
			return 0
		fi
		# Something is at this exact path and it is not ours: a person's
		# directory, a leftover from before ownership markers existed, anything.
		# Not removed, not emptied, not handed to an agent as a workdir.
		blocked worktree "$wt exists but was not created by Conveyor; refusing to touch it. \
Move it aside or remove it by hand."
	fi

	# A branch can be checked out in exactly one worktree, and something else may
	# already hold this one — an earlier run that made its own directory, a
	# leftover under /tmp, a person's primary checkout with the branch checked
	# out for review. Left alone this is a fatal from deep inside
	# `git worktree add`, and the item is marked with a message about branches
	# that explains nothing — so it is resolved here, by refusing outright.
	# Reclaiming it used to be tried instead: a *clean* holder was force-removed,
	# and Git's own refusal to remove the primary checkout (which is always
	# clean and always listed) is what turned that into deleting it. There is no
	# clean-vs-dirty distinction that makes reclaiming someone else's checkout
	# safe, so there is no reclaim: the branch is refused, whatever state its
	# holder is in.
	if [[ -n "$branch" ]]; then
		held=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
			/^worktree / { p = $0; sub(/^worktree /, "", p); next }
			/^branch /   { if ($0 == "branch " b) { print p; exit } }
		')
		if [[ -n "$held" && "$held" != "$wt" ]]; then
			blocked worktree "branch '$branch' is already checked out at $held, not this \
item's worktree ($wt); refusing to touch another checkout to reclaim it."
		fi
	fi

	mkdir -p "$(dirname "$wt")" || return 1
	git fetch --quiet origin --prune 2>/dev/null || true

	if [[ -n "$branch" ]] && git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
		# -B so a stale local branch of the same name is repointed at the remote
		# rather than refusing, which is what a previous run's leftovers look like.
		git worktree add --quiet -B "$branch" "$wt" "origin/$branch" >&2 || return 1
	else
		base=$(default_branch)
		# A space in $ref is fine in a directory name and not in a branch name;
		# the synthesized branch is sanitized, the path stays literal.
		git worktree add --quiet -B "${branch:-issue-${ref// /-}}" "$wt" "origin/$base" >&2 || return 1
	fi

	# Checked, not assumed. Printing a path that was never made sends the agent
	# to `cd` into nothing, and the error it then reports is about whatever it
	# tried next rather than about the checkout it never got.
	[[ -d "$wt" ]] || return 1
	_worktree_write_marker "$source" "$ref" "$wt"
	_worktree_write_lease "$wt"
	printf '%s' "$wt"
}

# sweep_worktrees <source> [keep-ref] — remove this source's worktrees that
# hold nothing.
#
# drop_worktree covers the happy path: review merges, the branch is gone, the
# directory is a copy of nothing. It cannot cover the rest. An item that stops on
# a question, one a person moves back to an earlier stage, one whose pull request
# somebody merges by hand — each leaves a full checkout behind, and a checkout is
# not small: seven of them were 467MB here, one of them 287MB on its own.
#
# Four conditions, all required, because deleting a directory is the one action
# in this file that cannot be undone:
#
#   owned          exactly this source/ref's managed path, marked as ours. An
#                  unowned path — a person's directory, a symlink escaping the
#                  managed root — is refused, never swept.
#   no live lease  no run currently holds it, by PID or by deadline. Recency of
#                  the directory says nothing about this; the lease does.
#   clean          nothing uncommitted. A dirty tree is somebody's work, or the
#                  evidence from a run that died, and both outlive tidiness.
#   nothing new    no commit that origin's default branch does not already have.
#                  After a merge that is true by definition; before a push it is
#                  emphatically not, which is what protects unpushed work.
sweep_worktrees() {
	local source=$1 keep=${2:-} root base dir ref
	root="$(worktree_root)/${source}"
	[[ -d "$root" ]] || return 0
	base="origin/$(default_branch)"

	for dir in "$root"/*; do
		[[ -e "$dir" ]] || continue
		ref=$(basename -- "$dir")
		[[ -n "$keep" && "$ref" == "$keep" ]] && continue
		if ! _worktree_owned "$source" "$ref" "$dir"; then
			echo "refusing to sweep unowned path $dir" >&2
			continue
		fi
		git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || continue
		_worktree_lease_live "$dir" && continue
		[[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]] && continue
		[[ "$(git -C "$dir" rev-list --count "$base"..HEAD 2>/dev/null || echo 1)" == "0" ]] || continue
		echo "sweeping spent worktree $dir" >&2
		drop_worktree "$source" "$ref"
	done
}

# drop_worktree <source> <ref> — remove an item's worktree once its work has
# landed. Called after a merge: the branch is gone, so the directory is a copy of
# nothing. Never called on a failure, where the tree is the evidence.
drop_worktree() {
	local source=$1 ref=$2 wt
	wt="$(worktree_root)/${source}/${ref}"
	[[ -e "$wt" ]] || return 0
	if ! _worktree_owned "$source" "$ref" "$wt"; then
		echo "refusing to remove unowned path $wt" >&2
		return 0
	fi
	git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
	git worktree prune 2>/dev/null || true
}
