#!/usr/bin/env bash
# Sourced by the claude adapters. Not a verb: config resolves script names
# exactly, so a leading underscore can never be mistaken for one.
#
# `claude -p` prints nothing until it finishes — a two-minute stage looks dead
# in the log and on the board. --output-format stream-json emits events as they
# happen; this turns them into lines a person can follow, without dumping whole
# tool payloads into the run log.

# Where the last run_claude put a copy of what the agent printed. The adapters
# read it to tell *why* a run produced nothing — a run stopped by a usage limit
# and a run that decided to do nothing look identical from the exit code, and
# they are opposite problems.
#
# This is a script reading its own agent's output, not the engine reading a log:
# CONTRACTS §2 is about what the engine may parse, and the answer there is still
# nothing but $CONVEYOR_RESULT.
CLAUDE_SAID=$(mktemp)
# The same run, unrendered. render_stream throws away everything it does not
# print, and the session id is in that everything: it is how an answer gets said
# back into the conversation that asked, instead of starting a new one that has
# to rediscover the repository first.
CLAUDE_RAW=$(mktemp)
trap 'rm -f "$CLAUDE_SAID" "$CLAUDE_RAW"' EXIT

# claude_session prints the conversation's own id, or nothing. Nothing is a
# normal answer: STREAM=0 produces no events, and an adapter that gets no
# session simply cannot be resumed, which the engine already tolerates.
claude_session() {
	[[ -s "$CLAUDE_RAW" ]] || return 0
	jq -r 'select(.session_id != null) | .session_id' "$CLAUDE_RAW" 2>/dev/null | head -1
}

# claude_model prints the model this run actually used, or nothing.
#
# The resolved one, out of the run's own init event — never an echo of $MODEL,
# because the case worth writing down is $MODEL unset, where the CLI picks and
# nothing anywhere records what it picked. Nothing is a normal answer, for the
# same reason claude_session gives one: STREAM=0 produces no events.
claude_model() {
	[[ -s "$CLAUDE_RAW" ]] || return 0
	jq -r 'select(.type == "system" and .subtype == "init") | .model' "$CLAUDE_RAW" 2>/dev/null | head -1
}

# record_model writes that model to the log, on a line of its own.
#
# For people and for grep over run history — which is the whole point: "is the
# cheaper model as good" is a question about the blocked rate per stage per
# model, and none of it is answerable while the model is only ever in a
# temporary file this script deletes on the way out.
#
# It is stdout, so it is logs, and CONTRACTS §2 says the engine never parses
# those: the engine learns nothing about models from this and must not.
# It never fails, because the adapter's exit status is the run's verdict and a
# note about the run has no business changing it.
record_model() {
	local model
	model=$(claude_model) || return 0
	[[ -n "$model" && "$model" != "null" ]] || return 0
	# `|| true` is the whole of "it never fails": stdout here is a pipe to the
	# engine, and a write to it can fail — the reader gone, the disk full. As
	# the last command of an && list that echo is not exempt from errexit, so
	# without this the adapter leaves on the note's status and never reaches
	# `exit $rc`. A run that did the work would then be recorded as a failure
	# because the line describing it could not be written.
	echo "model: $model" || true
	return 0
}

# resume_prompt <payload> <prompt> — what to actually send, given that a person
# may have answered the question this stage stopped on last time.
#
# Three cases, and only the first is new work. With an answer and a session, the
# answer alone is the whole message: the conversation still holds the item, the
# repository and everything the agent had already worked out. With an answer and
# no session — a different agent, a restart before the id was written — the
# answer leads the original prompt, which costs the rediscovery but never costs
# the answer. With no answer, nothing changes.
resume_prompt() {
	local payload=$1 default=$2 answer session
	answer=$(jq -r '.answer // ""' <<<"$payload")
	session=$(jq -r '.session // ""' <<<"$payload")

	if [[ -z "$answer" ]]; then
		printf '%s' "$default"
		return 0
	fi
	if [[ -n "$session" ]]; then
		RESUME_SESSION=$session
		echo "resuming the conversation that asked (session ${session:0:8})" >&2
		printf '%s' "$answer"
		return 0
	fi
	printf '%s' "The question you stopped on has been answered: ${answer}

Carry on from there.

--- what you were asked to do originally ---
${default}"
}

# hit_limit reports whether the account was out of quota. Claude Code says so in
# the transcript and exits cleanly, so nothing else can tell you.
hit_limit() {
	[[ -s "$CLAUDE_SAID" ]] && grep -qiE "hit your (session|usage|weekly) limit" "$CLAUDE_SAID"
}

# hit_max_turns reports whether the run stopped because it exhausted its
# --max-turns budget rather than finishing or being denied for quota. Reads
# the line render_stream just put in $CLAUDE_SAID for exactly this — a result
# event with is_error and subtype "error_max_turns" — instead of re-parsing
# the raw stream a second time.
#
# This is a condition, not a decision: the work done before the wall is real
# (commits pushed, comments posted, tests run), and what stopped it was a
# number in conveyor.yaml, not anything wrong with the item. Call
# record_session first if the caller wants the conversation resumable —
# hit_max_turns only answers "was this the reason", it writes nothing.
hit_max_turns() {
	[[ -s "$CLAUDE_SAID" ]] && grep -q '\[claude stopped: error_max_turns' "$CLAUDE_SAID"
}

# record_session merges {"session": "..."} into $CONVEYOR_RESULT, creating it
# if a caller hits this before the agent has written anything of its own —
# unlike agent_asked, which only ever adds to a file the model already wrote.
# The two are siblings: agent_asked marks a question the model chose to ask;
# this marks a run an adapter, not the model, decided is worth resuming, which
# is exactly the turns case above — nothing in $CONVEYOR_RESULT yet, because
# the run never got to write anything, only ran out of room to.
#
# A no-op if the stream never got a session (STREAM=0, or a run that died
# before the first event) — same reasoning as claude_session itself: nothing
# is a normal answer, not a blank line worth writing down.
record_session() {
	local sess tmp base
	[[ -z "${CONVEYOR_RESULT:-}" ]] && return 0
	sess=$(claude_session)
	[[ -z "$sess" ]] && return 0
	tmp=$(mktemp)
	base='{}'
	[[ -s "$CONVEYOR_RESULT" ]] && jq -e . "$CONVEYOR_RESULT" >/dev/null 2>&1 && base=$(cat "$CONVEYOR_RESULT")
	if jq --arg s "$sess" '. + {session: $s}' <<<"$base" >"$tmp" 2>/dev/null; then
		mv "$tmp" "$CONVEYOR_RESULT"
	else
		rm -f "$tmp"
	fi
}

# agent_asked marks what the model wrote in $CONVEYOR_RESULT as a question, and
# adds the conversation it can be answered in.
#
# Called only where the model stopped itself, which every adapter's prompt
# defines as "this needs a decision only a human can make" — so it is a question
# by construction, and gets `asked` for the engine and `session` for the reply.
# Merged rather than written: the model owns that file, knows nothing about
# either field, and its reason is the part worth keeping intact.
agent_asked() {
	local sess tmp
	[[ -z "${CONVEYOR_RESULT:-}" || ! -s "$CONVEYOR_RESULT" ]] && return 0
	sess=$(claude_session)
	tmp=$(mktemp)
	if jq --arg s "$sess" \
		'. + {asked: true} + (if $s == "" then {} else {session: $s} end)' \
		"$CONVEYOR_RESULT" >"$tmp" 2>/dev/null; then
		mv "$tmp" "$CONVEYOR_RESULT"
	else
		rm -f "$tmp"
	fi
}

# render_stream reads the event stream on stdin and writes readable text.
#
# The result event is the one place the CLI says why a run ended, and until
# now nothing here read it: `is_error` true and `is_error` false printed the
# same blank line, so a clean finish and a run cut off by --max-turns (exit 1,
# no assistant text at all — subtype "error_max_turns") were indistinguishable
# in the log. A person reading a blocked item's history a day later had
# nothing but "exit 1" to go on. This still prints nothing the engine parses
# (CONTRACTS §2 — stdout stays logs), it just stops throwing the one useful
# fact away.
#
# TodoWrite is the one tool call whose argument the frontend also reads back
# structurally (index.html's parseTodos, presentation only, same tier as the
# `  · Name: arg` shape below) — so its input goes out whole, never through
# the [0:100] cut everything else gets. The plan is only ever a few short
# lines; there is nothing here worth truncating.
render_stream() {
	jq -j --unbuffered '
		if .type == "assistant" then
			(.message.content[]? |
				if .type == "text" then .text
				elif .type == "tool_use" and .name == "TodoWrite" then
					"\n  · TodoWrite: \(.input.todos // [] | tostring)\n"
				elif .type == "tool_use" then
					"\n  · \(.name): \((.input.command // .input.file_path // .input.pattern
					                   // .input.description // "") | tostring | .[0:100])\n"
				else empty end)
		elif .type == "result" then
			if (.is_error // false) then
				"\n[claude stopped: \(.subtype // "error")" +
				(if .num_turns then " after \(.num_turns) turn(s)" else "" end) +
				"]" +
				(if .result then " \(.result)" else "" end) +
				"\n"
			else "\n" end
		else empty end' 2>/dev/null
}

# run_claude "<prompt>" — honours STREAM=0 for the terse, final-message-only log.
# Returns claude's exit status, not jq's.
run_claude() {
	local prompt=$1
	local -a flags=(
		--max-turns "${MAX_TURNS:-40}"
		--permission-mode "${PERMISSION_MODE:-acceptEdits}"
		--allowedTools "${ALLOWED_TOOLS:-Bash,Read,Glob,Grep}"
	)
	[[ -n "${MODEL:-}" ]] && flags+=(--model "$MODEL")
	# Set by resume_prompt when a person answered and the conversation survives.
	[[ -n "${RESUME_SESSION:-}" ]] && flags+=(--resume "$RESUME_SESSION")

	if [[ "${STREAM:-1}" == "0" ]]; then
		claude -p "$prompt" "${flags[@]}" | tee "$CLAUDE_SAID"
		return "${PIPESTATUS[0]}"
	fi
	claude -p "$prompt" --output-format stream-json --verbose "${flags[@]}" |
		tee "$CLAUDE_RAW" | render_stream | tee "$CLAUDE_SAID"
	return "${PIPESTATUS[0]}"
}
