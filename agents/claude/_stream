#!/usr/bin/env bash
# Sourced by the claude adapters. Not a verb: config resolves script names
# exactly, so a leading underscore can never be mistaken for one.
#
# `claude -p` prints nothing until it finishes — a two-minute stage looks dead
# in the log and on the board. --output-format stream-json emits events as they
# happen; this turns them into lines a person can follow, without dumping whole
# tool payloads into the run log.

# Where the last run_claude put a copy of what the agent printed. The adapters
# read it to tell *why* a run produced nothing — a run stopped by a usage limit
# and a run that decided to do nothing look identical from the exit code, and
# they are opposite problems.
#
# This is a script reading its own agent's output, not the engine reading a log:
# CONTRACTS §2 is about what the engine may parse, and the answer there is still
# nothing but $CONVEYOR_RESULT.
CLAUDE_SAID=$(mktemp)
# The same run, unrendered. render_stream throws away everything it does not
# print, and the session id is in that everything: it is how an answer gets said
# back into the conversation that asked, instead of starting a new one that has
# to rediscover the repository first.
CLAUDE_RAW=$(mktemp)
CLAUDE_FINAL=$(mktemp)
trap 'rm -f "$CLAUDE_SAID" "$CLAUDE_RAW" "$CLAUDE_FINAL"' EXIT

declare -f result_accept >/dev/null 2>&1 || source "$(dirname "${BASH_SOURCE[0]}")/../_result"

# claude_session prints the conversation's own id, or nothing. Nothing is a
# normal answer: STREAM=0 produces no events, and an adapter that gets no
# session simply cannot be resumed, which the engine already tolerates.
# `|| true` is not decoration. Every event in the stream carries a session_id,
# so on a real run jq is still writing thousands of lines when `head` takes its
# one and closes the pipe. jq dies of SIGPIPE, `pipefail` makes the pipeline
# 141, and an unguarded `sess=$(claude_session)` hands that to errexit, which
# kills the adapter mid-branch. head already has the line by then, so the status
# is the only thing worth discarding — and "nothing is a normal answer" above
# means there is no input for which a non-zero status here would mean anything.
claude_session() {
	[[ -s "$CLAUDE_RAW" ]] || return 0
	jq -r 'select(.session_id != null) | .session_id' "$CLAUDE_RAW" 2>/dev/null | head -1 || true
}

# claude_model prints the model this run actually used, or nothing.
#
# The resolved one, out of the run's own init event — never an echo of $MODEL,
# because the case worth writing down is $MODEL unset, where the CLI picks and
# nothing anywhere records what it picked. Nothing is a normal answer, for the
# same reason claude_session gives one: STREAM=0 produces no events.
claude_model() {
	[[ -s "$CLAUDE_RAW" ]] || return 0
	# Guarded for the same reason as claude_session, though this filter matches
	# one event today and so rarely fills the pipe. A helper whose contract is
	# "nothing is a normal answer" should not be one busy run away from 141.
	jq -r 'select(.type == "system" and .subtype == "init") | .model' "$CLAUDE_RAW" 2>/dev/null | head -1 || true
}

# record_model writes that model to the log, on a line of its own.
#
# For people and for grep over run history — which is the whole point: "is the
# cheaper model as good" is a question about the blocked rate per stage per
# model, and none of it is answerable while the model is only ever in a
# temporary file this script deletes on the way out.
#
# It is stdout, so it is logs, and CONTRACTS §2 says the engine never parses
# those: the engine learns nothing about models from this and must not.
# It never fails, because the adapter's exit status is the run's verdict and a
# note about the run has no business changing it.
record_model() {
	local model line
	model=$(claude_model) || return 0
	[[ -n "$model" && "$model" != "null" ]] || return 0
	# `|| true` is the whole of "it never fails": stdout here is a pipe to the
	# engine, and a write to it can fail — the reader gone, the disk full. As
	# the last command of an && list that echo is not exempt from errexit, so
	# without this the adapter leaves on the note's status and never reaches
	# `exit $rc`. A run that did the work would then be recorded as a failure
	# because the line describing it could not be written.
	line=$(redact_text "model: $model") || line="model: [REDACTED]"
	echo "$line" || true
	return 0
}

# resume_prompt <payload> <prompt> — what to actually send, given that a person
# may have answered the question this stage stopped on last time.
#
# Three cases, and only the first is new work. With an answer and a session, the
# answer alone is the whole message: the conversation still holds the item, the
# repository and everything the agent had already worked out. With an answer and
# no session — a different agent, a restart before the id was written — the
# answer leads the original prompt, which costs the rediscovery but never costs
# the answer. With no answer, nothing changes.
resume_prompt() {
	local payload=$1 default=$2 answer session
	answer=$(jq -r '.answer // ""' <<<"$payload")
	session=$(jq -r '.session // ""' <<<"$payload")

	if [[ -z "$answer" ]]; then
		printf '%s' "$default"
		return 0
	fi
	if [[ -n "$session" && "$session" != opencode:* ]]; then
		RESUME_SESSION=$session
		echo "resuming the conversation that asked (session ${session:0:8})" >&2
		printf '%s' "$answer"
		return 0
	fi
	printf '%s' "The question you stopped on has been answered: ${answer}

Carry on from there.

--- what you were asked to do originally ---
${default}"
}

# hit_limit reports whether the account was out of quota. Claude Code says so in
# the transcript and exits cleanly, so nothing else can tell you. Classification
# reads the private raw stream; CLAUDE_SAID is redacted for human-visible logs.
#
# Anchored to the start of a line, because the transcript is not only the CLI
# talking — it is also the model talking, and the model quotes. Searching the
# whole text for the phrase read this, in a refine that had finished its work
# and was explaining why a *different* tool could not run:
#
#   **Codex did not run.** ... (`ERROR: You've hit your usage limit... try
#   again at Sep 8th`)
#
# and marked the item out of quota, which paused every claude stage on the
# board behind a limit that was not ours and not now. The CLI's own refusal is
# always a line of its own and always the last thing it says —
#
#   You've hit your session limit · resets 8:30pm (UTC)
#
# — so requiring it to begin a line costs nothing real and is not something
# prose does. `You.{0,2}ve` spans both the plain and the typographic
# apostrophe without depending on the locale to make a bracket expression
# match a multibyte character.
hit_limit() {
	[[ -s "$CLAUDE_RAW" ]] && render_stream <"$CLAUDE_RAW" |
		grep -qiE "^[[:space:]]*You.{0,2}ve hit your (session|usage|weekly) limit"
}

# hit_max_turns reports whether the run stopped because it exhausted its
# --max-turns budget rather than finishing or being denied for quota. Reads
# its private result event with is_error and subtype "error_max_turns".
#
# This is a condition, not a decision: the work done before the wall is real
# (commits pushed, comments posted, tests run), and what stopped it was a
# number in conveyor.yaml, not anything wrong with the item. Call
# record_session first if the caller wants the conversation resumable —
# hit_max_turns only answers "was this the reason", it writes nothing.
hit_max_turns() {
	[[ -s "$CLAUDE_RAW" ]] &&
		jq -e 'select(.type == "result" and (.is_error // false) and .subtype == "error_max_turns")' "$CLAUDE_RAW" >/dev/null 2>&1
}

# record_session merges {"session": "..."} into $CONVEYOR_RESULT, creating it
# if a caller hits this before the agent has written anything of its own —
# unlike agent_asked, which only ever adds to a file the model already wrote.
# The two are siblings: agent_asked marks a question the model chose to ask;
# this marks a run an adapter, not the model, decided is worth resuming, which
# is exactly the turns case above — nothing in $CONVEYOR_RESULT yet, because
# the run never got to write anything, only ran out of room to.
#
# A no-op if the stream never got a session (STREAM=0, or a run that died
# before the first event) — same reasoning as claude_session itself: nothing
# is a normal answer, not a blank line worth writing down.
record_session() {
	local sess base merged
	[[ -z "${CONVEYOR_RESULT:-}" ]] && return 0
	sess=$(claude_session)
	[[ -z "$sess" ]] && return 0
	base='{}'
	[[ -s "$CONVEYOR_RESULT" ]] && jq -e . "$CONVEYOR_RESULT" >/dev/null 2>&1 && base=$(cat "$CONVEYOR_RESULT")
	merged=$(jq -c --arg s "$sess" '. + {v:1,outcome:(.outcome // "success"),session:$s}' <<<"$base" 2>/dev/null) || return 0
	result_write_json "$merged" || true
}

# agent_asked needs _blocked's is_condition_kind, but every adapter sources
# this file first — agents/claude/selfcheck earliest of all, calling
# agent_asked well before it ever sources _blocked itself — so this sources
# it here, guarded on the predicate not already being defined: an adapter's
# own `source ../_blocked` line right after this one then finds it already
# there, and no path sources the file twice.
declare -f is_condition_kind >/dev/null 2>&1 || source "$(dirname "${BASH_SOURCE[0]}")/../_blocked"
declare -f plan_publish >/dev/null 2>&1 || source "$(dirname "${BASH_SOURCE[0]}")/../_plan"

# agent_asked classifies what the model wrote in $CONVEYOR_RESULT as a
# question or leaves it a condition, following the kind the model actually
# declared, and adds the conversation it can be answered or resumed in
# either way.
#
# Every adapter's prompt tells the model to stop with `kind: decision` when a
# person has to choose something — but nothing stops a model that correctly
# recognises a *condition* instead (out of scope, a dependency still open,
# the deadline hit) and says so, and forcing `asked: true` on that stop made a
# condition that clears itself sit waiting for a person with nothing to
# decide (#68). is_condition_kind (agents/_blocked) is the one place that
# split lives; this reads it rather than assuming every model-written stop is
# a question by construction:
#
#   the kind is on agents/_blocked's condition list  → asked: false
#   anything else, including an unknown word         → asked: true
#   `questions` is a non-empty array of objects, the
#   shape board.js's questionsOf walks — whatever the
#   kind, since the model wrote options for a person
#   to press, which is unambiguous                    → asked: true
#
# `asked` is always written, overwriting whatever was already there, so the
# merged file can never say both things at once. `session` is added whenever
# the stream has one, on a condition exactly as on a question — `turns` and
# `unfinished` are the resumable kinds, and the session is what a resume goes
# back into. `kind` still defaults to `decision` when the model wrote none;
# `reason` and `questions` are left exactly as written, and a file jq cannot
# read as an object is left untouched, same as always.
agent_asked() {
	local sess kind asked merged
	[[ -z "${CONVEYOR_RESULT:-}" || ! -s "$CONVEYOR_RESULT" ]] && return 0
	jq -e 'type == "object"' "$CONVEYOR_RESULT" >/dev/null 2>&1 || return 0
	kind=$(jq -r '.kind // "decision"' "$CONVEYOR_RESULT" 2>/dev/null) || return 0
	sess=$(claude_session)
	asked=true
	is_condition_kind "$kind" && asked=false
	if jq -e '(.questions // []) | type == "array" and length > 0 and all(.[]; type == "object")' \
		"$CONVEYOR_RESULT" >/dev/null 2>&1; then
		asked=true
	fi
	merged=$(jq -c --arg s "$sess" --arg kind "$kind" --argjson asked "$asked" \
		'. + {v:1,outcome:"blocked",blocked:true,kind:$kind,asked:$asked} + (if $s == "" then {} else {session:$s} end)' \
		"$CONVEYOR_RESULT" 2>/dev/null) || return 0
	result_write_json "$merged" || true
}

# last_said — the tail of what the model said, one line, for a reason that
# would otherwise be "exited 1": the card then says what it was doing.
last_said() {
	[[ -s "${CLAUDE_SAID:-}" ]] || return 0
	grep -v '^\s*$' "$CLAUDE_SAID" | tail -n 3 | tr -s '[:space:]' ' ' | cut -c1-300
}

# render_stream reads the event stream on stdin and writes readable text.
#
# The result event is the one place the CLI says why a run ended, and until
# now nothing here read it: `is_error` true and `is_error` false printed the
# same blank line, so a clean finish and a run cut off by --max-turns (exit 1,
# no assistant text at all — subtype "error_max_turns") were indistinguishable
# in the log. A person reading a blocked item's history a day later had
# nothing but "exit 1" to go on. This still prints nothing the engine parses
# (CONTRACTS §2 — stdout stays logs), it just stops throwing the one useful
# fact away.
#
# TodoWrite is the one tool call whose argument reaches structured state, via
# $CONVEYOR_PLAN rather than the log (#110): its input goes out whole, tagged
# with the CONVEYOR_PLAN_TODOS: sentinel _plan_route_claude_stream (below)
# intercepts and replaces with a human summary before anything reaches
# CLAUDE_SAID or the run's own log — never through the [0:100] cut everything
# else gets, since the plan is only ever a few short lines.
render_stream() {
	jq -j --unbuffered '
		if .type == "assistant" then
			(.message.content[]? |
				if .type == "text" then .text
				elif .type == "tool_use" and .name == "TodoWrite" then
					"\nCONVEYOR_PLAN_TODOS:\(.input.todos // [] | tostring)\n"
				elif .type == "tool_use" then
					"\n  · \(.name): \((.input.command // .input.file_path // .input.pattern
					                   // .input.description // "") | tostring | .[0:100])\n"
				else empty end)
		elif .type == "result" then
			if (.is_error // false) then
				"\n[claude stopped: \(.subtype // "error")" +
				(if .num_turns then " after \(.num_turns) turn(s)" else "" end) +
				"]" +
				(if .result then " \(.result)" else "" end) +
				"\n"
			else "\n" end
		else empty end' 2>/dev/null
}

# _plan_route_claude_stream reads render_stream's output and intercepts the
# CONVEYOR_PLAN_TODOS: line it tags a TodoWrite call with: maps Claude's
# {content, status, activeForm} shape into the plan protocol (content -> text,
# activeForm -> active, both derived ids and duplicate-text suffixes left to
# plan_publish/agents/_plan) and publishes it live, in the same pass the
# stream is already read in — which is what makes the board update mid-run
# rather than only after the whole conversation ends. Every other line passes
# through unchanged, so this adds no new failure mode to a run that publishes
# no plan: an unparsable payload is simply not published, silently.
_plan_route_claude_stream() {
	local line
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" == CONVEYOR_PLAN_TODOS:* ]]; then
			local raw="${line#CONVEYOR_PLAN_TODOS:}" mapped
			mapped=$(jq -c '[.[] | {text: (.content // ""), status: (.status // ""), active: (.activeForm // "")}
				| if .active == "" then del(.active) else . end]' <<<"$raw" 2>/dev/null)
			if [[ -n "$mapped" ]]; then
				plan_publish "$mapped"
				local total done_n
				total=$(jq 'length' <<<"$mapped" 2>/dev/null || echo 0)
				done_n=$(jq '[.[] | select(.status == "completed")] | length' <<<"$mapped" 2>/dev/null || echo 0)
				echo "  · plan updated ($done_n/$total done)"
			fi
			continue
		fi
		printf '%s\n' "$line"
	done
}

# _claude_final extracts exactly one successful terminal result. Duplicate
# result events are ambiguous, even when their contents happen to match.
_claude_final() {
	jq -c -s '
		[.[] | select(.type == "result")] as $results |
		select(($results | length) == 1 and (($results[0].is_error // false) == false)) |
		$results[0] | (.structured_output // .result // empty) |
		if type == "string" then . else tojson end
	' "$CLAUDE_RAW" 2>/dev/null | jq -r . 2>/dev/null
}

_claude_invoke() {
	local prompt=$1 correction=${2:-0} result_count
	local -a statuses
	local -a flags=(
		--max-turns "${MAX_TURNS:-40}"
		--permission-mode "${PERMISSION_MODE:-acceptEdits}"
		--allowedTools "${ALLOWED_TOOLS:-Bash,Read,Glob,Grep}"
		--json-schema "$(result_json_schema)"
	)
	[[ -n "${MODEL:-}" ]] && flags+=(--model "$MODEL")
	# Set by resume_prompt when a person answered and the conversation survives.
	[[ -n "${RESUME_SESSION:-}" ]] && flags+=(--resume "$RESUME_SESSION")
	if [[ "$correction" == 1 ]]; then
		flags=(--max-turns 1 --permission-mode dontAsk --tools "" --allowedTools "" --json-schema "$(result_json_schema)")
		[[ -n "${MODEL:-}" ]] && flags+=(--model "$MODEL")
		[[ -n "${RESUME_SESSION:-}" ]] && flags+=(--resume "$RESUME_SESSION")
	fi

	: >"$CLAUDE_RAW"
	: >"$CLAUDE_SAID"
	# CONVEYOR_RESULT belongs to this parent adapter and is deliberately absent
	# from the model process's environment.
	if [[ "${STREAM:-1}" == 0 ]]; then
		env -u CONVEYOR_RESULT claude -p "$prompt" --output-format stream-json --verbose "${flags[@]}" 2> >(redact_stream >&2) |
			tee "$CLAUDE_RAW" | render_stream | _plan_route_claude_stream | redact_stream | tee "$CLAUDE_SAID" >/dev/null
	else
		env -u CONVEYOR_RESULT claude -p "$prompt" --output-format stream-json --verbose "${flags[@]}" 2> >(redact_stream >&2) |
			tee "$CLAUDE_RAW" | render_stream | _plan_route_claude_stream | redact_stream | tee "$CLAUDE_SAID"
	fi
	statuses=("${PIPESTATUS[@]}")
	[[ ${statuses[0]} -eq 0 ]] || return "${statuses[0]}"
	[[ ${statuses[2]} -eq 0 ]] || return 2
	result_count=$(jq -s '[.[] | select(.type == "result")] | length' "$CLAUDE_RAW" 2>/dev/null) || return 2
	[[ "$result_count" -gt 0 ]] || {
		echo "claude stream ended without a result event" >&2
		return 2
	}
	if jq -s -e 'any(.[]; .type == "result" and (.is_error // false))' "$CLAUDE_RAW" >/dev/null 2>&1; then
		return 1
	fi
	if [[ "${STREAM:-1}" == 0 ]]; then
		redact_text "$(_claude_final)"
		printf '\n'
	fi
	return 0
}

# run_claude owns the complete model-to-result transaction. A clean backend
# completion must yield one valid result; one formatting-only correction is the
# sole retry, after which the item is quarantined precisely.
run_claude() {
	local prompt=$1 rc final session failure
	prompt="${prompt}

$(result_brief)"
	if _claude_invoke "$prompt"; then rc=0; else rc=$?; fi
	[[ $rc -eq 0 ]] || return "$rc"
	session=$(claude_session)
	final=$(_claude_final)
	if [[ -n "$final" ]] && result_accept "$final" "$session"; then
		result_is_waiting && return 10
		return 0
	fi
	failure="the agent completed without one valid version-1 final result"
	if [[ -z "$session" ]]; then
		result_quarantine "$failure; no session was available for a same-session correction"
		return 20
	fi
	RESUME_SESSION=$session
	if _claude_invoke "$(result_correction_brief)" 1; then rc=0; else rc=$?; fi
	if [[ $rc -eq 0 ]]; then
		final=$(_claude_final)
		if [[ -n "$final" ]] && result_accept "$final" "$session"; then
			result_is_waiting && return 10
			return 0
		fi
		failure="the agent's single result correction was still missing, ambiguous, or invalid"
	else
		failure="the agent's single result correction failed (exit $rc)"
	fi
	result_quarantine "$failure" "$session" || {
		echo "could not persist the invalid-result quarantine" >&2
		return 1
	}
	echo "blocked (invalid-result): $failure" >&2
	return 20
}
