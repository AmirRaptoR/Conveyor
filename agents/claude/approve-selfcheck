#!/usr/bin/env bash
# Drives agents/claude/approve against a stubbed `gh`, and asserts the exit code
# and the mark it leaves. Touches no repository and runs no model.
#
#   agents/claude/approve-selfcheck
#
# The gate is fourteen ordered rules and most of them are unreachable in a live
# repository on demand — you cannot ask GitHub for a conflicting PR with a
# failing check and an unresolved thread. A stub is the only way to exercise
# them, and the same pattern providers/github/selfcheck.sh already uses.
#
# The model path (gate 11, and gate 8's conflict-resolution path) is
# deliberately not driven here: it needs a worktree, a remote and claude. What
# is checked is everything that decides *whether* to get there — a stubbed
# `git` that refuses every call stands in so that a scene which reaches
# resolve_conflict fails fast on the worktree it cannot build, rather than
# touching this repository. See agents/claude/approve's issue for what is left
# for reading and for one manual smoke: criteria 10 and 12-24.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)

fail=0
chk() { if [[ "$2" == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fail=1; fi; }

# The guard against this issue's class of bug: a --json field valid in one gh
# dialect (GraphQL) asked for in another (REST) — isInMergeQueue on `pr view`
# was exactly that, and the stub above cannot catch it because it dispatches
# by verb alone and answers from a fixture regardless of which fields were
# asked for. Checked against the real gh's own field list per verb, captured
# before PATH is shadowed below, same as real_git further down. `gh <verb>
# --json` with no value needs no repository, no network and no auth — it
# exits 1 and prints its authoritative field list to stderr.
#
# A call site's verb and its --json list can be on different physical lines
# (approve:957-958's was, over a `\` continuation), so continuations are
# joined first; a static line-by-line grep would miss exactly the site this
# issue is about.
real_gh=$(command -v gh || true)
declare -A _json_fields_cache # verb ("pr view") -> real gh's own field list for it
check_json_fields() {
	if [[ -z "$real_gh" ]]; then
		echo "skip json-field guard: gh is not installed"
		return
	fi
	local joined line trimmed verb1 verb2 verb fields available f invalid
	joined=$(awk '{ if (sub(/\\[[:space:]]*$/, "")) { printf "%s ", $0; next } else { print } }' "$here/approve")
	while IFS= read -r line; do
		trimmed="${line#"${line%%[![:space:]]*}"}"
		[[ "$trimmed" == \#* ]] && continue # a comment mentioning --json, not a call
		[[ "$line" =~ (pr|issue)[[:space:]]+(list|view)[^\#]*--json[[:space:]]+([A-Za-z0-9_,]+) ]] || continue
		verb1="${BASH_REMATCH[1]}" verb2="${BASH_REMATCH[2]}" fields="${BASH_REMATCH[3]}"
		verb="$verb1 $verb2"
		if [[ -z "${_json_fields_cache[$verb]+set}" ]]; then
			_json_fields_cache[$verb]=$("$real_gh" "$verb1" "$verb2" --json 2>&1)
		fi
		available="${_json_fields_cache[$verb]}"
		invalid=""
		IFS=',' read -ra flist <<<"$fields"
		for f in "${flist[@]}"; do
			grep -qx "  $f" <<<"$available" || invalid+="$f "
		done
		if [[ -n "$invalid" ]]; then
			echo "FAIL json-field guard: ${invalid% } not valid for '$verb' --json (agents/claude/approve)"
			fail=1
		else
			echo "ok   json-field guard: $fields valid for '$verb' --json"
		fi
	done <<<"$joined"
}
check_json_fields

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/scene"
export PATH="$tmp/bin:$PATH"
export WORKTREES="$tmp/worktrees" # nothing there, so drop_worktree is a no-op

# The stub answers by verb, out of files the scenario wrote. A missing file is a
# missing expectation, and it says so rather than returning empty JSON that the
# gate would read as a real answer.
cat >"$tmp/bin/gh" <<'STUB'
#!/usr/bin/env bash
scene="$SCENE"
case "$1 $2" in
"pr list")   what=prlist ;;
"issue view") what=labels_$3 ;;
"api graphql")
	# Two distinct queries share this one verb: fetch_details' pre-merge read
	# (asks for isDraft, among much else) and the post-merge confirmation read
	# (does not — it is four fields, none of them isDraft). Routed by content
	# rather than call order, so a scene need not care how many times each ran.
	if [[ "$*" == *isDraft* ]]; then what=graphql; else what=confirm; fi
	printf '%s\n' "$*" >>"$scene/graphql_calls" ;;
"api repos"*) what=timeline ;;
"pr edit")   echo "unlabelled"; exit 0 ;;
"pr comment") printf '%s\n' "$*" >>"$scene/comments_posted"; exit 0 ;;
"pr merge")  echo "merged"; touch "$scene/merge_called"; [[ -f "$scene/merge_fails" ]] && exit 1; touch "$scene/merged"; exit 0 ;;
*)
	case "$1" in
	api) what=timeline ;;
	*) echo "stub gh: unhandled: $*" >&2; exit 97 ;;
	esac
	;;
esac
[[ -f "$scene/fail_$what" ]] && { echo "stub: $what fails"; exit 1; }
if [[ ! -f "$scene/$what" ]]; then
	echo "stub gh: no fixture $what for: $*" >&2
	exit 98
fi
cat "$scene/$what"
STUB
chmod +x "$tmp/bin/gh"

# git is stubbed too, and refuses everything: a scene that reaches
# resolve_conflict (gate 8's marker check found no matching earlier attempt)
# must fail fast on the worktree it then cannot build, rather than running
# `git fetch`/`git worktree add` for real against this repository's own
# origin. Every path that stops before resolve_conflict never calls git at
# all in this sandbox, since the worktree directory it would inspect never
# exists here — so this stub changes nothing about them.
#
# SELFCHECK_REAL_GIT lifts the refusal, and only the last section sets it:
# resolve_conflict's own arithmetic — what a half-finished merge looks like and
# what finishes it — is git's behaviour and cannot be asserted against a stub
# that has none. The repository it then works in is built from nothing under
# $tmp, with its own bare origin; this checkout is still never touched, which
# is what the refusal is actually protecting.
real_git=$(command -v git)
cat >"$tmp/bin/git" <<STUB
#!/usr/bin/env bash
[[ -n "\${SELFCHECK_REAL_GIT:-}" ]] && exec $real_git "\$@"
echo "stub git: refusing \$*" >&2
exit 1
STUB
chmod +x "$tmp/bin/git"

# claude refuses outright and leaves a receipt. Nothing in this file may run a
# model, and the last section asserts a specific absence — that finishing a
# merge somebody already resolved costs no model run — which needs the
# difference between "did not run" and "ran and failed" to be visible.
cat >"$tmp/bin/claude" <<STUB
#!/usr/bin/env bash
touch "$tmp/claude-ran"
echo "stub claude: refusing to run a model" >&2
exit 1
STUB
chmod +x "$tmp/bin/claude"

# run <name> — run approve in the current scene and report its exit code.
run() {
	local rc
	: >"$CONVEYOR_RESULT"
	echo '{"item":{"ref":"7","title":"an item"}}' |
		SCENE="$tmp/scene" REPO=o/n PROMPT="fix it" CONVEYOR_SOURCE=s1 \
			QUIET_SECONDS="${QUIET:-0}" CONFLICT_RESOLVE="${CONFLICT_RESOLVE:-}" \
			CONVEYOR_MANUAL="${CONVEYOR_MANUAL:-}" \
			"$here/approve" >/dev/null 2>&1
	rc=$?
	echo "$rc"
}
kind() { jq -r '.kind // "none"' "$CONVEYOR_RESULT" 2>/dev/null || echo none; }
asked() { jq -r '.asked // false' "$CONVEYOR_RESULT" 2>/dev/null || echo false; }
export CONVEYOR_RESULT="$tmp/result.json"

scene() { rm -f "$tmp/scene"/*; }
pr() { printf '[{"number":%s,"body":"Closes #7","state":"%s","url":"u"}]' "$1" "$2" >"$tmp/scene/prlist"; }
labels() { printf '%s' "${1:-[]}" >"$tmp/scene/labels_7"; printf '%s' "${2:-[]}" >"$tmp/scene/labels_9"; }
# details <isDraft> <mergeable> <rollup> [threads-json] [headRefName]
#         [isCrossRepository] [headRefOid] [baseRefOid] [comments-json]
#         [isInMergeQueue] [autoMergeRequest-json]
#
# headRefOid/baseRefOid default to two distinct, well-formed 40-character hex
# strings, so a scene that says nothing about the marker looks like a PR gate
# 8 has never attempted before.
details() {
	local rollup_field='null'
	[[ -n "$3" ]] && rollup_field="{\"state\":\"$3\"}"
	# Plain `-`, not `:-`: an explicitly empty oid (criterion 11's scene) must
	# stay empty rather than being replaced by the default, which `:-` would do.
	local head_ref="${5-issue-7}" cross="${6-false}" \
		head_oid="${7-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" \
		base_oid="${8-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb}" comments="${9-[]}" \
		queue="${10:-false}" automerge="${11-null}"
	cat >"$tmp/scene/graphql" <<JSON
{"isDraft":$1,"mergeable":"$2","headRefName":"$head_ref","headRefOid":"$head_oid",
 "baseRefName":"main","baseRefOid":"$base_oid","isCrossRepository":$cross,
 "isInMergeQueue":$queue,"autoMergeRequest":$automerge,
 "commits":{"nodes":[{"commit":{"committedDate":"2020-01-01T00:00:00Z","statusCheckRollup":$rollup_field}}]},
 "comments":{"nodes":$comments},"reviews":{"nodes":[]},
 "reviewThreads":{"pageInfo":{"hasNextPage":false},"nodes":${4:-[]}}}
JSON
	# The stub does not run --jq, so fixtures are written in post-jq form. For
	# the timeline that is a bare timestamp, or nothing.
	: >"$tmp/scene/timeline"
	# Default post-merge view: the merge gate 14 is about to attempt actually
	# lands, at the exact head this call just inspected. F06's scenes below
	# overwrite this to simulate a moved head, a queued/auto-merge outcome, or
	# a merge genuinely refused.
	cat >"$tmp/scene/confirm" <<JSON
{"state":"MERGED","headRefOid":"$head_oid","isInMergeQueue":false,"autoMergeRequest":null}
JSON
}

# --- 1. a gh call that fails is a blip, not a verdict -----------------------
scene; pr 9 OPEN; touch "$tmp/scene/fail_prlist"
chk "(1) a failed gh call defers"            "$(run)" "10"

# --- 2/3. finding the pull request -----------------------------------------
scene; echo '[]' >"$tmp/scene/prlist"
chk "(2) no PR closing the issue stops"      "$(run)" "20"
chk "     and the kind is input"             "$(kind)" "input"

scene; printf '[{"number":9,"body":"Closes #7","state":"OPEN","url":"u"},{"number":10,"body":"closes #7","state":"OPEN","url":"u"}]' >"$tmp/scene/prlist"
chk "(3) two open PRs stop rather than pick" "$(run)" "20"
chk "     and the kind is input"             "$(kind)" "input"

# A PR that merely mentions the issue is not a PR that closes it.
scene; printf '[{"number":9,"body":"related to #7","state":"OPEN","url":"u"}]' >"$tmp/scene/prlist"
chk "a mention is not a closing reference"   "$(run)" "20"

# A closing keyword inside a fenced code block is a template's example, not a
# live instruction — the same rule agents/_pr's pr_match_filter applies, since
# discover_pr shares it.
scene; printf '[{"number":9,"body":"```\\nCloses #7\\n```","state":"OPEN","url":"u"}]' >"$tmp/scene/prlist"
chk "a fenced closing keyword does not match" "$(run)" "20"
chk "     and the kind is input"              "$(kind)" "input"

# A PR opened from this item's own issue-<ref> branch is a match even with no
# closing keyword in its body at all — gate 4 (already merged) reaches it
# with no other fixture needed, which is enough to prove discover_pr counted
# it as a match at all.
scene; printf '[{"number":9,"body":"no keyword here","state":"MERGED","headRefName":"issue-7","url":"u"}]' >"$tmp/scene/prlist"
chk "the item's own branch name matches with no keyword" "$(run)" "0"

# gh's own page cap: a full page with no match in it might be hiding one
# behind, so this defers rather than reporting "no PR closes the issue".
scene
jq -n '[range(100) | {number: ., body: "unrelated", state: "OPEN", url: "u"}]' >"$tmp/scene/prlist"
chk "a full page with no match defers, not none" "$(run)" "10"

# --- 4/5. the PR is already finished ---------------------------------------
scene; pr 9 MERGED
chk "(4) an already-merged PR passes through" "$(run)" "0"
chk "     without merging again"              "$([[ -f "$tmp/scene/merged" ]] && echo merged || echo no)" "no"

scene; pr 9 CLOSED
chk "(5) a closed unmerged PR stops"          "$(run)" "20"
chk "     and the kind is decision"           "$(kind)" "decision"

# --- 6. a hold, on either object -------------------------------------------
scene; pr 9 OPEN; labels '["conveyor:blocked"]' '[]'; details false MERGEABLE SUCCESS
chk "(6) a hold on the issue stops"           "$(run)" "20"
chk "     and the kind is human-review"       "$(kind)" "human-review"

scene; pr 9 OPEN; labels '[]' '["conveyor:blocked"]'; details false MERGEABLE SUCCESS
chk "(6) a hold on the PR stops"              "$(run)" "20"
chk "     and the kind is human-review"       "$(kind)" "human-review"

# The bare kind label is a different label and is not a hold.
scene; pr 9 OPEN; labels '["conveyor:blocked: decision"]' '[]'; details false MERGEABLE SUCCESS
chk "a kind label alone is not a hold"        "$(run)" "0"

# --- 7/8. draft and conflict ------------------------------------------------
scene; pr 9 OPEN; labels; details true MERGEABLE SUCCESS
chk "(7) a draft waits"                       "$(run)" "10"
chk "     and names the PR in what it's waiting for" \
	"$(jq -r '.waiting.why // ""' "$CONVEYOR_RESULT" | grep -c '#9')" "1"

# (1/2) try_rebase always fails here (no worktree in this sandbox), whatever
# CONFLICT_RESOLVE is set to — so with it at "0" this is exactly today's old
# behaviour, unconditionally.
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS
chk "(1) a conflict stops with the off switch set" "$(CONFLICT_RESOLVE=0 run)" "20"
chk "     and the kind is conflict"                "$(kind)" "conflict"

scene; pr 9 OPEN; labels; details false UNKNOWN SUCCESS
chk "mergeability not yet known waits"        "$(run)" "10"

# --- 4/5. resolution only on a branch this pipeline owns --------------------
# CONFLICT_RESOLVE is unset (the default) for all of these: resolution is
# enabled, and each stops on ownership before ever reaching resolve_conflict.
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 true
chk "(4) a fork's conflict is not this pipeline's to rewrite" "$(run)" "20"
chk "     and the kind is conflict"                           "$(kind)" "conflict"

scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' patch-1
chk "(5) a branch that is not issue-<ref> is not rewritten"  "$(run)" "20"
chk "     and the kind is conflict"                           "$(kind)" "conflict"

# --- 11. an incomplete view defers rather than acts -------------------------
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false '' ''
chk "(11) a missing head/base OID defers"     "$(run)" "10"

# --- 7/8/9. the bound: one attempt per head/base pair, via the newest marker
matching='[{"createdAt":"2020-01-01T00:00:00Z","body":"<!-- conveyor:approve:conflict aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb -->"}]'
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false \
	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb "$matching"
chk "(7) the same conflict already attempted asks, and runs no model" "$(run)" "20"
chk "     and the kind is decision"                                   "$(kind)" "decision"
chk "     and it is a question, never bulk-cleared"                   "$(asked)" "true"

malformed_then_valid='[{"createdAt":"2020-01-01T00:00:00Z","body":"<!-- conveyor:approve:conflict nothex nothex -->"},
	{"createdAt":"2020-01-02T00:00:00Z","body":"<!-- conveyor:approve:conflict aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb -->"}]'
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false \
	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb "$malformed_then_valid"
chk "(8) a malformed marker is skipped, the well-formed one behind it wins" "$(run)" "20"
chk "     and the kind is decision"                                        "$(kind)" "decision"

# Two *well-formed* markers naming different pairs — the ordering the two
# malformed-marker scenes above never exercise, since only one of their
# entries ever parses. The newest one governs even when an older one also
# parses and even when the older one is the one that matches the current pair.
old_matches_new_doesnt='[{"createdAt":"2020-01-01T00:00:00Z","body":"<!-- conveyor:approve:conflict aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb -->"},
	{"createdAt":"2020-01-02T00:00:00Z","body":"<!-- conveyor:approve:conflict cccccccccccccccccccccccccccccccccccccccc dddddddddddddddddddddddddddddddddddddddd -->"}]'
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false \
	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb "$old_matches_new_doesnt"
chk "(8) an older marker matching the current pair is not enough; the newest one governs" "$(run)" "20"
chk "     never read as the old attempt (a worktree failure trying the new one, not a decision)" "$(kind)" "worktree"

new_matches_old_doesnt='[{"createdAt":"2020-01-01T00:00:00Z","body":"<!-- conveyor:approve:conflict cccccccccccccccccccccccccccccccccccccccc dddddddddddddddddddddddddddddddddddddddd -->"},
	{"createdAt":"2020-01-02T00:00:00Z","body":"<!-- conveyor:approve:conflict aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb -->"}]'
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false \
	aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb "$new_matches_old_doesnt"
chk "(8) the newest marker matching the current pair is enough, whatever an older one says" "$(run)" "20"
chk "     and the kind is decision"                                                         "$(kind)" "decision"

# A different current head OID is a genuinely new conflict: it must not read
# as the same attempt (must not ask decision). It cannot be driven further
# than that here — a fresh attempt needs the worktree and remote gate 8's own
# stubbed git refuses (see the header comment).
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false \
	cccccccccccccccccccccccccccccccccccccccc bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb "$matching"
chk "(9) a different OID pair is a new conflict; it tries again"     "$(run)" "20"
chk "     never read as the old attempt (a worktree failure trying the new one, not a decision)" "$(kind)" "worktree"

# --- 9/10. the check rollup, mapped explicitly and totally ------------------
for state in SUCCESS SKIPPED NEUTRAL; do
	scene; pr 9 OPEN; labels; details false MERGEABLE "$state"
	chk "(9) $state is green"                 "$(run)" "0"
done
scene; pr 9 OPEN; labels; details false MERGEABLE ""
chk "(9) a repo with no CI can still merge"   "$(run)" "0"
for state in FAILURE ERROR TIMED_OUT CANCELLED ACTION_REQUIRED; do
	scene; pr 9 OPEN; labels; details false MERGEABLE "$state"
	chk "(9) $state stops"                    "$(run)" "20"
	chk "     and the kind is checks"         "$(kind)" "checks"
done
for state in PENDING QUEUED IN_PROGRESS EXPECTED; do
	scene; pr 9 OPEN; labels; details false MERGEABLE "$state"
	chk "(10) $state waits"                   "$(run)" "10"
done
scene; pr 9 OPEN; labels; details false MERGEABLE SOMETHING_NEW
chk "(10) an unknown rollup waits, never merges" "$(run)" "10"

# --- 12. a thread the script already answered is a question, not a retry ----
answered='[{"id":"t1","isResolved":false,"comments":{"pageInfo":{"hasNextPage":false},"nodes":[{"id":"c1","body":"please change this","createdAt":"2020-01-01T00:00:00Z"},{"id":"c2","body":"Addressed in abc123.\n\n<!-- conveyor:approve -->","createdAt":"2020-01-01T00:00:00Z"}]}}]'
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$answered"
chk "(12) a thread answered but still open stops" "$(run)" "20"
chk "     and the kind is decision"               "$(kind)" "decision"
chk "     and it is a question, never bulk-cleared" "$(jq -r '.asked // false' "$CONVEYOR_RESULT")" "true"

# --- 13. the quiet clock ----------------------------------------------------
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
date -u +%Y-%m-%dT%H:%M:%SZ >"$tmp/scene/timeline"
chk "(13) a PR that just arrived waits"       "$(QUIET=600 run)" "10"
chk "     and did not merge"                  "$([[ -f "$tmp/scene/merged" ]] && echo merged || echo no)" "no"
# A resting item and a stuck one look identical on a board — both sit still —
# so the wait says what it is waiting for and when it ends, and the card draws
# the countdown. The engine reads neither field.
chk "     and says what it is waiting for"    \
	"$(jq -r '.waiting.why // ""' "$CONVEYOR_RESULT" | grep -c 'stay quiet')" "1"
chk "     and until when"                     \
	"$(jq -r '.waiting.until // ""' "$CONVEYOR_RESULT" | grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T')" "1"

# The one gate a person may open by hand. Everything above it still had to
# pass: merge-now means "stop giving review more room", not "merge whatever
# state it is in".
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
date -u +%Y-%m-%dT%H:%M:%SZ >"$tmp/scene/timeline"
chk "(13) merge-now skips the remaining silence" "$(QUIET=600 CONVEYOR_MANUAL=merge-now run)" "0"
chk "     and it actually merged"             "$([[ -f "$tmp/scene/merged" ]] && echo merged)" "merged"

# And only that gate. A failing check is not a wait, and no button gets past it.
scene; pr 9 OPEN; labels; details false MERGEABLE FAILURE
date -u +%Y-%m-%dT%H:%M:%SZ >"$tmp/scene/timeline"
chk "(13) merge-now does not get past a failed check" "$(QUIET=600 CONVEYOR_MANUAL=merge-now run)" "20"
chk "     and did not merge"                  "$([[ -f "$tmp/scene/merged" ]] && echo merged || echo no)" "no"

# An action the script does not know is simply not its business.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
date -u +%Y-%m-%dT%H:%M:%SZ >"$tmp/scene/timeline"
chk "(13) an unknown action changes nothing"  "$(QUIET=600 CONVEYOR_MANUAL=something-else run)" "10"

# A page it cannot see all of is deferred, never merged past.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
sed -i 's/"hasNextPage":false/"hasNextPage":true/' "$tmp/scene/graphql"
chk "an unreadable page defers rather than merging" "$(run)" "10"

# --- 14. the merge itself ---------------------------------------------------
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
chk "(14) a settled PR merges"                "$(run)" "0"
chk "     and gh pr merge actually ran"       "$([[ -f "$tmp/scene/merged" ]] && echo merged)" "merged"

# A confirmation read that itself fails is not the same as "not merged yet":
# the merge was already issued, and only the read that would say what happened
# to it is what broke. It defers (10) rather than marking, and stderr — the
# one place this is visible, since stdout/stderr are logs and never parsed —
# names both that the merge was already issued and the SHA it was issued at,
# so this is never mistaken for the ordinary "still quiet" case in the log.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS; touch "$tmp/scene/fail_confirm"
: >"$CONVEYOR_RESULT"
echo '{"item":{"ref":"7","title":"an item"}}' |
	SCENE="$tmp/scene" REPO=o/n PROMPT="fix it" CONVEYOR_SOURCE=s1 \
		QUIET_SECONDS="${QUIET:-0}" CONFLICT_RESOLVE="${CONFLICT_RESOLVE:-}" \
		"$here/approve" >/dev/null 2>"$tmp/confirm_stderr"
confirm_rc=$?
chk "a failed confirmation read defers"           "$confirm_rc" "10"
chk "     and it is not marked"                   "$([[ -s "$CONVEYOR_RESULT" ]] && echo written || echo empty)" "empty"
chk "     and stderr names the merge as already issued" \
	"$(grep -c 'already issued' "$tmp/confirm_stderr")" "1"
chk "     naming the head it was issued at" \
	"$(grep -o 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' "$tmp/confirm_stderr" | sort -u | wc -l | tr -d ' ')" "1"

scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS; touch "$tmp/scene/merge_fails"
# A genuine refusal changes nothing: the head gh reports afterwards is the
# same one that was inspected, and the PR is still open. Only then is a
# failed `gh pr merge` actually a fault rather than a moved head.
cat >"$tmp/scene/confirm" <<'JSON'
{"state":"OPEN","headRefOid":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","isInMergeQueue":false,"autoMergeRequest":null}
JSON
chk "a refused merge stops, never reads as merged" "$(run)" "20"
chk "     and the kind is merge"              "$(kind)" "merge"

# --- F06: the merge is bound to the commit that passed the gates -----------
#
# gh pr merge carries --match-head-commit for the exact SHA the second
# check_gates_once just inspected. A push landing in the gap between that
# inspection and the merge call moves the head; this must defer and recheck,
# never merge past it and never mark a fault.
echo "F06: merge bound to the inspected commit"

scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
# The head moved after the inspection, and --match-head-commit refuses it —
# gh reports a failure exactly as it would for any other rejected merge, and
# only the follow-up read tells the two apart.
cat >"$tmp/scene/confirm" <<'JSON'
{"state":"OPEN","headRefOid":"cccccccccccccccccccccccccccccccccccccccc","isInMergeQueue":false,"autoMergeRequest":null}
JSON
touch "$tmp/scene/merge_fails"
chk "(F06) a head that moved between the read and the merge defers" "$(run)" "10"
chk "     never reads as merged"              "$([[ -f "$tmp/scene/merged" ]] && echo merged || echo no)" "no"

# The same moved-head case, but gh happens to report success anyway (a race
# where the mismatch was not caught server-side) — the follow-up read is what
# actually decides this, not gh's exit code.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
cat >"$tmp/scene/confirm" <<'JSON'
{"state":"OPEN","headRefOid":"cccccccccccccccccccccccccccccccccccccccc","isInMergeQueue":false,"autoMergeRequest":null}
JSON
chk "(F06) a moved head defers even when gh reports success" "$(run)" "10"

# Accepted but not yet merged: the repository requires a merge queue, so
# `gh pr merge` enqueues it (or enables auto-merge) and returns 0. This must
# not be reported done, and must not re-issue gh pr merge on the next poll.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
cat >"$tmp/scene/confirm" <<'JSON'
{"state":"OPEN","headRefOid":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","isInMergeQueue":true,"autoMergeRequest":null}
JSON
chk "(F06) an accepted-but-queued merge defers, not done" "$(run)" "10"
chk "     it did call gh pr merge, but never observed it merged" \
	"$([[ -f "$tmp/scene/merge_called" ]] && echo called || echo no)" "called"

# On the next poll, the PR is still queued at the top of the gate — this must
# defer without ever reaching (or re-issuing) gh pr merge again.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS '[]' issue-7 false '' '' '[]' true
touch "$tmp/scene/merge_fails" # if merge were re-issued, it would fail loudly
chk "(F06) a PR already queued at the top of a poll defers without re-merging" "$(run)" "10"
chk "     gh pr merge was never reached"       "$([[ -f "$tmp/scene/merge_called" ]] && echo called || echo no)" "no"

# ...and the same for auto-merge already enabled.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS '[]' issue-7 false '' '' '[]' false '{"enabledAt":"2020-01-01T00:00:00Z"}'
touch "$tmp/scene/merge_fails"
chk "(F06) auto-merge already enabled defers without re-merging" "$(run)" "10"
chk "     gh pr merge was never reached"       "$([[ -f "$tmp/scene/merge_called" ]] && echo called || echo no)" "no"

# --- QUIET_SECONDS parsing --------------------------------------------------
# A fresh clock, so 600 is the thing being tested and not the 2020 commit date.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS
date -u +%Y-%m-%dT%H:%M:%SZ >"$tmp/scene/timeline"
chk "a nonsense QUIET_SECONDS falls back to the default" "$(QUIET=soon run)" "10"
chk "     and 0 is still a valid wait of none"           "$(QUIET=0 run)" "0"

# --- 8f. a merge left resolved but uncommitted is finished, not marked -------
#
# The one place resolve_conflict is driven against real git, because what is
# being asserted is a git state and nothing else: MERGE_HEAD set, no unmerged
# paths, the resolution sitting in the index. That is what a run killed
# mid-verification leaves — the `turns` stop is the usual way — and it used to
# be marked `conflict` forever: the model was already out of the picture, so
# the next poll found the same state and marked it again. midgame #106 sat
# there for four hours over sixteen runs.
#
# Everything below is built from nothing under $tmp with its own bare origin.
src="$tmp/src" origin="$tmp/origin.git" wt="$tmp/worktrees/s1/7"
g() { "$real_git" "$@"; }

g init --quiet --bare -b main "$origin"
g init --quiet -b main "$src"
g -C "$src" config user.email selfcheck@example.invalid
g -C "$src" config user.name selfcheck
g -C "$src" remote add origin "$origin"
printf 'base\n' >"$src/f.txt"
g -C "$src" add f.txt
g -C "$src" commit --quiet -m base
g -C "$src" push --quiet -u origin main
g -C "$src" checkout --quiet -b issue-7
branch_content='the branch'
printf '%s\n' "$branch_content" >"$src/f.txt"
g -C "$src" commit --quiet -am "branch edit"
g -C "$src" push --quiet -u origin issue-7
issue7_base=$(g -C "$src" rev-parse issue-7)
g -C "$src" checkout --quiet main
printf 'the base\n' >"$src/f.txt"
g -C "$src" commit --quiet -am "base edit"
g -C "$src" push --quiet origin main

# half_merged <resolution> — put the item's worktree in the state a killed run
# leaves: mid-merge, every conflict staged, nothing committed.
#
# The branch is wound back to where it was before any scene ran, here and on
# the origin both. A scene that finishes its merge pushes it, and leaving that
# in place would hand the next scene a branch with nothing left to merge —
# which stops on the dirty worktree long before reaching what is being tested,
# and passes or fails for the wrong reason.
half_merged() {
	g -C "$src" worktree remove --force "$wt" >/dev/null 2>&1
	g -C "$src" branch --quiet -f issue-7 "$issue7_base"
	g -C "$src" push --quiet --force origin issue-7
	g -C "$src" worktree add --quiet --force "$wt" issue-7
	# item_worktree only reuses a path it recognizes as its own — the marker it
	# would have written the run that left this mid-merge state. Written by
	# hand here because this fixture builds the worktree straight from `git`,
	# never through item_worktree itself.
	printf 's1\n7\n' >"$(g -C "$wt" rev-parse --absolute-git-dir)/conveyor-owner"
	g -C "$wt" merge --no-edit origin/main >/dev/null 2>&1
	printf '%s\n' "$1" >"$wt/f.txt"
	g -C "$wt" add f.txt
}

# The stubbed git refuses everything unless this is set, so it is passed to the
# run and never exported: every scene above must stay unable to touch a repo.
run_real() {
	local rc
	: >"$CONVEYOR_RESULT"
	rm -f "$tmp/claude-ran"
	echo '{"item":{"ref":"7","title":"an item"}}' |
		(cd "$src" && SCENE="$tmp/scene" REPO=o/n PROMPT="fix it" CONVEYOR_SOURCE=s1 \
			QUIET_SECONDS=0 SELFCHECK_REAL_GIT=1 "$here/approve" >/dev/null 2>&1)
	rc=$?
	echo "$rc"
}
merge_in_progress() { g -C "$wt" rev-parse -q --verify MERGE_HEAD >/dev/null && echo yes || echo no; }

scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false
half_merged "resolved by the run that died"
chk "(8f) a merge with every conflict resolved is finished, not marked" "$(run_real)" "10"
chk "     and no model ran"                   "$([[ -f "$tmp/claude-ran" ]] && echo ran || echo no)" "no"
chk "     and the merge is committed"         "$(merge_in_progress)" "no"
chk "     and the resolution is what landed"  "$(g -C "$wt" show HEAD:f.txt)" "resolved by the run that died"
chk "     and the branch was pushed"          "$(g -C "$origin" rev-parse issue-7)" "$(g -C "$wt" rev-parse HEAD)"
chk "     and the attempt was recorded"       "$([[ -s "$tmp/scene/comments_posted" ]] && echo posted || echo no)" "posted"

# The narrow exception: $branch_content is byte-for-byte what HEAD already
# holds, so this resolution takes the base's side of nothing and the merge
# commit would change not one file. Finishing that silently would push a branch
# whose own work had been thrown away, so it is still a person's.
scene; pr 9 OPEN; labels; details false CONFLICTING SUCCESS '[]' issue-7 false
half_merged "$branch_content"
chk "(8f) a merge that resolves to no change at all still stops" "$(run_real)" "20"
chk "     and the kind is conflict"           "$(kind)" "conflict"
chk "     and no model ran"                   "$([[ -f "$tmp/claude-ran" ]] && echo ran || echo no)" "no"
# The same scene is the only one where `status --porcelain` reads clean with a
# merge in progress, so it is the only one that can prove gate 8a leaves it
# alone. Before try_rebase looked for MERGE_HEAD it reset --hard over exactly
# this, and the resolution was gone with nothing saying so.
chk "(8a) a rebase never resets over a merge in progress" "$(merge_in_progress)" "yes"
chk "     leaving the resolution where it was"            "$(cat "$wt/f.txt")" "$branch_content"

# --- gate 11: a thread is resolved only when the model actually disposed of
# it, never on the strength of "some commit changed" alone -------------------
#
# Real git again, for the same reason as 8f: what is being asserted is which
# threads got a reply-and-resolve mutation, and that is only visible against
# a real commit. claude is restubbed here, last in the file, to actually
# "address" the threads a scene names rather than refuse outright — it makes
# one file edit and writes whatever $CONVEYOR_RESULT a scene asks for, which
# is this harness standing in for the model reporting its own dispositions.
reset_wt_clean() {
	g -C "$src" worktree remove --force "$wt" >/dev/null 2>&1
	g -C "$src" branch --quiet -f issue-7 "$issue7_base"
	g -C "$src" push --quiet --force origin issue-7
	g -C "$src" worktree add --quiet --force "$wt" issue-7
	# item_worktree only reuses a path it recognizes as its own — see
	# half_merged's identical line above for why this fixture writes the
	# marker by hand rather than going through item_worktree itself.
	printf 's1\n7\n' >"$(g -C "$wt" rev-parse --absolute-git-dir)/conveyor-owner"
}
cat >"$tmp/bin/claude" <<STUB
#!/usr/bin/env bash
touch "$tmp/claude-ran"
[[ -f "\$SCENE/claude_edit" ]] && cat "\$SCENE/claude_edit" >>f.txt
[[ -f "\$SCENE/claude_result" ]] && cat "\$SCENE/claude_result" >"\$CONVEYOR_RESULT"
echo "stub claude: addressed threads"
exit 0
STUB
chmod +x "$tmp/bin/claude"

threads='[{"id":"T1","isResolved":false,"comments":{"nodes":[{"body":"please fix X"}]}},
          {"id":"T2","isResolved":false,"comments":{"nodes":[{"body":"please fix Y"}]}}]'
# Each disposed thread costs exactly two graphql calls (reply, then resolve),
# both carrying -F id=<that thread>; an untouched thread never appears at all.
touches_for() { grep -o "id=$1" "$tmp/scene/graphql_calls" 2>/dev/null | wc -l | tr -d ' '; }

# All threads disposed: both are replied to and resolved, and the run defers.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf 'edit for all\n' >"$tmp/scene/claude_edit"
printf '{"dispositions":{"T1":"fixed X","T2":"fixed Y"}}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) all threads disposed defers"        "$(run_real)" "10"
chk "     T1 is replied to and resolved"      "$(touches_for T1)" "2"
chk "     T2 is replied to and resolved"      "$(touches_for T2)" "2"

# A subset disposed: only the reported thread is replied to and resolved; the
# other is left for gate 12 on a later poll.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf 'edit for subset\n' >"$tmp/scene/claude_edit"
printf '{"dispositions":{"T1":"fixed X"}}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) a subset disposed defers"           "$(run_real)" "10"
chk "     T1 is replied to and resolved"      "$(touches_for T1)" "2"
chk "     T2 is left alone"                   "$(touches_for T2)" "0"

# None disposed: a commit still landed (the model touched something) but
# reported no disposition at all — "the commit changed" is no longer enough
# on its own, so nothing is resolved and nothing is replied to.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf 'edit with no disposition\n' >"$tmp/scene/claude_edit"
printf '{}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) none disposed still defers"         "$(run_real)" "10"
chk "     T1 is left alone"                   "$(touches_for T1)" "0"
chk "     T2 is left alone"                   "$(touches_for T2)" "0"

# All threads disposed with no edit at all: the branch already answered them,
# which the prompt invites the model to say. Nothing to push, but the threads
# are still replied to and resolved, and the run defers rather than marking —
# a mark here was permanent, since every resume said the same true thing.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf '{"dispositions":{"T1":"already fixed X","T2":"already fixed Y"}}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) disposed with no change defers"     "$(run_real)" "10"
chk "     T1 is replied to and resolved"      "$(touches_for T1)" "2"
chk "     T2 is replied to and resolved"      "$(touches_for T2)" "2"

# No edit and no disposition is still a run that did nothing.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf '{}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) no change, no disposition marks"    "$(run_real)" "20"
chk "     T1 is left alone"                   "$(touches_for T1)" "0"

# A disposition naming a thread id outside this run's unanswered set is
# ignored, not acted on — it names a thread this run was never asked about.
scene; pr 9 OPEN; labels; details false MERGEABLE SUCCESS "$threads" issue-7
printf 'edit for unknown id\n' >"$tmp/scene/claude_edit"
printf '{"dispositions":{"T1":"fixed X","T99":"fixed something else"}}' >"$tmp/scene/claude_result"
reset_wt_clean
chk "(11) an unknown thread id is ignored"    "$(run_real)" "10"
chk "     T1 is replied to and resolved"      "$(touches_for T1)" "2"
chk "     the unknown id was never sent"      "$(touches_for T99)" "0"

exit $fail
