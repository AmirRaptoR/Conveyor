#!/usr/bin/env bash
# The `approving` stage: wait for a pull request to settle, then merge it.
#
# review's job ends once a PR exists; this is the gate that decides when it is
# safe to land. It is re-run on every poll while the item sits in `approving`
# (CONTRACTS §2 — exit 10 is "leave it, try again next poll"), so it must never
# sleep: a script that blocks holds one of the four global slots for however
# long it waits, and dies with the engine on every restart. A quiet PR is a
# handful of `gh`/GraphQL reads and nothing else — the model runs only when
# there is an unresolved conversation to address (gate 11 below).
#
# Config (source env: + this script's params:):
#   REPO             owner/name — required
#   QUIET_SECONDS    how long the PR must be quiet before it merges (default
#                     600). A non-integer or negative value falls back to the
#                     default and says so on stderr. 0 is valid, so the gate
#                     can be exercised without waiting. A person may skip the
#                     remaining silence with the `merge-now` action, which the
#                     stage has to declare in `actions:` for the board to
#                     offer it.
#   PROMPT           what to tell the model when addressing review threads.
#   CONFLICT_RESOLVE exactly "0" restores the old behaviour of marking every
#                     conflict a plain rebase could not fix; any other value,
#                     including unset (the default), lets gate 8 attempt one
#                     model-run resolution first.
#   CONFLICT_PROMPT  what to tell the model when resolving a merge conflict.
#                     Unset uses a built-in default (see CONFLICT_PROMPT_DEFAULT
#                     below), so no existing source needs to set this.
#   ALLOWED_TOOLS, MODEL, MAX_TURNS, PERMISSION_MODE — passed to run_claude.
#
# The gate, in precedence order (numbers referenced throughout in comments and
# in the issue that specified this script):
#
#   1. a gh/GraphQL call failed              -> exit 10  (try again next poll)
#   2. no PR closes the issue                -> exit 20  (input)
#   3. two or more PRs close it              -> exit 20  (input)
#   4. PR merged already                     -> exit 0   (drop worktree, move on)
#   5. PR closed unmerged                    -> exit 20  (decision)
#   6. hold on the PR (or the issue)         -> exit 20  (human-review)
#   7. PR is a draft                         -> exit 10
#   8. mergeable is CONFLICTING, in sub-order:
#        a. try_rebase                       -> exit 10 if it applied
#        b. CONFLICT_RESOLVE == "0"          -> exit 20  (conflict)
#        c. PR is cross-repository, or its head is not this item's own
#           issue-<ref> branch               -> exit 20  (conflict)
#        d. headRefOid/baseRefOid unknown    -> exit 10  (defer)
#        e. the newest well-formed marker already names this exact
#           head/base pair                   -> exit 20  (decision)
#        f. otherwise: resolve (merge, model if it conflicts, verify, test,
#           push, mark)                      -> exit 10 or exit 20 (conflict,
#                                                worktree, limit, turns, error)
#           A merge already in progress with every conflict resolved is
#           finished here with no model run: an earlier attempt did the work
#           and died before committing it.
#   9. a check failed                        -> exit 20  (checks)
#  10. a check is still running              -> exit 10
#  11. an unresolved thread it has not answered -> address, test, push, reply,
#      resolve -> exit 10
#  12. an unresolved thread it already answered -> exit 20  (decision)
#  13. now - base < QUIET_SECONDS            -> exit 10, with a countdown for
#      the board (agents/_blocked:waits) — unless a person pressed the
#      `merge-now` action, which skips this gate and only this one: every rule
#      above it still had to pass, so "merge now" means "stop giving review
#      more room", never "merge whatever state it is in"
#  14. otherwise -> refetch 4-12, then merge, bound to the exact commit that
#      just passed every gate above:
#        a. the PR is already queued to merge or already has auto-merge
#           enabled (a queue/auto-merge this same script requested on an
#           earlier poll, or one set by hand) -> exit 10, gh pr merge is not
#           re-issued
#        b. gh pr merge --match-head-commit <the second read's headRefOid>,
#           then the PR is read once more, never trusted from gh's own exit
#           code alone:
#             - now MERGED                    -> exit 0 (drop worktree)
#             - head has moved since the SHA just merged -> exit 10 (a moved
#               head is new activity, not a fault; this covers both a
#               --match-head-commit rejection and a push that landed in the
#               gap regardless of what gh reported)
#             - now queued or auto-merge-enabled -> exit 10, waiting for
#               GitHub to actually finish it
#             - gh reported failure and none of the above explains it -> exit
#               20 (merge)
#             - gh reported success but the PR is in none of the above states
#               -> exit 10 (defer to the next poll rather than assume)
#
# Merge gates, all required: no hold, not a draft, no conflict, checks green,
# no unresolved review threads, quiet for QUIET_SECONDS. Any activity resets
# the clock (see `base`, below), so the total wait is unbounded by design:
# while review is still happening, the clock should keep giving it room.
set -euo pipefail

source "$(dirname "$0")/_stream"
source "$(dirname "$0")/../_blocked"
source "$(dirname "$0")/../_worktree"
source "$(dirname "$0")/../_pr"

: "${REPO:?REPO is required (set it in the source env: block)}"
: "${PROMPT:?PROMPT is required (set it in this script params: block)}"

LABEL_PREFIX="${LABEL_PREFIX:-conveyor:}"
BLOCKED_LABEL="${BLOCKED_LABEL:-${LABEL_PREFIX}blocked}"
APPROVING_LABEL="${LABEL_PREFIX}approving"
owner="${REPO%%/*}"
name="${REPO##*/}"

# The reply that marks a thread as already addressed. Fixed and invisible on
# GitHub, durable in the API — the whole of "did the script already answer
# this?" lives in whether the newest comment in the thread carries it, which
# needs no store of its own (see the issue's technical note 5).
SENTINEL='<!-- conveyor:approve -->'

raw_quiet="${QUIET_SECONDS:-600}"
if [[ "$raw_quiet" =~ ^[0-9]+$ ]]; then
	QUIET="$raw_quiet"
else
	echo "QUIET_SECONDS='$raw_quiet' is not a non-negative integer; using the default 600" >&2
	QUIET=600
fi

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")
echo "approving $CONVEYOR_SOURCE #$ref — $title" >&2

# gh_json <args...> — run a `gh` call that must return JSON. Any failure —
# network, auth, malformed output — is gate 1: exit 10, not 1 and not 20. A
# blip must not mark the item; the next poll retries, and the failure is named
# on stderr so a person watching the log can tell it apart from a real stop.
gh_json() {
	local out
	if ! out=$(gh "$@" 2>&1); then
		echo "gh $* failed: $out" >&2
		exit 10
	fi
	if ! jq -e . >/dev/null 2>&1 <<<"$out"; then
		echo "gh $* returned something that is not JSON: $out" >&2
		exit 10
	fi
	printf '%s' "$out"
}

# gh_do <args...> — run a `gh` call for its side effect. Same failure handling
# as gh_json, minus the JSON check.
gh_do() {
	local out
	if ! out=$(gh "$@" 2>&1); then
		echo "gh $* failed: $out" >&2
		exit 10
	fi
	printf '%s' "$out"
}

# wearing <label> <label-list-json> — exact match, as list.sh's own hold check
# does. A bare "$BLOCKED_LABEL: <kind>" label is a different label and is not
# a hold.
wearing() { jq -e --arg l "$1" 'any(.[]; . == $l)' >/dev/null 2>&1 <<<"$2"; }

# The PR is found by closing reference, never by `gh pr list --search`, which
# matches substrings anywhere in the PR and silently takes the first hit.
# --state all so a PR that has already merged, or one abandoned in an earlier
# round of rework, is still visible to the checks below. The matching rule
# itself — pr_match_filter, from agents/_pr — is the one every caller of
# closing_prs shares too, so this script and _pr can never disagree about
# what counts as "closes #ref".
discover_pr() {
	local all matches active n_all n_match n_active
	all=$(gh_json pr list --repo "$REPO" --state all --limit 100 \
		--json number,body,state,headRefName,url)
	matches=$(pr_match_filter "$ref" <<<"$all")

	n_all=$(jq 'length' <<<"$all")
	n_match=$(jq 'length' <<<"$matches")
	# gh's own page cap: a full page with no match in it might be hiding one
	# behind, the same as agents/_pr's closing_prs — unavailable, not none,
	# because reporting "no PR" here would mark the item for a person to
	# reconcile work that may well already have a PR.
	if [[ "$n_all" -ge 100 && "$n_match" -eq 0 ]]; then
		echo "gh pr list for #$ref returned a full page with no match; it may be truncated" >&2
		exit 10
	fi
	if [[ "$n_match" -eq 0 ]]; then
		blocked input "no pull request closes issue #$ref, so there is nothing to approve."
	fi

	# A closed-and-abandoned PR from an earlier round does not count as an
	# active candidate — only the one currently open, or already merged, does.
	active=$(jq '[.[] | select(.state != "CLOSED")]' <<<"$matches")
	n_active=$(jq 'length' <<<"$active")

	if [[ "$n_active" -ge 2 ]]; then
		local nums
		nums=$(jq -r '[.[].number] | map("#\(.)") | join(" and ")' <<<"$active")
		blocked input "more than one open pull request closes issue #$ref ($nums); resolve which one before this can proceed. It does not pick one."
	fi

	if [[ "$n_active" -eq 1 ]]; then
		pr=$(jq -r '.[0].number' <<<"$active")
		pr_state=$(jq -r '.[0].state' <<<"$active")
	else
		# Every match is CLOSED. Only one is expected here in practice; if more
		# than one is closed-unmerged the newest is reported, which is enough
		# to point a person at the right history without picking a winner.
		pr=$(jq -r '.[0].number' <<<"$matches")
		pr_state="CLOSED"
	fi
}

# check_hold — a hold is `$BLOCKED_LABEL` worn on either object, fetched fresh
# (never taken from the stdin payload, which is stale by up to a poll — see
# providers/github/move.sh:27). Read off both because labels do not propagate
# between an issue and its PR; taking it off the PR is what lets `move` write
# it back onto the issue as the one place the mark lives (see the issue's
# technical note 1).
check_hold() {
	local issue_labels pr_labels
	issue_labels=$(gh_json issue view "$ref" --repo "$REPO" --json labels --jq '[.labels[].name]')
	pr_labels=$(gh_json issue view "$pr" --repo "$REPO" --json labels --jq '[.labels[].name]')

	if wearing "$BLOCKED_LABEL" "$pr_labels"; then
		gh_do pr edit "$pr" --repo "$REPO" --remove-label "$BLOCKED_LABEL" >/dev/null
		blocked human-review "a $BLOCKED_LABEL label on pull request #$pr is holding this for a human. Remove it to resume."
	fi
	if wearing "$BLOCKED_LABEL" "$issue_labels"; then
		blocked human-review "a $BLOCKED_LABEL label on issue #$ref is holding this for a human. Remove it to resume."
	fi
}

# fetch_details — everything the rest of the gate needs about the PR, in one
# GraphQL call: draft state, mergeability, the aggregated check rollup (which
# is already the single normalised enum this gate cares about — GitHub does
# the per-check reconciliation, not this script), and every timestamp `base`
# is computed from. reviewThreads and its per-thread comments each request
# 100, the most `gh` will fetch in one page; a PR carrying more than that in
# either dimension is vanishingly rare, and this is the safe failure mode for
# it — deferring rather than silently working from a page that left something
# out.
fetch_details() {
	details=$(gh_json api graphql -f query='
		query($owner:String!, $name:String!, $number:Int!) {
			repository(owner:$owner, name:$name) {
				pullRequest(number:$number) {
					isDraft
					mergeable
					isCrossRepository
					isInMergeQueue
					autoMergeRequest { enabledAt }
					headRefName
					headRefOid
					baseRefName
					baseRefOid
					commits(last:1) {
						nodes { commit { committedDate statusCheckRollup { state } } }
					}
					comments(last:100) { nodes { createdAt body } }
					reviews(last:100) { nodes { submittedAt } }
					reviewThreads(first:100) {
						pageInfo { hasNextPage }
						nodes {
							id
							isResolved
							comments(first:100) {
								pageInfo { hasNextPage }
								nodes { id body createdAt }
							}
						}
					}
				}
			}
		}' -F owner="$owner" -F name="$name" -F number="$pr" --jq '.data.repository.pullRequest')

	if [[ "$(jq -r '.reviewThreads.pageInfo.hasNextPage' <<<"$details")" == "true" ]] ||
		jq -e '[.reviewThreads.nodes[].comments.pageInfo.hasNextPage] | any' >/dev/null 2>&1 <<<"$details"; then
		echo "PR #$pr has more review threads or comments than fit in one page; deferring rather than working from an incomplete view" >&2
		exit 10
	fi
}

# base — the newest of the timestamps GitHub already keeps: the labelled
# event that put this item in `approving`, the head commit, the newest
# issue-style comment, the newest review, and the newest comment in any
# review thread (which is what covers a thread being resolved — the reply
# that resolves it is a comment in it). Stateless and restart-proof: the
# script is re-run from scratch every poll, so nothing here can live in a
# variable between runs.
compute_base() {
	local labelled_at commit_at comment_at review_at thread_at candidates
	# gh_do, not gh_json: `--jq` reduces this to a bare timestamp or to nothing
	# at all, and neither is JSON. Through gh_json the check would reject its
	# own successful answer, defer, and the gate would never merge anything.
	labelled_at=$(gh_do api "repos/$REPO/issues/$ref/timeline" --paginate \
		--jq "[.[] | select(.event==\"labeled\" and .label.name==\"$APPROVING_LABEL\") | .created_at] | max // empty")
	commit_at=$(jq -r '.commits.nodes[0].commit.committedDate // empty' <<<"$details")
	comment_at=$(jq -r '[.comments.nodes[].createdAt] | max // empty' <<<"$details")
	review_at=$(jq -r '[.reviews.nodes[].submittedAt] | max // empty' <<<"$details")
	thread_at=$(jq -r '[.reviewThreads.nodes[].comments.nodes[].createdAt] | max // empty' <<<"$details")

	base=0
	for candidates in "$labelled_at" "$commit_at" "$comment_at" "$review_at" "$thread_at"; do
		[[ -z "$candidates" ]] && continue
		local epoch
		epoch=$(date -u -d "$candidates" +%s 2>/dev/null) || continue
		((epoch > base)) && base=$epoch
	done

	local now
	now=$(date -u +%s)
	# Clock skew, clamped rather than trusted: a `base` in the future would
	# otherwise delay the merge indefinitely.
	#
	# Written as an `if` and not `((base > now)) && base=$now`: that form
	# returns 1 when the condition is false, and as the last statement of a
	# function under `set -e` it ends the run — on the ordinary path, where the
	# clock is fine.
	if ((base > now)); then
		base=$now
	fi
}

# check_status <rollup-state> — an explicit, total mapping from the
# StatusCheckRollupState GraphQL already reduces every check to. An empty
# rollup (no field at all — a repository with no CI) is green: it must still
# be able to merge.
check_status() {
	case "$1" in
	SUCCESS | SKIPPED | NEUTRAL | "" | null) return 0 ;;                   # green
	FAILURE | ERROR | TIMED_OUT | CANCELLED | ACTION_REQUIRED) return 2 ;; # failed
	PENDING | QUEUED | IN_PROGRESS | EXPECTED) return 1 ;;                 # waiting
	*)
		echo "unrecognised status check rollup state '$1'; treating it as not yet green" >&2
		return 1
		;;
	esac
}

# run_tests — best effort. No source declares a test command today, so this
# infers one from what the worktree looks like; a repository with none is not
# an error, it just leans on gate 9/10 (CI) instead.
run_tests() {
	local wt=$1
	if [[ -f "$wt/go.mod" ]]; then
		(cd "$wt" && go test ./...)
	elif [[ -f "$wt/package.json" ]]; then
		(cd "$wt" && npm test --silent)
	elif [[ -f "$wt/Makefile" ]] && grep -qE '^test:' "$wt/Makefile" 2>/dev/null; then
		(cd "$wt" && make test)
	else
		echo "no test command could be inferred for this worktree; relying on CI (gate 9/10)" >&2
	fi
}

# address_threads <unanswered-threads-json> — one model invocation for every
# unresolved thread the script has not already replied to, never one per
# thread. Runs in the item's own worktree, on the PR's branch. Exits 10 on
# success; it never merges in the run that pushed a fix.
#
# A changed commit is not proof every thread was addressed — only a
# disposition the model itself reported, per thread id, in $CONVEYOR_RESULT
# is. A thread it does not report on is left unresolved and unreplied here;
# gate 12 picks it up as a question once the model has already had a poll to
# answer it. Only threads named in this run's own unanswered set count — a
# disposition for any other id is not something this run was asked about and
# is ignored rather than acted on.
address_threads() {
	local threads=$1 head_ref before after thread_text full rc tid
	head_ref=$(jq -r '.headRefName' <<<"$details")

	local wt
	wt=$(item_worktree "$CONVEYOR_SOURCE" "$ref" "$head_ref") ||
		blocked worktree "could not prepare a worktree for #$ref on branch $head_ref."
	cd "$wt"
	before=$(git rev-parse HEAD)
	echo "  worktree: $wt (branch $(git branch --show-current))" >&2

	thread_text=$(jq -r '.[] |
		"--- unresolved conversation (thread id: " + .id + ") ---\n" +
		([.comments.nodes[] | "> " + .body] | join("\n\n")) + "\n"' <<<"$threads")

	full="${PROMPT}

--- the item, as the pipeline sees it ---
Item #${ref} in ${REPO}: ${title}
Pull request #${pr}
--- end item ---

Address every one of the unresolved conversations below on pull request #${pr}.
For each, make the necessary change, or explain in your own commit message why
none is needed. Commit and push your changes to the branch you are already on
(${head_ref}) — do not open a new pull request, and do not change branch.

For every thread you actually addressed, report a one-sentence disposition in
\$CONVEYOR_RESULT under a \"dispositions\" object keyed by that thread's id,
e.g. {\"dispositions\": {\"<thread id>\": \"renamed the variable and added a
test\"}}. Only the thread ids listed below are yours to report on; a thread
you do not report a disposition for is left open for a person to look at,
even if you touched code near it.

${thread_text}"

	full=$(resume_prompt "$payload" "$full")

	set +e
	MAX_TURNS="${MAX_TURNS:-40}" \
		ALLOWED_TOOLS="${ALLOWED_TOOLS:-Bash,Read,Edit,Write,Glob,Grep}" \
		run_claude "$full"
	rc=$?
	set -e
	record_model

	if hit_limit; then
		blocked limit "the agent was out of quota and stopped before addressing the review threads on #$pr. Nothing is wrong with this item; it is waiting for the window to reset."
	fi
	# See agents/claude/review for the reasoning: a turn budget is a condition,
	# not a fault, and the fix already resolved in this conversation before the
	# wall (a thread half-addressed, a test half-written) is worth resuming
	# into rather than losing to a cold restart.
	if hit_max_turns; then
		record_session
		blocked turns "the agent hit its ${MAX_TURNS:-40}-turn budget while \
addressing the review threads on #$pr, before pushing a fix. Answering this \
mark with anything (e.g. \"continue\") resumes the same conversation with a \
fresh turn budget; clearing the label alone starts over from the current \
state of the branch, redoing whatever investigation already happened."
	fi
	if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
		[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
		agent_asked
		echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
		exit 20
	fi
	if [[ $rc -ne 0 ]]; then
		blocked error "the agent exited $rc while addressing the review threads on #$pr. Last it said: $(last_said)"
	fi

	if [[ -n "$(git status --porcelain)" ]]; then
		git add -A
		git commit --quiet -m "Address review feedback on #$pr"
	fi
	after=$(git rev-parse HEAD)
	if [[ "$after" == "$before" ]]; then
		blocked no-output "the agent finished but made no change to address the review threads on #$pr."
	fi

	# The dispositions the model actually reported, restricted to the thread
	# ids this run named — a disposition is a non-empty string, and any id
	# outside the unanswered set this run asked about is dropped here rather
	# than resolving something never asked. "the commit changed" alone is not
	# in this set at all, so it can no longer resolve anything by itself.
	local dispositions known_ids disposed
	known_ids=$(jq -c '[.[].id]' <<<"$threads")
	if [[ -s "${CONVEYOR_RESULT:-}" ]]; then
		dispositions=$(jq -c '.dispositions // {}' "$CONVEYOR_RESULT" 2>/dev/null) || dispositions='{}'
	else
		dispositions='{}'
	fi
	disposed=$(jq -c --argjson known "$known_ids" '
		[to_entries[] | select((.value | type) == "string" and (.value | length) > 0)
			| select(.key as $k | $known | index($k) != null)]' <<<"$dispositions")

	run_tests "$wt"

	if ! git push origin "HEAD:$head_ref" 2>&1; then
		blocked error "pushing the fix for #$pr to $head_ref was rejected."
	fi

	# Reply to, and resolve, only the threads just disposed — never the ones
	# this run did not report on, which gate 12 owns once they have had a poll
	# to be answered.
	while IFS=$'\t' read -r tid disposition; do
		[[ -z "$tid" ]] && continue
		gh_do api graphql -f query='
			mutation($id:ID!, $body:String!) {
				addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $id, body: $body}) {
					comment { id }
				}
			}' -F id="$tid" -F body="${disposition}

$SENTINEL" >/dev/null
		gh_do api graphql -f query='
			mutation($id:ID!) {
				resolveReviewThread(input: {threadId: $id}) { thread { id } }
			}' -F id="$tid" >/dev/null
	done < <(jq -r '.[] | [.key, .value] | @tsv' <<<"$disposed")

	echo "pushed a fix for #$pr and resolved $(jq 'length' <<<"$disposed") of $(jq 'length' <<<"$threads") thread(s)" >&2
	exit 10
}

# try_rebase — one mechanical rebase of the PR branch onto its base, in the
# item's own worktree. Returns non-zero, with the tree left as it was found,
# when there is no worktree, the tree is dirty, a merge or rebase is already in
# progress, or the rebase stops.
try_rebase() {
	local head_ref base_ref wt gd
	head_ref=$(jq -r '.headRefName' <<<"$details")
	base_ref=$(jq -r '.baseRefName // empty' <<<"$details")
	wt="$(worktree_root)/${CONVEYOR_SOURCE}/${ref}"
	[[ -n "$base_ref" && -d "$wt" ]] || return 1
	gd=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) || return 1

	# An operation already in progress belongs to gate 8f, and the dirty check
	# below does not see it: a merge whose resolution is staged to exactly what
	# HEAD already holds leaves `status --porcelain` empty. Falling through to
	# the `reset --hard` two lines down would throw that resolution away —
	# somebody's finished conflict work, discarded to attempt a rebase that the
	# same conflict is about to stop anyway.
	if [[ -e "$gd/MERGE_HEAD" || -d "$gd/rebase-merge" || -d "$gd/rebase-apply" ]]; then
		echo "worktree $wt has a merge or rebase in progress; not rebasing" >&2
		return 1
	fi
	[[ -z "$(git -C "$wt" status --porcelain)" ]] || { echo "worktree $wt is dirty; not rebasing" >&2; return 1; }
	[[ "$(git -C "$wt" branch --show-current)" == "$head_ref" ]] || return 1
	git -C "$wt" fetch --quiet origin "$base_ref" "$head_ref" || return 1
	git -C "$wt" reset --quiet --hard "origin/$head_ref" || return 1
	if ! git -C "$wt" rebase --quiet "origin/$base_ref" >&2; then
		git -C "$wt" rebase --abort 2>/dev/null || true
		return 1
	fi
	git -C "$wt" push --quiet --force-with-lease origin "HEAD:$head_ref" >&2
}

# CONFLICT_PROMPT_DEFAULT — used when the source's `params:` sets no
# CONFLICT_PROMPT of its own, so upgrading this script requires no edit to any
# existing `~/codes/conveyor.yaml`.
CONFLICT_PROMPT_DEFAULT=$(cat <<'BRIEF'
This pull request has a merge conflict with its base branch that a plain
rebase could not resolve. Resolve each conflicted file so both sides' intent
survives wherever the two changes do not actually collide — read the
surrounding code and both commits before choosing, rather than picking one
side blind.

Edit the conflicted files in the working tree and nothing else: do not run
`git commit`, `git push`, `git merge --abort`, or change branch. The script
does all of that itself once the files are clean.

If the two sides genuinely contradict each other, rather than merely both
touching the same area, stop with a decision instead of picking a winner.
BRIEF
)

# marker_pair — the "<headOid> <baseOid>" recorded by the newest well-formed
# `<!-- conveyor:approve:conflict <headOid> <baseOid> -->` marker among the
# PR's comments, or empty if none parses. Comments are returned oldest-first,
# so the last match found, in order, is the newest one — and a marker that
# does not parse into two 40-character hex OIDs is simply never a match, so it
# is skipped rather than mistaken for one (criterion 8).
marker_pair() {
	jq -r '
		[.comments.nodes[].body // ""]
		| map([scan("<!-- conveyor:approve:conflict ([0-9a-fA-F]{40}) ([0-9a-fA-F]{40}) -->")])
		| flatten(1)
		| last
		| if . == null then empty else .[0] + " " + .[1] end
	' <<<"$details"
}

# post_conflict_marker <head-oid> <base-oid> — record a resolved-and-pushed
# attempt so gate 8 never spends a second model run on the same conflict
# (criteria 6, 7). Never routed through gh_do: a failure here is criterion 10's
# case, exit 20 and never 10, because an unmarked successful attempt is
# exactly the state that would re-run the model on the next poll.
post_conflict_marker() {
	local head_oid=$1 base_oid=$2 out
	if ! out=$(gh pr comment "$pr" --repo "$REPO" \
		--body "<!-- conveyor:approve:conflict $head_oid $base_oid -->" 2>&1); then
		blocked conflict "resolved #$pr's merge conflict and pushed it, but recording the attempt failed ($out); the branch has moved even though this did not merge."
	fi
}

# non_fast_forward <push-output> — a rejected push's own text, not just one
# phrase of it: git says "(non-fast-forward)" for a diverged branch but
# "(fetch first)" for one that is merely behind, and both are the same case
# for criterion 24 (the branch moved since this worktree was reset to it).
# Verified against this host's own git (2.53.0), which emits both.
non_fast_forward() { grep -qiE 'non-fast-forward|fetch first|stale info' <<<"$1"; }

# resolve_conflict — gate 8's model-run attempt. Reached only after try_rebase
# has failed, CONFLICT_RESOLVE has not disabled it, the PR is not
# cross-repository, its head is this pipeline's own issue-<ref> branch, and
# this exact conflict (by head/base OID) has not already been attempted.
# Exits 10 on a push it managed to record, or 20 naming what stopped it. Never
# returns.
resolve_conflict() {
	local head_ref base_ref wt git_dir merging=0 resolved=0 base_oid conflicted=()
	head_ref=$(jq -r '.headRefName' <<<"$details")
	base_ref=$(jq -r '.baseRefName' <<<"$details")

	wt=$(item_worktree "$CONVEYOR_SOURCE" "$ref" "$head_ref") ||
		blocked worktree "could not prepare a worktree for #$ref on branch $head_ref to resolve its merge conflict."
	cd "$wt"
	git_dir=$(git rev-parse --git-dir)

	if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
		# This script's own interrupted resolution, on this item's own branch,
		# by construction — the same reasoning agents/_resume is built on
		# (criterion 14). Continue into it rather than refusing.
		merging=1
		base_oid=$(git rev-parse MERGE_HEAD)
		echo "resuming a conflict resolution already in progress in $wt" >&2
	elif [[ -n "$(git status --porcelain)" ]]; then
		blocked worktree "the worktree for #$ref at $wt has uncommitted changes and no merge in progress; not touching it to resolve a conflict."
	fi

	if [[ "$merging" -eq 0 ]]; then
		# A worktree item_worktree hands back can be an existing checkout that
		# was never refreshed (agents/_worktree:80-90); fetch and reset before
		# merging so resolution never starts from a stale commit (criterion 15).
		git fetch --quiet origin "$head_ref" "$base_ref" 2>&1 ||
			blocked worktree "fetching origin/$head_ref and origin/$base_ref for #$ref failed."
		git show-ref --verify --quiet "refs/remotes/origin/$head_ref" ||
			blocked worktree "origin/$head_ref does not exist for #$ref."
		git show-ref --verify --quiet "refs/remotes/origin/$base_ref" ||
			blocked worktree "origin/$base_ref does not exist for #$ref."
		git reset --quiet --hard "origin/$head_ref" ||
			blocked worktree "resetting the worktree for #$ref to origin/$head_ref failed."
		base_oid=$(git rev-parse "origin/$base_ref")

		if git merge --quiet --no-edit "origin/$base_ref" >&2; then
			# Merged cleanly: criterion 16, no model run at all. Captured exactly
			# as the model-resolved path below captures it (criterion 23) — under
			# this script's `set -e`, an unguarded run_tests would instead kill
			# the whole run on a failing suite with its raw exit status and no
			# result written at all.
			local clean_test_rc=0
			set +e
			run_tests "$wt"
			clean_test_rc=$?
			set -e
			if [[ "$clean_test_rc" -ne 0 ]]; then
				blocked conflict "the test suite failed after merging $base_ref into #$pr's branch cleanly; nothing was pushed."
			fi

			local clean_push_out clean_push_rc=0
			set +e
			clean_push_out=$(git push origin "HEAD:$head_ref" 2>&1)
			clean_push_rc=$?
			set -e
			if [[ "$clean_push_rc" -ne 0 ]]; then
				if non_fast_forward "$clean_push_out"; then
					blocked conflict "pushing the merge that resolved #$pr's conflict with $base_ref was rejected as non-fast-forward."
				fi
				echo "pushing the merge that resolved #$pr's conflict with $base_ref failed: $clean_push_out" >&2
				exit 10
			fi
			post_conflict_marker "$(git rev-parse HEAD)" "$base_oid"
			echo "merged $base_ref into $head_ref cleanly for #$pr; no model run" >&2
			exit 10
		fi
		mapfile -t conflicted < <(git diff --name-only --diff-filter=U)
	else
		mapfile -t conflicted < <(git diff --name-only --diff-filter=U)
	fi

	if [[ "${#conflicted[@]}" -eq 0 ]]; then
		# A merge this script started, with every conflict already resolved and
		# nothing left to commit it. Only the resume path can reach it: an
		# earlier run resolved the files and died before committing — the
		# `turns` stop below is how, since the verification a resolution ends
		# with is the longest stretch in the run and the likeliest place to be
		# cut. That state is one commit away from done, not a fault, but
		# marking it made it permanent: the model was out of the picture, so
		# nothing changed, so the next poll found the same state and marked it
		# again. midgame #106 sat here for four hours over sixteen runs.
		[[ "$merging" -eq 1 ]] ||
			blocked conflict "the merge into #$pr's branch $head_ref reports no conflicted files but is not resolved; needs a hand."
		resolved=1

		# What to verify and stage, now that the unmerged set is empty by
		# definition. `git diff HEAD` is everything the pending merge commit
		# would change, staged and unstaged alike — wider than the conflicted
		# set the model path uses, and deliberately so: a marker left in a file
		# the dead run had already staged is still caught, and an edit it made
		# but never staged still lands. Both are this item's own work on this
		# item's own branch, the same reasoning the resume above rests on.
		mapfile -t conflicted < <(git diff --name-only HEAD)
		[[ "${#conflicted[@]}" -gt 0 ]] ||
			blocked conflict "the merge in progress on #$pr's branch $head_ref has no conflicts left and changes nothing; needs a hand."
		echo "the merge in $wt has no conflicts left; finishing it without a model run" >&2
	fi

	# Skipped entirely when the resume above found the work already done. There
	# is nothing left to ask the model, and asking anyway would spend a run to
	# be told so — the same waste the mark this replaces used to spend a poll on.
	if [[ "$resolved" -eq 0 ]]; then
		local full rc
		full="${CONFLICT_PROMPT:-$CONFLICT_PROMPT_DEFAULT}

--- the item, as the pipeline sees it ---
Item #${ref} in ${REPO}: ${title}
Pull request #${pr}, branch ${head_ref}, merging in ${base_ref}
--- end item ---

The conflicted files are:
$(printf '%s\n' "${conflicted[@]}")

$(decision_brief)"

		full=$(resume_prompt "$payload" "$full")

		set +e
		MAX_TURNS="${MAX_TURNS:-40}" \
			ALLOWED_TOOLS="${ALLOWED_TOOLS:-Bash,Read,Edit,Write,Glob,Grep}" \
			run_claude "$full"
		rc=$?
		set -e
		record_model

		if hit_limit; then
			blocked limit "the agent was out of quota and stopped before resolving the merge conflict on #$pr. Nothing is wrong with this item; it is waiting for the window to reset."
		fi
		# Left in progress, not aborted: the merge itself is real work, and the
		# next run of this script resumes into it exactly as agents/_resume
		# resumes a dirty worktree (criterion 20).
		if hit_max_turns; then
			record_session
			blocked turns "the agent hit its ${MAX_TURNS:-40}-turn budget while \
resolving the merge conflict on #$pr, before finishing. The merge is left in \
progress; answering this mark with anything (e.g. \"continue\") resumes the \
same conversation with a fresh turn budget, and the next run of this script \
continues the same merge rather than starting over."
		fi
		if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
			[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
			# The agent's own stop. Abort here, unlike the turns case above: a
			# question can sit for days, and the tree it half-merged is not
			# evidence anyone needs while waiting for an answer.
			git merge --abort 2>/dev/null || true
			agent_asked
			echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
			exit 20
		fi
		if [[ $rc -ne 0 ]]; then
			blocked error "the agent exited $rc while resolving the merge conflict on #$pr. Last it said: $(last_said)"
		fi
	fi

	# Verify the tree itself before trusting it (criterion 19): the model can
	# claim success without actually having removed every conflict marker.
	# Checked on the working tree first, before staging — git add on a file
	# that still reads "both modified" always clears its unmerged index
	# entries regardless of what is in it, so a leftover marker line only
	# ls-files --unmerged would ever miss it.
	local f bad=()
	for f in "${conflicted[@]}"; do
		[[ -f "$f" ]] || continue
		grep -qE '^(<<<<<<< |=======$|>>>>>>> )' "$f" && bad+=("$f")
	done
	if [[ "${#bad[@]}" -gt 0 ]]; then
		blocked conflict "the agent finished but left conflict markers in: ${bad[*]}"
	fi

	git add -- "${conflicted[@]}"

	# The staging above resolves every path this run knew to be conflicted;
	# anything still unmerged afterwards is a path outside that set — the
	# model touched a file that was not part of the original conflict, or
	# introduced one of its own — and is worth a person's eyes before landing.
	local unmerged
	unmerged=$(git ls-files --unmerged)
	if [[ -n "$unmerged" ]]; then
		local paths
		paths=$(awk '{print $4}' <<<"$unmerged" | sort -u | tr '\n' ' ')
		blocked conflict "the agent finished but #$pr's merge still has unresolved paths: $paths"
	fi

	local commit_out
	if ! commit_out=$(git commit --quiet -m "Merge origin/$base_ref into $head_ref to resolve conflicts for #$ref" 2>&1); then
		blocked conflict "committing the resolved conflict for #$pr failed: $commit_out"
	fi

	local test_rc=0
	set +e
	run_tests "$wt"
	test_rc=$?
	set -e
	if [[ "$test_rc" -ne 0 ]]; then
		blocked conflict "the test suite failed after resolving #$pr's merge conflict; nothing was pushed."
	fi

	local push_out push_rc=0
	set +e
	push_out=$(git push origin "HEAD:$head_ref" 2>&1)
	push_rc=$?
	set -e
	if [[ "$push_rc" -ne 0 ]]; then
		if non_fast_forward "$push_out"; then
			blocked conflict "pushing the resolved conflict for #$pr to $head_ref was rejected as non-fast-forward."
		fi
		echo "pushing the resolved conflict for #$pr failed: $push_out" >&2
		exit 10
	fi

	post_conflict_marker "$(git rev-parse HEAD)" "$base_oid"
	echo "resolved and pushed a fix for #$pr's merge conflict" >&2
	exit 10
}

# check_gates_once — gates 2 through 13. Exits directly (10 or 20) for any
# outcome that is not "ready to merge right now"; returns normally only when
# every gate has just passed. Called twice by the caller so gate 14's "refetch
# 4-12 immediately before merging" is not a separate code path — it is this
# same function, run again, closing the race between the quiet check and the
# merge itself.
check_gates_once() {
	discover_pr

	case "$pr_state" in
	MERGED)
		echo "PR #$pr is already merged" >&2
		drop_worktree "$CONVEYOR_SOURCE" "$ref"
		exit 0
		;;
	CLOSED)
		blocked decision "pull request #$pr, which closes issue #$ref, was closed without merging."
		;;
	esac

	check_hold
	fetch_details

	if [[ "$(jq -r '.isDraft' <<<"$details")" == "true" ]]; then
		waits "pull request #$pr is a draft; waiting for it to be marked ready"
	fi

	# Gate 14a, reachable from any poll: a PR this same script enqueued (or one
	# a person put in a queue or enabled auto-merge on by hand) is already
	# accepted, and re-issuing `gh pr merge` here would either error on an
	# already-queued PR or be redundant on one with auto-merge enabled. GitHub
	# finishes it in its own time; this script only waits.
	if [[ "$(jq -r '.isInMergeQueue' <<<"$details")" == "true" ]]; then
		echo "PR #$pr is already queued to merge; waiting for GitHub to finish it" >&2
		exit 10
	fi
	if jq -e '.autoMergeRequest != null' >/dev/null 2>&1 <<<"$details"; then
		echo "PR #$pr already has auto-merge enabled; waiting for GitHub to finish it" >&2
		exit 10
	fi

	local mergeable
	mergeable=$(jq -r '.mergeable' <<<"$details")
	if [[ "$mergeable" == "CONFLICTING" ]]; then
		# A conflict is work before it is a decision. Most are a base that moved
		# under a branch review already left behind, and a rebase applies
		# cleanly; only one that does not is worth a person. Tried on the
		# worktree review left (never built here: a conflict on a PR nobody
		# here opened is not this script's to rewrite), pushed with a lease so
		# a branch someone touched meanwhile is refused rather than overwritten.
		if try_rebase; then
			echo "rebased #$pr onto $(jq -r .baseRefName <<<"$details"); waiting for GitHub to recompute" >&2
			exit 10
		fi

		# The off switch: exactly "0" restores today's behaviour of marking
		# every conflict a plain rebase could not fix. Anything else, including
		# unset, lets the model try once.
		if [[ "${CONFLICT_RESOLVE:-}" == "0" ]]; then
			blocked conflict "pull request #$pr has a merge conflict with its base branch that a plain rebase did not resolve; CONFLICT_RESOLVE=0 disables automatic resolution, so it needs a hand."
		fi

		# Only a branch this pipeline owns. A fork's PR can carry the
		# issue-<ref> name too, so cross-repository is checked as well: without
		# it, `git push origin HEAD:<headRefName>` would write to a same-named
		# branch in the base repository that has nothing to do with this PR.
		if [[ "$(jq -r '.isCrossRepository' <<<"$details")" == "true" ]]; then
			blocked conflict "pull request #$pr has a merge conflict, but it is from a fork; its branch is not this pipeline's to rewrite."
		fi
		local conflict_head_ref
		conflict_head_ref=$(jq -r '.headRefName' <<<"$details")
		if [[ "$conflict_head_ref" != "issue-$ref" ]]; then
			blocked conflict "pull request #$pr has a merge conflict, but its branch $conflict_head_ref is not this item's own issue-$ref branch; it is not this pipeline's to rewrite."
		fi

		# An incomplete view defers rather than acts, the same stance the
		# review-thread paging guard takes above.
		local head_oid base_oid
		head_oid=$(jq -r '.headRefOid // empty' <<<"$details")
		base_oid=$(jq -r '.baseRefOid // empty' <<<"$details")
		if [[ -z "$head_oid" || -z "$base_oid" ]]; then
			echo "PR #$pr's head or base commit is not yet known; deferring" >&2
			exit 10
		fi

		# Bounded without state: if the newest well-formed marker already names
		# this exact head/base pair, an attempt already ran against precisely
		# this conflict and it is still reported conflicting — a person is
		# needed, and running the model again would just repeat it.
		local marker
		marker=$(marker_pair)
		if [[ -n "$marker" && "$marker" == "$head_oid $base_oid" ]]; then
			asks decision "an earlier attempt already tried to resolve pull request #$pr's merge conflict at this same head and base commit, and it is still reported conflicting; it needs a hand."
		fi

		resolve_conflict # exits 10 or 20; never returns
	fi
	if [[ "$mergeable" != "MERGEABLE" ]]; then
		echo "PR #$pr's mergeability is not yet known ($mergeable); waiting" >&2
		exit 10
	fi

	local rollup status_rc
	rollup=$(jq -r '.commits.nodes[0].commit.statusCheckRollup.state // empty' <<<"$details")
	set +e
	check_status "$rollup"
	status_rc=$?
	set -e
	case $status_rc in
	2) blocked checks "a status check on pull request #$pr failed (rollup: $rollup)." ;;
	1)
		echo "checks on PR #$pr are still running (rollup: $rollup)" >&2
		exit 10
		;;
	esac

	local unresolved unanswered answered
	unresolved=$(jq '[.reviewThreads.nodes[] | select(.isResolved == false)]' <<<"$details")
	unanswered=$(jq --arg s "$SENTINEL" \
		'[.[] | select((.comments.nodes[-1].body // "") | contains($s) | not)]' <<<"$unresolved")
	answered=$(jq --arg s "$SENTINEL" \
		'[.[] | select((.comments.nodes[-1].body // "") | contains($s))]' <<<"$unresolved")

	if [[ "$(jq 'length' <<<"$unanswered")" -gt 0 ]]; then
		address_threads "$unanswered" # exits 10 or 20; never returns
	fi
	if [[ "$(jq 'length' <<<"$answered")" -gt 0 ]]; then
		local quoted
		quoted=$(jq -r '.[0].comments.nodes[0].body' <<<"$answered")
		asks decision "a reviewer left this unresolved after the fix that addressed it: \"$quoted\""
	fi

	compute_base
	local now elapsed
	now=$(date -u +%s)
	elapsed=$((now - base))
	if ((elapsed < QUIET)); then
		# The one gate a person may open by hand. It is a *wait*, not a check:
		# every rule above this one still had to pass, so "merge now" means
		# "stop giving review more room", never "merge whatever state it is
		# in". Skipping a green, unconflicted, unreviewed-thread-free PR's
		# remaining silence is a judgement a person is entitled to make.
		if manual_action merge-now; then
			echo "PR #$pr has been quiet for only ${elapsed}s of ${QUIET}s, but merge-now was pressed" >&2
		else
			waits "waiting for pull request #$pr to stay quiet for ${QUIET}s; any activity restarts the clock" \
				"$((base + QUIET))"
		fi
	else
		echo "PR #$pr has been quiet for ${elapsed}s (>= ${QUIET}s required)" >&2
	fi
}

check_gates_once
echo "re-checking immediately before merging, to close the window since the check above" >&2
check_gates_once

# The exact commit the second check_gates_once just finished inspecting —
# not an earlier read, and not re-fetched after: everything between here and
# the merge call must be about this one SHA.
head_oid=$(jq -r '.headRefOid' <<<"$details")
if [[ -z "$head_oid" || "$head_oid" == "null" ]]; then
	echo "PR #$pr's head commit is unexpectedly unknown right before merging; deferring" >&2
	exit 10
fi

echo "merging PR #$pr at $head_oid" >&2
merge_rc=0
merge_out=$(gh pr merge "$pr" --repo "$REPO" --squash --delete-branch \
	--match-head-commit "$head_oid" 2>&1) || merge_rc=$?

# Never trusted from gh's exit code alone: `gh pr merge` returns 0 both for an
# actual merge and for enqueuing (auto-merge enabled, or added to a required
# merge queue — see `gh pr merge --help`), and a --match-head-commit
# precondition failure is, from the exit code alone, indistinguishable from
# any other rejected merge. One more read settles all of it — over GraphQL,
# not `pr view --json`: isInMergeQueue exists only there (fetch_details above
# already asks for it that way). A REST `--json` list is where this exact read
# used to ask for it instead, which `gh` rejects outright, so the branch below
# — the entire point of the read — was never reached.
#
# Not gh_json: a failure here must not read as "not merged yet" — the merge
# was already issued, at $head_oid, and that is what the message says while
# still deferring rather than marking, since gh's own exit code already
# proved nothing about whether the merge landed.
after_raw=$(gh api graphql -f query='
	query($owner:String!, $name:String!, $number:Int!) {
		repository(owner:$owner, name:$name) {
			pullRequest(number:$number) {
				state
				headRefOid
				isInMergeQueue
				autoMergeRequest { enabledAt }
			}
		}
	}' -F owner="$owner" -F name="$name" -F number="$pr" \
	--jq '.data.repository.pullRequest' 2>&1) || {
	echo "confirming the merge of PR #$pr (already issued at $head_oid) failed: $after_raw" >&2
	exit 10
}
if ! jq -e . >/dev/null 2>&1 <<<"$after_raw"; then
	echo "confirming the merge of PR #$pr (already issued at $head_oid) returned something that is not JSON: $after_raw" >&2
	exit 10
fi
after="$after_raw"
after_state=$(jq -r '.state' <<<"$after")
after_head=$(jq -r '.headRefOid' <<<"$after")

if [[ "$after_state" == "MERGED" ]]; then
	drop_worktree "$CONVEYOR_SOURCE" "$ref"
	exit 0
fi

if [[ "$after_head" != "$head_oid" ]]; then
	# The branch moved between the inspected read and this merge attempt — a
	# --match-head-commit rejection reads this way, and so does any other push
	# that landed in the gap regardless of what gh reported. New activity, not
	# a fault: the quiet clock restarts on it next poll.
	echo "PR #$pr's head moved from $head_oid to $after_head; deferring to recheck" >&2
	exit 10
fi

if [[ "$(jq -r '.isInMergeQueue' <<<"$after")" == "true" ]] ||
	jq -e '.autoMergeRequest != null' >/dev/null 2>&1 <<<"$after"; then
	echo "PR #$pr is queued to merge (or has auto-merge enabled); waiting for GitHub to finish it" >&2
	exit 10
fi

if [[ "$merge_rc" -ne 0 ]]; then
	blocked merge "gh pr merge #$pr failed: $merge_out"
fi

# gh reported success, the head has not moved, and the PR is neither merged
# nor queued: an unexpected state. Deferring costs one more poll; treating it
# as done without confirming it is the bug this gate exists to close.
echo "gh pr merge #$pr reported success but the PR is not yet observed merged; deferring" >&2
exit 10
