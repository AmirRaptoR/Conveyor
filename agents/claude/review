#!/usr/bin/env bash
# Review an item's pull request with Claude Code, headless, and merge it if the
# review comes back clean.
#
# The skill it invokes owns the loop — ask Codex, judge findings, fix, re-review,
# up to three rounds, then merge when everything is green. So this stage runs
# once and its verdict is final: success means merged, failure means the review
# did not converge and a person is needed.
#
# Config (source env: + this script's params:):
#   PROMPT           what to do. Required. Usually the slash command "/review $REF".
#   ALLOWED_TOOLS    --allowedTools. Needs write tools: a review that finds a
#                    real bug fixes it, and merging is a gh call.
#   MODEL            --model (default: whatever the CLI is configured with)
#   MAX_TURNS, PERMISSION_MODE
#   REPO             owner/name, for the pull-request check below
set -euo pipefail

# Streams the agent's work as it happens; without it a long stage looks dead.
source "$(dirname "$0")/_stream"
source "$(dirname "$0")/../_blocked"
source "$(dirname "$0")/../_worktree"
source "$(dirname "$0")/../_resume"
source "$(dirname "$0")/../_deadline"

: "${PROMPT:?PROMPT is required (set it in this script params: block)}"

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")

# Nothing to review means the previous stage did not deliver, whatever it
# reported. Checked here rather than trusted from the skill, because the skill
# stopping politely would otherwise read as success and advance the item.
if [[ -n "${REPO:-}" ]]; then
	pr=$(gh pr list --repo "$REPO" --state open --search "$ref" --json number --jq '.[0].number' 2>/dev/null)
	if [[ -z "$pr" ]]; then
		blocked input "no open pull request references #$ref, so there is nothing to \
review. Either the implement stage did not land its work, or the PR was closed \
by hand."
	fi
	echo "reviewing PR #$pr for $CONVEYOR_SOURCE #$ref — $title"
	# The item's own worktree, on the pull request's branch. Review applies
	# fixes and merges, both of which are writes: doing them in the repository a
	# person works in is how a review lands on top of somebody's evening.
	head=$(gh pr view "$pr" --repo "$REPO" --json headRefName --jq .headRefName 2>/dev/null || true)
	wt=$(item_worktree "$CONVEYOR_SOURCE" "$ref" "$head")
	cd "$wt"
	echo "  worktree: $wt  (branch $(git branch --show-current))"

	# A review that ran out of time leaves its half-landed fixes here, and the
	# next one used to walk straight past them: it cd'd in, saw a branch, and
	# reviewed as though the tree were clean. implement has read its own
	# leftovers since worktrees went per item; there is no reason review should
	# not, and one good one why it must — the uncommitted work is the previous
	# review's, so nobody else is ever going to come and claim it.
	#
	# Called directly, never in a substitution: it stops through `blocked`, and
	# a subshell would swallow that exit.
	resume_leftovers "$ref"
	leftovers="$RESUME_BRIEF"
else
	echo "reviewing $CONVEYOR_SOURCE #$ref — $title"
fi

# A slash command must lead the message; the item context follows it. $REF is
# the one substitution made, because a command needs the issue number.
task=${PROMPT//\$REF/$ref}

if [[ "$task" == /* ]]; then
	full="${task}

--- the item, as the pipeline sees it ---
Item #${ref}${REPO:+ in $REPO}: ${title}${pr:+
Pull request #${pr}}
--- end item ---"
else
	full="Item #${ref}${REPO:+ in $REPO}: ${title}${pr:+
Pull request #${pr}}

${task}"
fi

full="${full}${leftovers:-}

If the review cannot reach a verdict because it needs a decision only a human
can make, change nothing and write {\"blocked\": true, \"reason\": \"<the
decision needed>\"} to the file at ${CONVEYOR_RESULT}."

# How long it has, and what to do if that is not enough. Last, because it is the
# instruction that governs all the others.
full="${full}
$(deadline_brief)"

if [[ -n "${wt:-}" ]]; then
	full="${full}

You are in a git worktree of your own at ${wt}, already on the branch of the
pull request under review. Work here, and do NOT change branch: other checkouts
of this repository are live right now and main is checked out elsewhere."
fi

# A person may have answered the question this stage stopped on last time.
full=$(resume_prompt "$payload" "$full")

set +e
MAX_TURNS="${MAX_TURNS:-200}" \
	ALLOWED_TOOLS="${ALLOWED_TOOLS:-Bash,Read,Edit,Write,Glob,Grep,Agent,Skill}" \
	run_claude "$full"
rc=$?
set -e

# What ran, said once in the log. Here rather than beside each exit, because a
# run stopped by a usage limit is exactly the one the measurement is about.
record_model

# Out of quota is not a fault of the item, and must not read like one: without
# this the run ends having done nothing and the next check reports whatever it
# failed to find, which is how "no open PR references #49" came to mean "the
# account was rate limited".
if hit_limit; then
	blocked limit "the agent was out of quota and stopped before doing the work. \
Nothing is wrong with this item; it is waiting for the window to reset."
fi

# A turn budget is a number in conveyor.yaml, not a fact about this item. The
# work up to the wall is real — commits pushed, comments posted, review rounds
# already run — so this resumes rather than restarts: record_session before
# blocked means the conversation, not just the reason, rides on the mark.
# Answering with anything ("continue") hands it back into the same session
# with a fresh turn budget, picking up from exactly where it stopped instead
# of re-doing the investigation.
if hit_max_turns; then
	record_session
	blocked turns "the agent hit its ${MAX_TURNS:-200}-turn budget before \
finishing. This is not a fault of the item — the work done up to the wall \
(pushed commits, posted comments, review rounds already run) is real. \
Answering this mark with anything (e.g. \"continue\") resumes the same \
conversation with a fresh turn budget instead of starting over; clearing the \
label alone starts a new conversation from scratch."
fi

if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
	[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
	agent_asked
	echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
	exit 20 # the agent wrote its own reason; leave it exactly as written
fi

# GitHub is the record, never the transcript. The postcondition is that a pull
# request exists — not that it has been merged.
#
# This used to invert: a still-open PR after a clean run meant "the review did
# not converge" and exited 1. Merging has moved to the `approving` stage, which
# is where the deterministic part of it belongs — checks green, no hold, nothing
# unresolved, quiet for a while — so an open PR is now the expected outcome and
# the reason this stage succeeded. Left as it was, every review would fail and
# mark its item.
#
# An already-merged PR is success too: someone merged it by hand, or an earlier
# `approving` run did, and `approving` will see it merged and pass the item
# through. What is still not success is no pull request at all, which the
# preflight above already refuses.
#
# The worktree is deliberately left behind. `approving` needs the branch — it
# may have to address a review thread on it — and drops the worktree itself once
# the merge is confirmed. Dropping it here would mean rebuilding it on the next
# poll.
if [[ $rc -eq 0 && -n "${REPO:-}" ]]; then
	landed=$(gh pr list --repo "$REPO" --state all --search "$ref" --json number,state \
		--jq '[.[] | select(.state != "CLOSED")][0] | "\(.number) \(.state)"' 2>/dev/null)
	if [[ -z "$landed" || "$landed" == "null null" ]]; then
		blocked no-output "the review finished but no open or merged pull request \
references #$ref any more. A run cut short by a usage limit looks exactly like this."
	fi
	echo "PR #${landed% *} is ${landed#* }; handing it to the approving stage"
fi
exit $rc
