#!/usr/bin/env bash
# Refine an item with Claude Code, headless.
#
# Shipped here the way providers/ are: a reusable adapter, not something the
# engine knows about. Conveyor only ever runs conveyor.d/<source>/refine — that
# file decides to come here, and could just as well point at agents/codex/.
#
# Everything that varies is configuration, read from the environment the engine
# assembled out of the source's env: block:
#
#   PROMPT           what to do. Required. Either plain instructions, with the
#                    item prepended for you, or a slash command such as
#                    "/refine $REF", which leads the message as commands must.
#   ALLOWED_TOOLS    --allowedTools (default: read-only plus gh via Bash)
#   MODEL            --model (default: whatever the CLI is configured with)
#   MAX_TURNS        --max-turns (default 40)
#   PERMISSION_MODE  --permission-mode (default acceptEdits)
#
# And from the engine: CONVEYOR_ITEM_REF, CONVEYOR_SOURCE, CONVEYOR_STAGE,
# CONVEYOR_RESULT, plus the whole item as JSON on stdin.
set -euo pipefail

# Streams the agent's work as it happens; without it a long stage looks dead.
source "$(dirname "$0")/_stream"
source "$(dirname "$0")/../_blocked"

: "${PROMPT:?PROMPT is required (set it in the source env: block)}"

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")
body=$(jq -r '.item.description // ""' <<<"$payload")
url=$(jq -r '.item.url // ""' <<<"$payload")

echo "refining $CONVEYOR_SOURCE #$ref — $title"

# A prompt beginning with "/" is a slash command and must lead the message, so
# the item context follows it instead of preceding it. $REF is expanded either
# way — it is the one substitution this adapter makes, because a command needs
# the issue number as its argument.
task=${PROMPT//\$REF/$ref}

if [[ "$task" == /* ]]; then
	full="${task}

--- the item, as the pipeline sees it ---
Item #${ref}${REPO:+ in $REPO}: ${title}
${url}
${body}
--- end item ---"
else
	full="Item #${ref}${REPO:+ in $REPO}: ${title}
${url}

--- item body ---
${body}
--- end item body ---

${task}"
fi

full="${full}

If this cannot be done because it needs a decision only a human can make, change
nothing and write {\"blocked\": true, \"reason\": \"<the decision needed>\"} to
the file at ${CONVEYOR_RESULT}."

# A person may have answered the question this stage stopped on last time.
full=$(resume_prompt "$payload" "$full")

set +e
MAX_TURNS="${MAX_TURNS:-40}" \
	ALLOWED_TOOLS="${ALLOWED_TOOLS:-Bash,Read,Glob,Grep}" \
	run_claude "$full"
rc=$?
set -e

# What ran, said once in the log. Here rather than beside each exit, because a
# run stopped by a usage limit is exactly the one the measurement is about.
record_model

# Out of quota is not a fault of the item, and must not read like one: without
# this the run ends having done nothing and the next check reports whatever it
# failed to find, which is how "no open PR references #49" came to mean "the
# account was rate limited".
if hit_limit; then
	blocked limit "the agent was out of quota and stopped before doing the work. \
Nothing is wrong with this item; it is waiting for the window to reset."
fi

# See agents/claude/review for the reasoning.
if hit_max_turns; then
	record_session
	blocked turns "the agent hit its ${MAX_TURNS:-40}-turn budget before \
finishing the refinement. Answering this mark with anything (e.g. \"continue\") \
resumes the same conversation with a fresh turn budget instead of starting over."
fi

# "Needs a human" cannot ride on the exit code: a CLI agent exits 0 whenever the
# process ran, whatever it concluded. It comes back through the result file.
if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
	[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
	agent_asked
	echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
	exit 20
fi

exit $rc
