#!/usr/bin/env bash
# Checks the claude adapter's own logic — the parts that are not the model:
# how an answer becomes a prompt, and how the conversation that asked a question
# is found again. Run it after editing _stream; it never invokes claude.
#
#   agents/claude/selfcheck
#
# Same idea as providers/github/selfcheck.sh: a script with branches in it needs
# one runnable thing that fails when a branch breaks.
set -euo pipefail
source "$(dirname "$0")/_stream"
fail=0
chk() { if [[ "$2" == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fail=1; fi; }

# 1. no answer: the prompt is untouched, and nothing is resumed.
RESUME_SESSION=""
out=$(resume_prompt '{"item":{"ref":"1"}}' "do the work")
chk "no answer leaves the prompt alone" "$out" "do the work"
chk "no answer resumes nothing" "${RESUME_SESSION:-}" ""

# 2. answer + session: the answer is the whole message, said into that session.
RESUME_SESSION=""
out=$(resume_prompt '{"answer":"no, keep compat","session":"sess-abc"}' "do the work" 2>/dev/null)
chk "answer with a session is sent alone" "$out" "no, keep compat"
# subshell above cannot export; re-run in this shell to see the variable
resume_prompt '{"answer":"no, keep compat","session":"sess-abc"}' "do the work" >/dev/null 2>&1
chk "the session is picked up" "${RESUME_SESSION:-}" "sess-abc"

# 3. answer without a session: it leads the original prompt instead.
RESUME_SESSION=""
out=$(resume_prompt '{"answer":"no, keep compat"}' "do the work")
case "$out" in
  "The question you stopped on has been answered: no, keep compat"*"do the work") echo "ok   answer without a session leads the original prompt";;
  *) echo "FAIL answer without a session: got [$out]"; fail=1;;
esac

# 4. the session id is read out of the raw stream, first one wins.
printf '%s\n' '{"type":"system","session_id":"sess-xyz"}' '{"type":"assistant"}' '{"type":"result","session_id":"sess-xyz"}' > "$CLAUDE_RAW"
chk "the session id is read from the stream" "$(claude_session)" "sess-xyz"

# 5. agent_asked merges into what the agent wrote, without disturbing it.
export CONVEYOR_RESULT=$(mktemp)
echo '{"blocked":true,"kind":"decision","reason":"may I change the schema?"}' > "$CONVEYOR_RESULT"
agent_asked
chk "the reason survives the merge" "$(jq -r .reason "$CONVEYOR_RESULT")" "may I change the schema?"
chk "the session is added beside it"  "$(jq -r .session "$CONVEYOR_RESULT")" "sess-xyz"
chk "the model's own stop is a question" "$(jq -r .asked "$CONVEYOR_RESULT")" "true"

# 6. no stream, no session: nothing is invented and nothing breaks.
: > "$CLAUDE_RAW"
echo '{"blocked":true,"reason":"x"}' > "$CONVEYOR_RESULT"
agent_asked
chk "no session leaves the file alone" "$(jq -r '.session // "none"' "$CONVEYOR_RESULT")" "none"
chk "and it is still a question"       "$(jq -r .asked "$CONVEYOR_RESULT")" "true"

# 6b. agent_asked classifies from the kind the model wrote (#68), rather than
# forcing every model-written stop into a question. A condition kind stays a
# condition — the bug this issue fixes — and still gets a session, since
# `turns` and `unfinished` are the resumable kinds.
printf '%s\n' '{"type":"system","session_id":"sess-cond"}' '{"type":"result","session_id":"sess-cond"}' > "$CLAUDE_RAW"
for k in limit turns unfinished dependency worktree; do
	echo "{\"blocked\":true,\"kind\":\"$k\",\"reason\":\"r\"}" > "$CONVEYOR_RESULT"
	agent_asked
	chk "a model-written kind $k stays a condition" "$(jq -r .asked "$CONVEYOR_RESULT")" "false"
	chk "and still gets a session"                  "$(jq -r .session "$CONVEYOR_RESULT")" "sess-cond"
	chk "its reason is untouched"                   "$(jq -r .reason "$CONVEYOR_RESULT")" "r"
done

# with no session in the stream, no session field is invented — same as on a
# question kind — and the classification is still applied.
: > "$CLAUDE_RAW"
echo '{"blocked":true,"kind":"unfinished","reason":"r"}' > "$CONVEYOR_RESULT"
agent_asked
chk "no session on a condition invents nothing" "$(jq -r '.session // "none"' "$CONVEYOR_RESULT")" "none"
chk "and it is still a condition"               "$(jq -r .asked "$CONVEYOR_RESULT")" "false"

# 6c. a flag already in the file is overwritten from the kind, never kept —
# this is the exact contradiction #68 reported: `{"kind":"unfinished",
# "asked":true}`.
echo '{"blocked":true,"kind":"unfinished","asked":true,"reason":"r"}' > "$CONVEYOR_RESULT"
agent_asked
chk "an existing asked:true is overwritten from the kind" "$(jq -r .asked "$CONVEYOR_RESULT")" "false"

# 6d. an unknown word, or a kind that is not a string, cannot match the
# condition list and so classifies as a question.
echo '{"blocked":true,"kind":"flabbergasted"}' > "$CONVEYOR_RESULT"
agent_asked
chk "an unrecognised kind is a question" "$(jq -r .asked "$CONVEYOR_RESULT")" "true"
echo '{"blocked":true,"kind":null,"reason":"x"}' > "$CONVEYOR_RESULT"
agent_asked
chk "kind:null defaults to decision"     "$(jq -r .kind "$CONVEYOR_RESULT")" "decision"
chk "and is a question"                  "$(jq -r .asked "$CONVEYOR_RESULT")" "true"

# 6e. questions in the shape the board can walk are unambiguous evidence of a
# question, whatever the kind — a condition kind with real questions is still
# `asked: true`. Anything that is not a non-empty array of objects is not,
# and the kind's own classification stands.
echo '{"kind":"unfinished","questions":[{"header":"x","question":"y","options":[{"label":"a","description":"b"}]}]}' > "$CONVEYOR_RESULT"
agent_asked
chk "real questions make a condition kind a question" "$(jq -r .asked "$CONVEYOR_RESULT")" "true"
chk "and the questions survive untouched" \
	"$(jq -c .questions "$CONVEYOR_RESULT")" '[{"header":"x","question":"y","options":[{"label":"a","description":"b"}]}]'
for qs in '[]' 'null' '"soon?"' '{"a":1}'; do
	echo "{\"kind\":\"unfinished\",\"questions\":$qs}" > "$CONVEYOR_RESULT"
	agent_asked
	chk "questions:$qs is not a question, kind still decides" "$(jq -r .asked "$CONVEYOR_RESULT")" "false"
done

# 6f. three no-op states, each tested separately: unset, a path that does not
# exist, and a path that exists and is empty. agent_asked creates no file and
# writes nothing in any of them, and still returns 0.
unset CONVEYOR_RESULT
rc=0; agent_asked || rc=$?
chk "CONVEYOR_RESULT unset is a no-op" "$rc" "0"
export CONVEYOR_RESULT=$(mktemp -u)
rc=0; agent_asked || rc=$?
chk "a path that does not exist is a no-op"     "$rc" "0"
chk "and creates nothing"                       "$([[ -e "$CONVEYOR_RESULT" ]] && echo present || echo absent)" "absent"
export CONVEYOR_RESULT=$(mktemp)
: > "$CONVEYOR_RESULT"
rc=0; agent_asked || rc=$?
chk "an empty existing file is a no-op" "$rc" "0"
chk "and stays empty"                   "$(cat "$CONVEYOR_RESULT")" ""

# 6g. text jq cannot parse, or valid JSON that is not an object, is left
# byte-identical and agent_asked still returns 0 — the existing behaviour
# when the merge filter fails.
printf 'not json at all' > "$CONVEYOR_RESULT"
before=$(cat "$CONVEYOR_RESULT")
rc=0; agent_asked || rc=$?
chk "unparseable text is untouched" "$(cat "$CONVEYOR_RESULT")" "$before"
chk "and still returns 0"           "$rc" "0"
echo '[1,2,3]' > "$CONVEYOR_RESULT"
before=$(cat "$CONVEYOR_RESULT")
rc=0; agent_asked || rc=$?
chk "a JSON array (not an object) is untouched" "$(cat "$CONVEYOR_RESULT")" "$before"
chk "and still returns 0"                       "$rc" "0"

# 7. the model that actually ran is read out of the raw stream, first one wins,
#    and recorded as one line. Not an echo of $MODEL: with MODEL unset the CLI
#    picks, and that is the case worth writing down.
printf '%s\n' \
	'{"type":"system","subtype":"init","model":"claude-sonnet-5[1m]"}' \
	'{"type":"assistant"}' \
	'{"type":"system","subtype":"init","model":"claude-haiku-4-5"}' > "$CLAUDE_RAW"
MODEL="claude-opus-5"  # what was asked for; the stream says what actually ran
chk "the model is read from the stream" "$(claude_model)" "claude-sonnet-5[1m]"
chk "and recorded on one line"          "$(record_model)" "model: claude-sonnet-5[1m]"

# 8. no events — STREAM=0, or a run that died before the first one. Nothing is
#    printed rather than an empty model: line, and the exit status is untouched,
#    because the adapter's own status is the run's verdict.
: > "$CLAUDE_RAW"
chk "no stream, no model"      "$(claude_model)" ""
chk "no stream prints no line" "$(record_model)" ""
#    The shape the adapters use, exactly: bare, under set -e, with the run's
#    own status already sitting in rc. Not `record_model || rc=$?` — an AND-OR
#    list exempts the call from errexit, and bash carries that exemption into a
#    command substitution as well, so a check written either of those ways
#    cannot see the one thing that could go wrong. Hence set +e around a
#    subshell that turns errexit back on. The status is non-zero for the same
#    reason: a 0 survives being thrown away, so it proves nothing either.
set +e
got=$(set -e; rc=3; record_model; echo "$rc")
set -e
chk "recording never changes the exit status" "$got" "3"

# 9. nor does a write that fails. stdout is a pipe to the engine and writing to
#    it can fail — the reader gone, the disk full — and that echo is the last
#    command of an && list, so errexit takes its status and leaves before
#    `return 0`. A run that did the work would be recorded as a failure because
#    the line describing it could not be written. /dev/full is the only handy
#    way to make a write fail on demand.
if [[ -c /dev/full ]]; then
	printf '%s\n' '{"type":"system","subtype":"init","model":"claude-sonnet-5"}' > "$CLAUDE_RAW"
	set +e
	# 2>/dev/null: the failing write is the point, so the shell's complaint
	# about it is expected output, not a problem to show someone reading this.
	got=$(set -e; rc=3; record_model >/dev/full 2>/dev/null; echo "$rc")
	set -e
	chk "a write that fails is not the verdict either" "$got" "3"
else
	echo "skip a write that fails is not the verdict either: no /dev/full"
fi

# 10. render_stream on a clean result: unchanged, just the blank line — no
#     noise added to the common case.
out=$(printf '%s\n' '{"type":"result","is_error":false,"subtype":"success","num_turns":6,"result":"done"}' | render_stream)
chk "a clean result stays a blank line" "$out" ""

# 11. render_stream on --max-turns being hit: this is the gap that sent people
#     hunting through run history for what "exit 1" meant. error_max_turns
#     carries no `result` text at all — the fix must not assume one.
out=$(printf '%s\n' '{"type":"result","is_error":true,"subtype":"error_max_turns","num_turns":40}' | render_stream)
chk "a max-turns stop is named in the log" "$out" $'\n[claude stopped: error_max_turns after 40 turn(s)]'

# 12. render_stream on any other error subtype, with a result message: printed
#     too, since it is the one hint of what actually went wrong.
out=$(printf '%s\n' '{"type":"result","is_error":true,"subtype":"error_during_execution","result":"API overloaded"}' | render_stream)
chk "an error with a message shows both" "$out" $'\n[claude stopped: error_during_execution] API overloaded'

# 13. hit_max_turns reads what render_stream just wrote to $CLAUDE_SAID — a
#     clean finish is not a turns stop, and neither is a quota refusal.
printf '%s\n' '{"type":"result","is_error":true,"subtype":"error_max_turns","num_turns":40}' | render_stream >"$CLAUDE_SAID"
chk "a max-turns result is recognised" "$(hit_max_turns && echo yes)" "yes"
printf '%s\n' '{"type":"result","is_error":false,"subtype":"success"}' | render_stream >"$CLAUDE_SAID"
chk "a clean finish is not a turns stop" "$(hit_max_turns && echo yes)" ""
echo "Claude hit your usage limit" >"$CLAUDE_SAID"
chk "a quota refusal is not a turns stop either" "$(hit_max_turns && echo yes)" ""

# 14. record_session merges into an empty/missing $CONVEYOR_RESULT — the case
#     agent_asked deliberately does not handle, because a turns stop has
#     nothing else written yet.
printf '%s\n' '{"type":"system","subtype":"init","model":"claude-sonnet-5"}' \
	'{"type":"result","session_id":"sess-turns"}' >"$CLAUDE_RAW"
export CONVEYOR_RESULT=$(mktemp)
rm -f "$CONVEYOR_RESULT" # simulate: nothing written yet
record_session
chk "a session is recorded into a file that didn't exist" "$(jq -r .session "$CONVEYOR_RESULT")" "sess-turns"

# 15. and it merges rather than clobbers when blocked runs after it — the
# shape agents/claude/review and approve actually use.
source "$(dirname "$0")/../_blocked"
(blocked turns "hit the wall" >/dev/null 2>&1) || true
chk "session survives blocked writing after it" "$(jq -r .session "$CONVEYOR_RESULT")" "sess-turns"
chk "and blocked's own fields are there too"    "$(jq -r .kind "$CONVEYOR_RESULT")" "turns"

# 16. no session in the stream: nothing is invented, same as claude_session.
: > "$CLAUDE_RAW"
: > "$CONVEYOR_RESULT"
record_session
chk "no session, nothing written" "$(cat "$CONVEYOR_RESULT")" ""

# 17. a LONG stream — the case every check above was too small to reach.
#
# claude_session pipes jq into `head -1`, and every event carries a session_id,
# so on a real run jq is still writing thousands of lines when head takes its
# one and leaves. jq dies of SIGPIPE, `pipefail` makes the pipeline 141, and an
# unguarded `sess=$(claude_session)` hands that status to `set -e`, which kills
# the adapter where it stands.
#
# That is not a hypothetical: it is where every `error_max_turns` run went. The
# turns branch is `record_session` and then `blocked turns`, so the adapter died
# on the first line and the item was never marked — it was recorded as a plain
# failure with exit 141, losing the session that makes a turn-wall stop
# resumable. Fifteen review runs, ten implement, five approve and two refine.
#
# The size is the whole point of this case. Two events cannot reproduce it, and
# case 14 above has exactly two.
python3 -c "
import json
with open('$CLAUDE_RAW','w') as f:
    f.write(json.dumps({'type':'system','subtype':'init','model':'claude-sonnet-5','session_id':'sess-long'})+'\n')
    for i in range(20000):
        f.write(json.dumps({'type':'assistant','session_id':'sess-long','n':i})+'\n')
"
chk "a long stream still yields the session" "$(claude_session)" "sess-long"
chk "a long stream still yields the model"   "$(claude_model)" "claude-sonnet-5"

# The status, not the value, is what killed the adapters — and it is the whole
# contract these two carry: both document "nothing is a normal answer", so
# neither has any business returning non-zero for any input at all. Asserted on
# the helpers directly rather than through record_session, because errexit
# inside a command substitution does not reliably reproduce what it does at the
# top level of a script, which is where the adapters call it.
chk "reading a long stream is not a failure" "$(claude_session >/dev/null; echo $?)" "0"
chk "nor is reading the model"               "$(claude_model >/dev/null; echo $?)" "0"

: > "$CONVEYOR_RESULT"
record_session
chk "record_session gets a session out of it" "$(jq -r .session "$CONVEYOR_RESULT")" "sess-long"

# 18. hit_limit tells the CLI refusing to run from the model talking about a
#     refusal. Both are in $CLAUDE_SAID and only the first one is ours: the
#     mark it produces pauses every claude stage on the board, so reading the
#     second as the first stops the whole line over someone else's quota.
printf '%s\n' "You've hit your session limit · resets 8:30pm (UTC)" >"$CLAUDE_SAID"
chk "the CLI's own refusal is recognised" "$(hit_limit && echo yes)" "yes"

# The same line where it really appears: last, after a run's worth of output.
printf '%s\n' 'Analyzer clean. Now the real gate:' '  · Bash: dart test test/feed/' \
	"You've hit your weekly limit · resets Sep 8th (UTC)" >"$CLAUDE_SAID"
chk "recognised at the end of a real transcript" "$(hit_limit && echo yes)" "yes"

# The regression: a refine that finished its work and then explained why Codex
# could not run. Quoting a quota error is not hitting one.
printf '%s\n' '**Codex did not run.** Same block as before — the account is over its limit' \
	'until 2026-09-08 (`ERROR: You'"'"'ve hit your usage limit... try again at Sep 8th`).' \
	'Per the skill'"'"'s one-round rule the spec ships without it.' >"$CLAUDE_SAID"
chk "the model quoting a quota error is not one" "$(hit_limit && echo yes)" ""

# The typographic apostrophe the CLI may render instead of the plain one.
printf '%s\n' "You’ve hit your usage limit · resets 1:30am (UTC)" >"$CLAUDE_SAID"
chk "a curly apostrophe is still recognised" "$(hit_limit && echo yes)" "yes"

: > "$CLAUDE_SAID"
chk "an empty transcript is not a quota stop" "$(hit_limit && echo yes)" ""

exit $fail
