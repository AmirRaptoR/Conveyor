#!/usr/bin/env bash
# Implement an item with Claude Code, headless, and open a pull request.
#
# Config (source env: + this script's params:):
#   PROMPT           what to do. Required. The item is prepended for you.
#   ALLOWED_TOOLS    --allowedTools (default: read/write plus gh via Bash)
#   MODEL, MAX_TURNS, PERMISSION_MODE
#   REPO             owner/name, for the pull-request check
set -euo pipefail

: "${PROMPT:?PROMPT is required (set it in this script params: block)}"

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")
body=$(jq -r '.item.description // ""' <<<"$payload")

# A dirty tree means the previous run died mid-edit. Building on top of that is
# how one failure becomes a corrupted branch, so stop and ask for a human.
if [[ -n "$(git status --porcelain)" ]]; then
	echo "worktree is dirty; refusing to start" >&2
	exit 20
fi
# `git pull` exits non-zero on a branch with no upstream, which under set -e
# would kill this before the agent runs, with an error unlike its cause.
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
	git pull --ff-only
else
	echo "no upstream for $(git branch --show-current); skipping pull" >&2
fi

echo "implementing $CONVEYOR_SOURCE #$ref — $title"

full="Item #${ref}${REPO:+ in $REPO}: ${title}

--- item body ---
${body}
--- end item body ---

${PROMPT}

If this cannot be done as written, change nothing and write
{\"blocked\": true, \"reason\": \"<why>\"} to the file at ${CONVEYOR_RESULT}."

set +e
claude -p "$full" \
	--max-turns "${MAX_TURNS:-200}" \
	--permission-mode "${PERMISSION_MODE:-acceptEdits}" \
	--allowedTools "${ALLOWED_TOOLS:-Bash,Read,Edit,Write,Glob,Grep,Agent,Skill}" \
	${MODEL:+--model "$MODEL"}
rc=$?
set -e

if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
	[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
	echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
	exit 20
fi

# The provider is the record, never the agent's claim: if no PR references the
# item, the work did not land whatever the transcript said.
if [[ -n "${REPO:-}" ]]; then
	pr=$(gh pr list --repo "$REPO" --state open --search "$ref" --json number --jq '.[0].number' 2>/dev/null)
	if [[ -z "$pr" ]]; then
		echo "no open PR references #$ref" >&2
		exit 20
	fi
	echo "opened PR #$pr"
fi
exit $rc
