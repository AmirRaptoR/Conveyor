#!/usr/bin/env bash
# Implement an item with Claude Code, headless, and open a pull request.
#
# Config (source env: + this script's params:):
#   PROMPT           what to do. Required. Plain instructions, or a slash
#                    command such as "/implement $REF auto" — a command leads
#                    the message, so the item context follows it.
#   ALLOWED_TOOLS    --allowedTools (default: read/write plus gh via Bash)
#   MODEL            --model (default: whatever the CLI is configured with)
#   MAX_TURNS, PERMISSION_MODE
#   REPO             owner/name, for the pull-request check
set -euo pipefail

# Streams the agent's work as it happens; without it a long stage looks dead.
source "$(dirname "$0")/_stream"
source "$(dirname "$0")/../_blocked"
source "$(dirname "$0")/../_worktree"
source "$(dirname "$0")/../_resume"
source "$(dirname "$0")/../_deadline"
source "$(dirname "$0")/../_pr"
source "$(dirname "$0")/../_deps"

# noop_brief — the escape hatch for the no-output guard below: a way to end a
# run deliberately, with nothing committed, that is not the model asking a
# question in prose and stopping. Distinct from decision_brief: nobody has to
# decide anything here, there is simply no work to do.
noop_brief() {
	cat <<-BRIEF
	If you finish without committing anything on purpose — you looked and there
	was nothing needed doing — say so by writing this to the file at ${CONVEYOR_RESULT}:

	  {"noop": true, "reason": "<why nothing needed doing>"}

	This is not the decision above: nobody has to choose anything. A run that
	ends with no commit and no result file at all will be marked for a person
	to look at, on the assumption that a question was asked in prose and never
	written down.
	BRIEF
}

: "${PROMPT:?PROMPT is required (set it in this script params: block)}"

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")
title=$(jq -r '.item.title' <<<"$payload")
body=$(jq -r '.item.description // ""' <<<"$payload")
url=$(jq -r '.item.url // ""' <<<"$payload")

# An open PR for this item means review sent it back. Say so, or the agent
# starts again from scratch and throws away the work being corrected — and build
# the worktree on that branch rather than on a fresh one off the default.
rework=""
head=""
if [[ -n "${REPO:-}" ]]; then
	# Before the dependency check, before the worktree, long before the model:
	# the provider's own record of what closed the issue, never the agent's
	# claim. An item whose issue is already closed by a merged pull request is
	# done, whatever brought this run back to it — quesshi:25 was one run an
	# hour, forever, of an agent saying exactly that and being marked a
	# failure anyway.
	item_landed "$ref"
	case "$LANDED" in
	unavailable)
		echo "could not tell whether #$ref already landed; deferring rather than risk redoing work already done" >&2
		exit 10
		;;
	yes)
		echo "issue #$ref is already closed by merged pull request #$LANDED_PR; nothing to implement"
		exit 0
		;;
	esac

	# Before the worktree and long before the model: an item sequenced behind
	# an open issue is not startable, and finding that out is not worth a run.
	waiting=$(open_dependencies "$body")
	if [[ -n "$waiting" ]]; then
		blocked dependency "waits on $waiting, still open. Nothing is wrong with \
this item; Diagnose clears it once they close."
	fi

	pr_lookup "$ref" open
	case "$PR_STATUS" in
	unavailable)
		echo "could not tell whether #$ref already has an open pull request; deferring rather than risk opening a second one" >&2
		exit 10
		;;
	several)
		blocked decision "more than one open pull request appears to close issue #$ref; resolve which one is correct before this can proceed."
		;;
	one)
		existing=$PR_NUMBER
		head=$PR_HEAD
		echo "PR #$existing exists — this is a rework pass"
		rework="
This item already has pull request #${existing}, which a reviewer sent back.
Read the review first:
  gh pr view ${existing} --repo ${REPO} --comments
Address that feedback on the existing branch and push to the same PR. Do not
open a second one, and do not restart the work from scratch."
		;;
	esac
fi

# This item's own directory. The repository the human works in is never touched
# and never has to be clean; two items in one repository no longer share a tree,
# so they can run at the same time.
wt=$(item_worktree "$CONVEYOR_SOURCE" "$ref" "$head")
cd "$wt"

# A dirty tree here is this item's own leftovers — a previous run for THIS issue
# that died mid-edit, which is a normal thing rather than a fault. It is a
# resume, not a stop: see agents/_resume for why, and for the two cases that do
# still stop the item. Called directly, never in a substitution — it stops
# through `blocked`, and a subshell would swallow that.
resume_leftovers "$ref"
leftovers="$RESUME_BRIEF"

# Captured now, before the model runs, so a run that leaves both of these
# exactly where it found them can be told apart from one that quietly did the
# work (the no-output guard below). Branch name, not HEAD: an agent that
# changed branch under itself — which the prompt below forbids — must still
# read as "the item's branch did not move", which is the truth. `-q --verify`
# with `|| true` *inside* the substitution, not around it, so a ref that does
# not exist yet (a freshly created item branch has no remote-tracking ref
# until its first push) yields an empty string rather than tripping `set -e`.
guard_branch=$(git branch --show-current)
[[ -n "$guard_branch" ]] || guard_branch=HEAD
guard_head_before=$(git rev-parse -q --verify "refs/heads/$guard_branch" 2>/dev/null || true)
guard_origin_before=$(git rev-parse -q --verify "refs/remotes/origin/$guard_branch" 2>/dev/null || true)

echo "implementing $CONVEYOR_SOURCE #$ref — $title"
echo "  worktree: $wt  (branch $(git branch --show-current))"

# A prompt beginning with "/" is a slash command and must lead the message, so
# the item context follows it instead of preceding it. $REF is expanded either
# way — it is the one substitution this adapter makes, because a command needs
# the issue number as its argument.
task=${PROMPT//\$REF/$ref}

if [[ "$task" == /* ]]; then
	full="${task}

--- the item, as the pipeline sees it ---
Item #${ref}${REPO:+ in $REPO}: ${title}
${url}
${body}
--- end item ---
${rework}${leftovers}"
else
	full="Item #${ref}${REPO:+ in $REPO}: ${title}
${url}

--- item body ---
${body}
--- end item body ---

${task}
${rework}${leftovers}"
fi

full="${full}

You are in a git worktree of your own at ${wt}, already on branch \
$(git branch --show-current), taken from the remote's default branch. Work here.
Do NOT run \`git checkout main\`, \`git switch\` or \`git checkout -b\`: this
directory is one of several checkouts of this repository that are live right
now, main is checked out elsewhere, and changing branch under yourself is how
one item's work lands on another item's branch. The branch you are on is the
branch for this issue — commit to it and push it with \`git push -u origin HEAD\`.

$(decision_brief)

$(noop_brief)"

# How long it has, and what to do if that is not enough. Last, because it is the
# instruction that governs all the others.
full="${full}
$(deadline_brief)"

# A person may have answered the question this stage stopped on last time.
full=$(resume_prompt "$payload" "$full")

set +e
MAX_TURNS="${MAX_TURNS:-200}" \
	ALLOWED_TOOLS="${ALLOWED_TOOLS:-Bash,Read,Edit,Write,Glob,Grep,Agent,Skill}" \
	run_claude "$full"
rc=$?
set -e

# What ran, said once in the log. Here rather than beside each exit, because a
# run stopped by a usage limit is exactly the one the measurement is about.
record_model

# Out of quota is not a fault of the item, and must not read like one: without
# this the run ends having done nothing and the next check reports whatever it
# failed to find, which is how "no open PR references #49" came to mean "the
# account was rate limited".
if hit_limit; then
	blocked limit "the agent was out of quota and stopped before doing the work. \
Nothing is wrong with this item; it is waiting for the window to reset."
fi

# See agents/claude/review for the reasoning: a turn budget is a condition,
# not a fault, and the implementation done up to the wall is worth resuming
# into rather than losing to a cold restart.
if hit_max_turns; then
	record_session
	blocked turns "the agent hit its ${MAX_TURNS:-200}-turn budget before \
finishing the implementation. This is not a fault of the item. Answering this \
mark with anything (e.g. \"continue\") resumes the same conversation with a \
fresh turn budget instead of starting over; clearing the label alone starts a \
new conversation, which resume_leftovers will still pick up from the tree but \
without the conversation's own context."
fi

if [[ -s "${CONVEYOR_RESULT:-}" ]] &&
	[[ "$(jq -r '.blocked // false' "$CONVEYOR_RESULT" 2>/dev/null)" == "true" ]]; then
	agent_asked
	echo "blocked: $(jq -r '.reason // "no reason given"' "$CONVEYOR_RESULT")" >&2
	exit 20 # the agent wrote its own reason; leave it exactly as written
fi

# The model's own stop above always wins; this is the adapter's inference for
# when it says nothing at all. Only checked on a clean exit — `hit_limit` and
# `hit_max_turns` already caught the two known conditions that leave a run
# producing nothing (quota, the turn wall), and a crashed run is already a
# failure with its own log, so turning that into an unclearable question would
# be the wrong trade for a transient tool failure. What is left is dominated by
# the observed case: a model that asked its question in prose, believing it
# was talking to someone, and stopped — leaving $CONVEYOR_RESULT empty and
# neither ref moved. Re-running that blind reproduces the hold, so this is
# `asks`, not `blocked`: a question, never bulk-cleared by `Unblock all` or
# `retryStalled`. `record_session` first, since `asks` writes to the same file.
if [[ $rc -eq 0 ]] && [[ ! -s "${CONVEYOR_RESULT:-}" ]]; then
	guard_head_after=$(git rev-parse -q --verify "refs/heads/$guard_branch" 2>/dev/null || true)
	guard_origin_after=$(git rev-parse -q --verify "refs/remotes/origin/$guard_branch" 2>/dev/null || true)
	if [[ "$guard_head_after" == "$guard_head_before" && "$guard_origin_after" == "$guard_origin_before" ]]; then
		record_session
		asks no-output "the run finished without committing, pushing or writing a result. \
Read this run's log for what it actually did — a model that asked a question in prose and \
stopped, believing it was talking to someone, is the usual cause. Answering this mark \
resumes the same conversation rather than starting cold."
	fi
fi

# The provider is the record, never the agent's claim: if no PR references the
# item, the work did not land whatever the transcript said. Found by closing
# reference, the same shared rule as everywhere else — never `gh pr list
# --search`, which matches a number anywhere in any PR's text.
if [[ -n "${REPO:-}" ]]; then
	pr_lookup "$ref" open
	case "$PR_STATUS" in
	unavailable)
		echo "could not confirm whether the agent's work landed a pull request for #$ref; deferring rather than reporting nothing landed" >&2
		exit 10
		;;
	several)
		blocked decision "more than one open pull request now closes issue #$ref; resolve which one is correct before this can proceed."
		;;
	none)
		# No *open* PR is not the same as nothing landed: it may already have
		# merged. The provider's own record of what closed the issue settles
		# it, the same lookup the preflight above already asked.
		item_landed "$ref"
		case "$LANDED" in
		unavailable)
			echo "could not confirm whether the agent's work landed a pull request for #$ref; deferring rather than reporting nothing landed" >&2
			exit 10
			;;
		yes)
			echo "issue #$ref is already closed by merged pull request #$LANDED_PR; the work landed"
			exit 0
			;;
		esac
		if [[ "$ISSUE_STATE" == "CLOSED" ]]; then
			asks no-output "issue #$ref is closed but no merged pull request references it, \
so nothing has landed. Check whether it was closed by hand; if the work still needs doing, \
reopen it, or answer here with what to do next."
		fi
		blocked no-output "the agent finished but no open pull request references #$ref, so \
nothing landed. Read this run's log for what it did — a run cut short by a usage \
limit looks exactly like this."
		;;
	esac
	# A draft here means the run did not finish: /implement marks a PR ready
	# when the suite is green, so a model that stopped short of that (or a run
	# whose exit code says nothing went wrong) has left work for review to find
	# undone. Checked whatever $rc is — the same asymmetry the no-output stop
	# above already has, because a non-zero run that also left a draft is
	# exactly the silent case this exists to catch.
	if [[ "$PR_DRAFT" == "true" ]]; then
		blocked draft "pull request #$PR_NUMBER, which closes issue #$ref, is \
still a draft. A pull request must be marked ready before this item can \
advance; an implement run that did not reach \`gh pr ready\` is the usual \
cause."
	fi
	pr=$PR_NUMBER
	echo "opened PR #$pr"
fi
exit $rc
