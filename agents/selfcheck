#!/usr/bin/env bash
# Checks the shared adapter helpers — the ones under agents/ that every agent
# sources. Builds a throwaway repository and a throwaway remote; touches
# nothing real and runs no model.
#
#   agents/selfcheck
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
source "$here/_worktree"
source "$here/_blocked"
source "$here/_resume"
source "$here/_deadline"

fail=0
chk() { if [[ "$2" == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fail=1; fi; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export WORKTREES="$tmp/worktrees"

git init --quiet --bare "$tmp/origin.git"
git clone --quiet "$tmp/origin.git" "$tmp/repo"
cd "$tmp/repo"
git config user.email a@b.c && git config user.name t
git symbolic-ref HEAD refs/heads/main
echo one > file.txt && git add -A && git commit --quiet -m first
git push --quiet -u origin main
git remote set-head origin -a >/dev/null 2>&1 || true

chk "the default branch comes from the remote" "$(default_branch)" "main"

# 1. a new item gets its own directory, on its own branch, off the default.
p=$(item_worktree demo 42)
chk "the worktree is outside the repository" "$(dirname "$(dirname "$p")")" "$WORKTREES"
chk "it is a real checkout"                  "$(cd "$p" && git rev-parse --is-inside-work-tree)" "true"
chk "on the item's own branch"               "$(cd "$p" && git branch --show-current)" "issue-42"
chk "starting from the default branch"       "$(cd "$p" && git rev-parse HEAD)" "$(git rev-parse origin/main)"

# 2. the repository a person works in is untouched, dirty or not.
echo scratch > uncommitted.txt
chk "the source checkout keeps its own state" "$(git status --porcelain | wc -l | tr -d ' ')" "1"
p2=$(item_worktree demo 43)
chk "a dirty source checkout blocks nothing"  "$(cd "$p2" && git branch --show-current)" "issue-43"

# 3. two items at once, which is the whole point.
chk "two items have two directories" "$([[ "$p" != "$p2" ]] && echo yes)" "yes"
(cd "$p" && echo a > w.txt && git add -A && git commit --quiet -m a)
(cd "$p2" && echo b > w.txt && git add -A && git commit --quiet -m b)
chk "neither sees the other's work" "$(cd "$p" && git log --oneline | wc -l | tr -d ' ')" "2"

# 4. asking again returns the same directory rather than rebuilding it.
chk "an existing worktree is reused" "$(item_worktree demo 42)" "$p"

# 5. rework: an existing remote branch is what the worktree tracks.
git push --quiet origin "$(cd "$p" && git branch --show-current)":refs/heads/pr-branch
p3=$(item_worktree demo 44 pr-branch)
chk "a named branch is honoured" "$(cd "$p3" && git branch --show-current)" "pr-branch"

# 6. cleanup after a merge removes it, and prune leaves git consistent.
drop_worktree demo 44
chk "a merged item's worktree is gone" "$([[ -d "$p3" ]] && echo present || echo gone)" "gone"
chk "the others survive"               "$([[ -d "$p" && -d "$p2" ]] && echo yes)" "yes"

# 7. a directory deleted by hand can be recreated under the same name.
rm -rf "$p2"
p4=$(item_worktree demo 43)
chk "a hand-deleted worktree comes back" "$(cd "$p4" && git rev-parse --is-inside-work-tree)" "true"

# 8. a creation that cannot work fails loudly instead of naming a directory that
# is not there — the agent would `cd` into nothing and report the wrong problem.
if item_worktree demo 45 >/dev/null 2>&1 <&- ; then :; fi
cd "$tmp" && git init --quiet "$tmp/noremote" && cd "$tmp/noremote"
git config user.email a@b.c && git config user.name t
echo x > f && git add -A && git commit --quiet -m only
if out=$(item_worktree broken 99 2>/dev/null); then
	chk "a repository with no remote is refused" "made [$out]" "refused"
else
	chk "a repository with no remote is refused" "refused" "refused"
fi
cd "$tmp/repo"

# 9b. the sweep: spent worktrees go, everything with anything in it stays, and
# an active lease outweighs recency in both directions.
spent=$(item_worktree demo 60)          # nothing beyond the base, will go cold
work=$(item_worktree demo 61)           # has a commit of its own
dirty=$(item_worktree demo 62)          # uncommitted changes
leased=$(item_worktree demo 63)         # spent, but a live lease still holds it
(cd "$spent" && git reset --quiet --hard origin/main)
(cd "$work" && echo keep > k.txt && git add -A && git commit --quiet -m mine)
echo scratch > "$dirty/wip.txt"
(cd "$leased" && git reset --quiet --hard origin/main)

# Simulate the runs that made spent/work/dirty having already finished: their
# leases are gone, the same as a real stage script that has since exited.
# `leased`'s lease is left as item_worktree wrote it — this script's own PID,
# which is alive for the rest of the run.
rm -f "$(_worktree_gitdir "$spent")/conveyor-lease"
rm -f "$(_worktree_gitdir "$work")/conveyor-lease"
rm -f "$(_worktree_gitdir "$dirty")/conveyor-lease"
touch -d "3 hours ago" "$spent" "$work" "$dirty" "$leased"

sweep_worktrees demo 2>/dev/null
chk "a spent worktree with no lease is swept"       "$([[ -d "$spent" ]] && echo present || echo gone)" "gone"
chk "an unpushed commit is not swept, lease or not" "$([[ -d "$work" ]] && echo present)" "present"
chk "uncommitted work is not swept, lease or not"   "$([[ -d "$dirty" ]] && echo present)" "present"
chk "a live lease is not swept, whatever its age"   "$([[ -d "$leased" ]] && echo present)" "present"
chk "the item being worked is kept" \
	"$(sweep_worktrees demo 63 2>/dev/null; [[ -d "$leased" ]] && echo present)" "present"

# The same worktree, once its lease names a dead PID past its deadline, is
# swept even though its mtime is touched to right now — recency does not save
# it either way, only the lease does.
gd=$(_worktree_gitdir "$leased")
printf '%s %s\n' 999999 "$(date -u -d '-1 hour' +%Y-%m-%dT%H:%M:%SZ)" >"$gd/conveyor-lease"
touch "$leased"
sweep_worktrees demo 2>/dev/null
chk "a dead lease past its deadline is swept" "$([[ -d "$leased" ]] && echo present || echo gone)" "gone"

# 10. a branch checked out elsewhere is refused, never reclaimed. A "clean
# holder" used to be treated as disposable, and the primary checkout is always
# clean and always listed in `git worktree list` — which is what turned Git's
# own refusal to remove it into the trigger for `rm -rf` on the reproduction
# this issue fixes.
export CONVEYOR_RESULT="$tmp/held.json"
git -C "$tmp/repo" checkout --quiet -b review-branch
echo secret.env >>"$tmp/repo/.gitignore"
echo top-secret >"$tmp/repo/secret.env"
git -C "$tmp/repo" add .gitignore && git -C "$tmp/repo" commit --quiet -m gitignore

: >"$CONVEYOR_RESULT"
out=""
rc=0; out=$(cd "$tmp/repo" && item_worktree demo 71 review-branch 2>/dev/null) || rc=$?
chk "a branch held by the primary checkout is refused" "$rc" "20"
chk "nothing is printed to use as a workdir"            "$out" ""
chk "the mark names the branch"                         "$(jq -r '.reason | test("review-branch")' "$CONVEYOR_RESULT")" "true"
chk "and the holding path"                              "$(jq -r '.reason | test("'"$tmp"'/repo")' "$CONVEYOR_RESULT")" "true"
chk "the primary checkout's tracked file survives"      "$([[ -f "$tmp/repo/file.txt" ]] && echo yes)" "yes"
chk "its .git survives"                                 "$([[ -d "$tmp/repo/.git" ]] && echo yes)" "yes"
chk "and its ignored file survives"                     "$([[ -f "$tmp/repo/secret.env" ]] && echo yes)" "yes"

# a local-only commit on that branch is untouched by the refusal.
git -C "$tmp/repo" commit --quiet --allow-empty -m 'local only, never pushed'
local_sha=$(git -C "$tmp/repo" rev-parse HEAD)
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo 71 review-branch >/dev/null 2>&1) || rc=$?
chk "the refusal is the same with a local-only commit" "$rc" "20"
chk "the commit is still reachable afterward" "$(git -C "$tmp/repo" rev-parse HEAD)" "$local_sha"

# a dirty primary checkout is refused exactly the same way — clean is not what
# makes a checkout Conveyor's to use, so being dirty does not change anything.
echo dirty >"$tmp/repo/file.txt"
: >"$CONVEYOR_RESULT"
out=""
rc=0; out=$(cd "$tmp/repo" && item_worktree demo 71 review-branch 2>/dev/null) || rc=$?
chk "a dirty primary checkout is refused too"   "$rc" "20"
chk "still nothing printed to use as a workdir" "$out" ""
git -C "$tmp/repo" checkout --quiet -- file.txt

# an external `git worktree`, made outside the managed root, is refused and
# left standing with its contents.
elsewhere="$tmp/held-external"
git -C "$tmp/repo" worktree add --quiet -B external-branch "$elsewhere" origin/main
echo work >"$elsewhere/mine.txt"
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo 72 external-branch >/dev/null 2>&1) || rc=$?
chk "an external worktree is refused"  "$rc" "20"
chk "and it is left exactly as it was" "$([[ -f "$elsewhere/mine.txt" ]] && echo yes)" "yes"

# a branch held by another item's own managed worktree — the refusal names
# both paths and neither directory is removed.
held_item=$(item_worktree demo 73)
(cd "$held_item" && git checkout --quiet -b shared-branch)
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo 74 shared-branch >/dev/null 2>&1) || rc=$?
chk "a branch held by another managed worktree is refused" "$rc" "20"
chk "the reason names the holder"            "$(jq -r ".reason | test(\"$held_item\")" "$CONVEYOR_RESULT")" "true"
chk "and this item's own path"               "$(jq -r '.reason | test("demo/74")' "$CONVEYOR_RESULT")" "true"
chk "the holder still exists"                "$([[ -d "$held_item" ]] && echo yes)" "yes"
chk "the requester's path was never created" "$([[ -e "$WORKTREES/demo/74" ]] && echo present || echo gone)" "gone"
cd "$tmp/repo" && git checkout --quiet main

# a directory a person made at the exact path Conveyor would use is not
# Conveyor's, no matter how it looks. item_worktree refuses it outright;
# drop_worktree and sweep_worktrees leave it alone and say so on stderr.
mkdir -p "$WORKTREES/demo/75"
echo mine >"$WORKTREES/demo/75/hello.txt"
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo 75 >/dev/null 2>&1) || rc=$?
chk "an unowned path at the managed location is refused" "$rc" "20"
chk "the reason is the generic one, not a version-boundary story" \
	"$(jq -r '.reason | test("was not created by Conveyor")' "$CONVEYOR_RESULT")" "true"
chk "and it is untouched" "$(cat "$WORKTREES/demo/75/hello.txt")" "mine"
drop_worktree demo 75 2>/dev/null
chk "drop_worktree leaves an unowned path alone" "$([[ -f "$WORKTREES/demo/75/hello.txt" ]] && echo yes)" "yes"
sweep_worktrees demo 2>/dev/null
chk "sweep_worktrees leaves an unowned path alone too" "$([[ -f "$WORKTREES/demo/75/hello.txt" ]] && echo yes)" "yes"
rm -rf "$WORKTREES/demo/75"

# a symlink at the managed path pointing outside the managed root is not ours
# either: the target is intact after all three operations.
escape_target="$tmp/escape-target"
mkdir -p "$escape_target"
echo escaped >"$escape_target/keep.txt"
ln -s "$escape_target" "$WORKTREES/demo/76"
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo 76 >/dev/null 2>&1) || rc=$?
chk "a symlink escaping the managed root is refused" "$rc" "20"
drop_worktree demo 76 2>/dev/null
sweep_worktrees demo 2>/dev/null
chk "the symlink target survives all three" "$(cat "$escape_target/keep.txt")" "escaped"
rm -f "$WORKTREES/demo/76"

# a source name or ref with a space in it is handled without being split — the
# worktree is created at the literal path and the ownership check accepts it.
sp=$(cd "$tmp/repo" && item_worktree "demo space" "ref one")
chk "a space in source/ref creates the literal path" "$sp" "$WORKTREES/demo space/ref one"
chk "it is a real checkout" "$(cd "$sp" && git rev-parse --is-inside-work-tree)" "true"
chk "asking again returns the same path" "$(cd "$tmp/repo" && item_worktree "demo space" "ref one")" "$sp"

# stripping its marker reproduces exactly what a pre-#33 worktree looked like;
# adoption still finds it at the literal (unsanitised) path, on the sanitised
# branch, and does not mark the item.
sp_gd=$(_worktree_gitdir "$sp")
rm -f "$sp_gd/conveyor-owner"
: >"$CONVEYOR_RESULT"
sp2=$(cd "$tmp/repo" && item_worktree "demo space" "ref one")
chk "a space in ref is adopted at the literal path" "$sp2" "$sp"
chk "on the sanitised branch"                       "$(cd "$sp" && git branch --show-current)" "issue-ref-one"
chk "adoption does not mark the item"               "$(cat "$CONVEYOR_RESULT")" ""

drop_worktree "demo space" "ref one"
chk "it can be dropped too" "$([[ -e "$sp" ]] && echo present || echo gone)" "gone"

# 10b. adoption (#60): a worktree that predates the conveyor-owner marker is
# not automatically unowned — a narrow proof (right path, linked worktree of
# this repo, on branch issue-<ref>) is enough, and item_worktree, sweep and
# drop all treat it the same way _worktree_owned always has: as ours.
adopt=$(item_worktree demo-adopt 80)
adopt_gd=$(_worktree_gitdir "$adopt")
head_before=$(git -C "$adopt" rev-parse HEAD)
echo scratch >"$adopt/keep-me.txt"
echo 'a local edit' >>"$adopt/file.txt"
rm -f "$adopt_gd/conveyor-owner"

: >"$CONVEYOR_RESULT"
reused=$(cd "$tmp/repo" && item_worktree demo-adopt 80)
chk "an unmarked but provable worktree is reused, not refused" "$reused" "$adopt"
chk "adoption does not mark the item"                          "$(cat "$CONVEYOR_RESULT")" ""
chk "the marker now exists with source and ref, one per line" \
	"$(cat "$adopt_gd/conveyor-owner")" "$(printf 'demo-adopt\n80')"
chk "a second call takes the already-marked path" \
	"$(cd "$tmp/repo" && item_worktree demo-adopt 80)" "$adopt"
chk "an uncommitted change survives adoption" "$(grep -c 'a local edit' "$adopt/file.txt")" "1"
chk "an untracked file survives adoption"     "$(cat "$adopt/keep-me.txt")" "scratch"
chk "HEAD is unchanged by adoption"           "$(git -C "$adopt" rev-parse HEAD)" "$head_before"

# the answer is the proof, not the bookkeeping: a git dir that cannot be
# written to still gets the path back, and the failure is reported rather
# than turned into a mark.
fail_wt=$(item_worktree demo-adopt-ro 81)
fail_gd=$(_worktree_gitdir "$fail_wt")
rm -f "$fail_gd/conveyor-owner"
chmod 500 "$fail_gd"
err=$(mktemp)
out=$(cd "$tmp/repo" && item_worktree demo-adopt-ro 81 2>"$err")
chk "adoption still returns the path when the marker cannot be written" "$out" "$fail_wt"
chk "the failed write is reported on stderr" "$(grep -c 'could not write ownership marker' "$err")" "1"
chk "and no marker exists" "$([[ -f "$fail_gd/conveyor-owner" ]] && echo present || echo none)" "none"
chmod 700 "$fail_gd"
out=$(cd "$tmp/repo" && item_worktree demo-adopt-ro 81 2>/dev/null)
chk "a later call proves it again once the git dir is writable" "$out" "$fail_wt"
chk "and writes the marker then" "$([[ -f "$fail_gd/conveyor-owner" ]] && echo present || echo none)" "present"
rm -f "$err"

# sweep_worktrees adopts through the same test, applied in its own loop
# rather than item_worktree's reuse path — a clean, fully-pushed, unleased one
# is swept, not refused as unowned.
swp=$(item_worktree demo-sweep-adopt 91)
swp_gd=$(_worktree_gitdir "$swp")
rm -f "$swp_gd/conveyor-owner" "$swp_gd/conveyor-lease"
touch -d "3 hours ago" "$swp"
err=$(mktemp)
sweep_worktrees demo-sweep-adopt 2>"$err"
chk "the sweep does not call an unmarked-but-provable path unowned" \
	"$(grep -c 'refusing to sweep unowned path' "$err")" "0"
chk "and sweeps it, since it is clean and fully pushed" "$([[ -d "$swp" ]] && echo present || echo gone)" "gone"
rm -f "$err"

# adopted does not mean swept — the sweep's other guards still decide, so an
# adopted-but-dirty worktree is marked ours and left standing.
swp2=$(item_worktree demo-sweep-adopt 92)
swp2_gd=$(_worktree_gitdir "$swp2")
rm -f "$swp2_gd/conveyor-owner" "$swp2_gd/conveyor-lease"
echo dirty >"$swp2/wip.txt"
touch -d "3 hours ago" "$swp2"
sweep_worktrees demo-sweep-adopt 2>/dev/null
chk "an adopted but dirty worktree is not swept" "$([[ -d "$swp2" ]] && echo present)" "present"
chk "it is adopted anyway"                       "$([[ -f "$swp2_gd/conveyor-owner" ]] && echo present)" "present"

# drop_worktree adopts and removes an unmarked-but-provable worktree instead
# of refusing it as unowned.
drp=$(item_worktree demo-drop-adopt 93)
drp_gd=$(_worktree_gitdir "$drp")
rm -f "$drp_gd/conveyor-owner"
err=$(mktemp)
drop_worktree demo-drop-adopt 93 2>"$err"
chk "drop_worktree does not call an unmarked-but-provable path unowned" \
	"$(grep -c 'refusing to remove unowned path' "$err")" "0"
chk "and removes it" "$([[ -e "$drp" ]] && echo present || echo gone)" "gone"
rm -f "$err"

# still refused, every case leaving the directory untouched and writing no
# marker: a plain directory git resolves to an *enclosing* repository is not a
# linked worktree (its git dir is that repository's own, not a `worktrees/`
# entry under it).
mkdir -p "$WORKTREES/encl"
git init --quiet "$WORKTREES/encl"
git -C "$WORKTREES/encl" config user.email a@b.c && git -C "$WORKTREES/encl" config user.name t
touch "$WORKTREES/encl/root.txt" && git -C "$WORKTREES/encl" add -A && git -C "$WORKTREES/encl" commit --quiet -m root
mkdir -p "$WORKTREES/encl/85"
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree encl 85 >/dev/null 2>&1) || rc=$?
chk "a directory resolving to an enclosing repo is refused" "$rc" "20"
chk "with the generic wording" "$(jq -r '.reason | test("was not created by Conveyor")' "$CONVEYOR_RESULT")" "true"
chk "and no marker is written" "$([[ -f "$WORKTREES/encl/.git/conveyor-owner" ]] && echo present || echo none)" "none"

# a linked worktree at the managed path belonging to a *different* repository.
git init --quiet --bare "$tmp/other-origin.git"
git clone --quiet "$tmp/other-origin.git" "$tmp/other-repo"
git -C "$tmp/other-repo" config user.email a@b.c && git -C "$tmp/other-repo" config user.name t
git -C "$tmp/other-repo" symbolic-ref HEAD refs/heads/main
echo one >"$tmp/other-repo/file.txt" && git -C "$tmp/other-repo" add -A && git -C "$tmp/other-repo" commit --quiet -m first
git -C "$tmp/other-repo" push --quiet -u origin main
git -C "$tmp/other-repo" worktree add --quiet -B issue-86 "$WORKTREES/demo-diffrepo/86" origin/main
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo-diffrepo 86 >/dev/null 2>&1) || rc=$?
chk "a linked worktree of a different repository is refused" "$rc" "20"
chk "with the generic wording, not the version-boundary one" \
	"$(jq -r '.reason | test("was not created by Conveyor")' "$CONVEYOR_RESULT")" "true"
chk "and no marker is written" \
	"$([[ -f "$(_worktree_gitdir "$WORKTREES/demo-diffrepo/86")/conveyor-owner" ]] && echo present || echo none)" "none"

# the primary checkout, were it to sit at the managed path, is refused the
# same generic way — its git dir equals its common dir, so it is not linked.
git clone --quiet "$tmp/origin.git" "$WORKTREES/demo-primary/87"
git -C "$WORKTREES/demo-primary/87" config user.email a@b.c
git -C "$WORKTREES/demo-primary/87" config user.name t
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo-primary 87 >/dev/null 2>&1) || rc=$?
chk "a primary checkout at the managed path is refused" "$rc" "20"
chk "with the generic wording" "$(jq -r '.reason | test("was not created by Conveyor")' "$CONVEYOR_RESULT")" "true"
chk "and no marker is written" "$([[ -f "$WORKTREES/demo-primary/87/.git/conveyor-owner" ]] && echo present || echo none)" "none"

# a linked worktree of the right repository at the right path but on a
# different branch, a rework worktree tracking a differently-named pull
# request branch included: the mark names the version boundary and the
# branch actually held, next to the branch adoption wanted.
git -C "$tmp/repo" worktree add --quiet -B other-topic-branch "$WORKTREES/demo-branch/88" origin/main
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo-branch 88 >/dev/null 2>&1) || rc=$?
chk "a linked worktree on the wrong branch is refused" "$rc" "20"
chk "the mark says the ownership marker is missing" \
	"$(jq -r '.reason | test("no conveyor-owner marker")' "$CONVEYOR_RESULT")" "true"
chk "and names the branch it is actually on" \
	"$(jq -r '.reason | test("other-topic-branch")' "$CONVEYOR_RESULT")" "true"
chk "next to the branch adoption wanted" \
	"$(jq -r '.reason | test("issue-88")' "$CONVEYOR_RESULT")" "true"
chk "and no marker is written" \
	"$([[ -f "$(_worktree_gitdir "$WORKTREES/demo-branch/88")/conveyor-owner" ]] && echo present || echo none)" "none"

# a linked worktree of the right repository at the right path with a detached
# HEAD: still refused, and the mark says so instead of naming a branch.
git -C "$tmp/repo" worktree add --quiet --detach "$WORKTREES/demo-detached/89" origin/main
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/repo" && item_worktree demo-detached 89 >/dev/null 2>&1) || rc=$?
chk "a linked worktree with a detached HEAD is refused" "$rc" "20"
chk "the mark says the ownership marker is missing" \
	"$(jq -r '.reason | test("no conveyor-owner marker")' "$CONVEYOR_RESULT")" "true"
chk "and calls out the detached HEAD" "$(jq -r '.reason | test("detached HEAD")' "$CONVEYOR_RESULT")" "true"
chk "and no marker is written" \
	"$([[ -f "$(_worktree_gitdir "$WORKTREES/demo-detached/89")/conveyor-owner" ]] && echo present || echo none)" "none"

# adoption fails closed: called from a directory that is not a git repository
# at all, the same worktree that would otherwise be adopted is refused.
mkdir -p "$tmp/not-a-repo"
noref=$(cd "$tmp/repo" && item_worktree noref-src 90)
noref_gd=$(_worktree_gitdir "$noref")
rm -f "$noref_gd/conveyor-owner"
: >"$CONVEYOR_RESULT"
rc=0; (cd "$tmp/not-a-repo" && item_worktree noref-src 90 >/dev/null 2>&1) || rc=$?
chk "adoption fails closed when the caller has no repository" "$rc" "20"
chk "and no marker is written" "$([[ -f "$noref_gd/conveyor-owner" ]] && echo present || echo none)" "none"
cd "$tmp/repo"

# 11. resume: a worktree a dead run left dirty is carried on from, not refused.
# The brief is what the adapter appends to its prompt, so it has to contain the
# diff itself — an agent told to verify leftovers it cannot see cannot do it.
res=$(item_worktree demo 70)
cd "$res"
resume_leftovers 70
chk "a clean tree needs no brief" "${RESUME_BRIEF:-}" ""
echo 'half a line' >> file.txt
echo 'a new test' > new_test.txt
resume_leftovers 70 2>/dev/null
chk "a dirty tree is resumed, not blocked" "$([[ -n "$RESUME_BRIEF" ]] && echo brief)" "brief"
chk "the brief carries the diff"           "$(grep -c 'half a line' <<<"$RESUME_BRIEF")" "1"
chk "and names the untracked file"         "$(grep -c 'new_test.txt' <<<"$RESUME_BRIEF")" "1"
chk "and warns against a blind commit"     "$(grep -c 'git add -A' <<<"$RESUME_BRIEF")" "1"

# the count only survives while the branch tip does not move.
chk "the attempt count is kept out of the tree" \
	"$(git status --porcelain | grep -c conveyor-resume || true)" "0"
resume_leftovers 70 2>/dev/null
chk "resuming again at the same tip counts up" \
	"$(cut -d' ' -f1 "$(git rev-parse --git-dir)/conveyor-resume")" "2"
git add -A && git commit --quiet -m 'the resume committed something'
echo 'more' >> file.txt
resume_leftovers 70 2>/dev/null
chk "a commit resets the count" \
	"$(cut -d' ' -f1 "$(git rev-parse --git-dir)/conveyor-resume")" "1"

# 12. the two things that still stop it. Both run in a subshell: `blocked`
# exits 20, and the point is that it does.
export CONVEYOR_RESULT="$tmp/blocked.json"
: > "$CONVEYOR_RESULT"
rc=0; (RESUME_MAX_ATTEMPTS=1 resume_leftovers 70 >/dev/null 2>&1) || rc=$?
chk "a loop stops the item"        "$rc" "20"
chk "and it stops with kind worktree" "$(jq -r .kind "$CONVEYOR_RESULT")" "worktree"

# 12b. blocked and asks merge onto what is already in $CONVEYOR_RESULT rather
# than replacing it — the whole point being a field a caller wrote first (the
# claude adapter's record_session is the one today) survives being blocked.
echo '{"session": "sess-1"}' > "$CONVEYOR_RESULT"
rc=0; (blocked turns "hit the wall" >/dev/null 2>&1) || rc=$?
chk "blocked still exits 20"                "$rc" "20"
chk "blocked merges onto an existing field" "$(jq -r .session "$CONVEYOR_RESULT")" "sess-1"
chk "and adds its own"                      "$(jq -r .kind "$CONVEYOR_RESULT")" "turns"
echo '{"session": "sess-2"}' > "$CONVEYOR_RESULT"
rc=0; (asks decision "ship or not?" >/dev/null 2>&1) || rc=$?
chk "asks merges the same way" "$(jq -r '[.session,.kind,.asked] | join(",")' "$CONVEYOR_RESULT")" "sess-2,decision,true"
# and it still works from nothing, same as before either helper existed.
rm -f "$CONVEYOR_RESULT"
rc=0; (blocked worktree "dirty" >/dev/null 2>&1) || rc=$?
chk "blocked still works with nothing written first" "$(jq -r .kind "$CONVEYOR_RESULT")" "worktree"
: > "$CONVEYOR_RESULT"
touch -d "30 days ago" file.txt new_test.txt
rc=0; (RESUME_COLD_DAYS=14 resume_leftovers 70 >/dev/null 2>&1) || rc=$?
chk "cold leftovers stop the item" "$rc" "20"
chk "and say how old they are"     "$(jq -r .reason "$CONVEYOR_RESULT" | grep -c '30 days old')" "1"
# fresh again, and it resumes as before.
: > "$CONVEYOR_RESULT"
touch file.txt new_test.txt
rc=0; (RESUME_COLD_DAYS=14 resume_leftovers 70 >/dev/null 2>&1) || rc=$?
chk "fresh leftovers do not"       "$rc" "0"
cd "$tmp/repo"

# 9. sourcing must not eat the caller's PATH. In zsh `path` is tied to `PATH`,
# so a local named `path` in here silently disables every later command.
before=$PATH
item_worktree demo 46 >/dev/null 2>&1 || true
chk "PATH survives being sourced" "$PATH" "$before"

# 10. the time budget. The agent's deadline is derived from the engine's, so a
# stage timeout changed in conveyor.yaml moves both and neither can go stale.
export CONVEYOR_RESULT="$tmp/result.json"
brief=$(CONVEYOR_DEADLINE=$(date -u -d '+35 minutes' +%Y-%m-%dT%H:%M:%SZ) WRAP_UP_GRACE=300 deadline_brief)
want_soft=$(date -u -d '+30 minutes' +'%H:%M UTC')
want_hard=$(date -u -d '+35 minutes' +'%H:%M UTC')
chk "the brief names the engine's kill time" "$(grep -c "killed at" <<<"$brief")" "1"
chk "and the hard deadline itself"           "$(grep -c "$want_hard" <<<"$brief")" "1"
chk "and a wrap-up one grace earlier"        "$(grep -c "$want_soft" <<<"$brief")" "1"
chk "and where to write an unfinished stop"  "$(grep -c "$CONVEYOR_RESULT" <<<"$brief")" "1"

# No timeout is a real configuration. An adapter must be able to tell it apart
# from a deadline in the past — a stage with no limit that told its agent it was
# out of time would end every run on the first instruction it read.
chk "no deadline, no brief" "$(CONVEYOR_DEADLINE= deadline_brief | wc -c)" "0"
chk "an unreadable one is the same" "$(CONVEYOR_DEADLINE=whenever deadline_brief | wc -c)" "0"

# A grace wider than the stage would put the wrap-up before the run began.
brief=$(CONVEYOR_DEADLINE=$(date -u -d '+2 minutes' +%Y-%m-%dT%H:%M:%SZ) WRAP_UP_GRACE=600 deadline_brief)
chk "a grace wider than the stage still reads" "$(grep -c "$(date -u -d '+2 minutes' +'%H:%M UTC')" <<<"$brief")" "2"

exit $fail
