#!/usr/bin/env bash
# Sourced by the agent adapters and by agents/claude/approve. The one shared
# rule for finding an item's pull request: by closing reference, never by
# `gh pr list --search`, which matches a number anywhere in any PR's text and
# silently takes the first hit — issue #188 was handed #366, whose body said
# "depends on #188", and the agent spent its run noticing.
#
# Every caller gets the same three outcomes and acts on each differently:
# none (no PR closes the issue), several (two or more candidates — never
# picked between), and unavailable (the gh call failed, returned something
# that is not JSON, or the page it returned might not be the whole list).
# Unavailable must never read as none: implement would open a second PR for
# work that already has one, and a moment's `gh` outage would cost nothing
# were it not mistaken for a verdict.

# pr_match_filter <ref> — reads a `gh pr list --json number,body,state,
# headRefName,url` array on stdin and prints the subset that closes #ref: the
# body says so in GitHub's own closing-keyword grammar, or the branch is this
# item's own issue-<ref> — the name agents/_worktree always gives it. Fenced
# code blocks are stripped from the body first, so a template's example
# ("Closes #123") or a past PR's body quoted into this one is not mistaken
# for a live instruction; a mention with no closing keyword ("depends on
# #188", "see #42") was already excluded by the keyword requirement itself.
# Sorted open first, then newest first within a state.
#
# The one rule closing_prs below and approve's discover_pr both filter
# through, so a body one of them would call a match and the other would not
# can never happen.
pr_match_filter() {
	local ref=$1
	jq --arg ref "$ref" '
		[.[] | select(
			(((.body // "") | gsub("```[\\s\\S]*?```"; "")) |
				test("\\b(close[sd]?|fix(e[sd])?|resolve[sd]?)\\b:?\\s*#" + $ref + "\\b"; "i"))
			or .headRefName == ("issue-" + $ref))]
		| sort_by(.state != "OPEN", -.number)'
}

# closing_prs <ref> [state] — on success, prints a JSON array of
# {number,body,state,headRefName,url} for every PR that closes #ref, filtered
# server-side to `gh pr list --state <state>` (default "open"; approve passes
# "all"), open first then newest first within a state. Prints nothing and
# returns 1 when the answer cannot be trusted.
closing_prs() {
	local ref=$1 state=${2:-open} out matches n_all n_match
	if ! out=$(gh pr list --repo "$REPO" --state "$state" --limit 100 \
		--json number,body,state,headRefName,url 2>&1); then
		echo "gh pr list (state=$state) for #$ref failed: $out" >&2
		return 1
	fi
	if ! jq -e . >/dev/null 2>&1 <<<"$out"; then
		echo "gh pr list (state=$state) for #$ref returned something that is not JSON: $out" >&2
		return 1
	fi

	matches=$(pr_match_filter "$ref" <<<"$out")

	n_all=$(jq 'length' <<<"$out")
	n_match=$(jq 'length' <<<"$matches")
	# gh's own page cap. A full page with no match in it might be hiding one
	# behind — the API makes no promise this page is the whole list — so this
	# is unavailable, not none.
	if [[ "$n_all" -ge 100 && "$n_match" -eq 0 ]]; then
		echo "gh pr list (state=$state) for #$ref returned a full page with no match; it may be truncated" >&2
		return 1
	fi
	printf '%s' "$matches"
}

# pr_lookup <ref> [state] — the shared three-way outcome. Sets $PR_STATUS to
# one of none / one / several / unavailable, and on "one" also $PR_NUMBER,
# $PR_STATE, $PR_HEAD. $PR_MATCHES is always the raw array closing_prs found
# (empty on unavailable), for a caller like approve that needs its own notion
# of "active" (state != CLOSED) rather than "exactly one match of any state".
pr_lookup() {
	local ref=$1 state=${2:-open} matches n
	PR_STATUS=unavailable PR_NUMBER="" PR_STATE="" PR_HEAD="" PR_MATCHES="[]"
	matches=$(closing_prs "$ref" "$state") || return 0
	PR_MATCHES=$matches
	n=$(jq 'length' <<<"$matches")
	if [[ "$n" -eq 0 ]]; then
		PR_STATUS=none
	elif [[ "$n" -eq 1 ]]; then
		PR_STATUS=one
		PR_NUMBER=$(jq -r '.[0].number' <<<"$matches")
		PR_STATE=$(jq -r '.[0].state' <<<"$matches")
		PR_HEAD=$(jq -r '.[0].headRefName' <<<"$matches")
	else
		PR_STATUS=several
	fi
}

# open_pr <ref> — the number of the one open PR for #ref, or nothing on none,
# several or unavailable alike. Kept for a caller that only ever wanted a
# plain "found it or didn't" string test; one that must tell those three
# apart — never opening a second PR because a blip read as "none" — calls
# pr_lookup directly instead.
open_pr() {
	pr_lookup "$1" open
	[[ "$PR_STATUS" == "one" ]] && printf '%s' "$PR_NUMBER"
}

# item_landed <ref> — asks GitHub's own record of what closed the issue,
# never a list to page through: Issue.closedByPullRequestsReferences. Sets
# $LANDED to exactly one of yes / no / unavailable, and always sets
# $ISSUE_STATE to the issue's own OPEN/CLOSED (empty on unavailable) — a
# caller telling apart "nothing landed because it is still open" from
# "nothing landed even though it is closed" needs that, and it comes free
# with the one call this makes.
#
# "yes" requires both that the issue is CLOSED and that at least one pull
# request GitHub recorded as closing it has merged: true; on yes, $LANDED_PR
# is that pull request's number, for the log. A closed issue whose only
# closer was closed unmerged is "no", so is a closed issue with no closer at
# all, so is an open issue — the ordinary, expected answer for most items
# that reach this call, and not a thing to defer on.
#
# This is not a second way to choose a pull request to work on — pr_lookup
# above, filtered through pr_match_filter, stays the one lookup for that.
# This only ever answers "did this item's work already land".
#
# One call, server-side, so it cannot be defeated by a repository with more
# merged pull requests than a listing page holds — the reason this is not
# `gh pr list --state merged`. Any failure of that call — non-zero exit,
# output that is not JSON, a payload carrying an `errors` array — sets
# unavailable and prints why on stderr, the same rule closing_prs already
# applies: unavailable must never read as a verdict.
item_landed() {
	local ref=$1 owner=${REPO%%/*} name=${REPO#*/} out
	LANDED=unavailable LANDED_PR="" ISSUE_STATE=""
	if ! out=$(gh api graphql -f query='
		query($owner: String!, $name: String!, $number: Int!) {
			repository(owner: $owner, name: $name) {
				issue(number: $number) {
					state
					closedByPullRequestsReferences(first: 10, includeClosedPrs: true, userLinkedOnly: false) {
						nodes { number state merged url }
					}
				}
			}
		}' -F owner="$owner" -F name="$name" -F number="$ref" 2>&1); then
		echo "gh api graphql (issue #$ref closing references) failed: $out" >&2
		return 0
	fi
	if ! jq -e . >/dev/null 2>&1 <<<"$out"; then
		echo "gh api graphql (issue #$ref closing references) returned something that is not JSON: $out" >&2
		return 0
	fi
	if jq -e '.errors' >/dev/null 2>&1 <<<"$out"; then
		echo "gh api graphql (issue #$ref closing references) returned errors: $(jq -c '.errors' <<<"$out")" >&2
		return 0
	fi
	ISSUE_STATE=$(jq -r '.data.repository.issue.state // empty' <<<"$out")
	if [[ "$ISSUE_STATE" != "CLOSED" ]]; then
		LANDED=no
		return 0
	fi
	LANDED_PR=$(jq -r '[.data.repository.issue.closedByPullRequestsReferences.nodes[]
		| select(.merged == true)][0].number // empty' <<<"$out")
	if [[ -n "$LANDED_PR" ]]; then
		LANDED=yes
	else
		LANDED=no
	fi
}
