#!/usr/bin/env bash
# Sourced by the agent adapters. Reads an item's declared dependencies so a
# stage can refuse to start work that is sequenced behind something still
# open — before the model runs, not after it has spent a run finding out.
#
# Nine of the seventeen "needs a decision" stops in one week were an agent
# reading "Depends on #353" in the body and stopping because #353 was open.
# That is not a decision; it is a condition with a known end, so it is a
# `dependency` mark, and the doctor clears it once every number named is
# closed (agents/claude/doctor).

# dependency_refs <body> — the issue numbers named in a clause that declares a
# dependency: "Depends on #12", "Blocked by: #12, #13", "- depends on #12", or
# a clause reached mid-line — "Part of the epic (#8). Depends on #10, #11."
# donates only #10 and #11, not #8. Nothing else in the body is read; a
# "Related: #9" is not a dependency.
#
# The body is split into clauses at every mid-line sentence break (". ")
# before a clause is checked for the keyword, so a clause is read against the
# keyword it actually contains rather than the line it happens to share with
# one. "Depends on: ADR 9 (merged). Blocks: #12, #13 depend on this one"
# splits into two clauses, and the second's "depend on" (no s, so no keyword
# match of its own) does not donate #12 and #13 to this issue's own
# dependency list just because the word "depend" recurs there.
#
# Within a matching clause, only the text from the keyword onward counts, so
# a number mentioned earlier in the same clause — "Related to #9, this
# depends on #12" — donates #12 and not #9: the cut is taken relative to the
# keyword, never to the start of the clause or the line.
dependency_refs() {
	sed -E 's/\.[[:space:]]+/\n/g' <<<"$1" |
		grep -ioE '\b(depends on|blocked by|blocks on|requires|after)\b.*' |
		grep -oE '#[0-9]+' | tr -d '#' | sort -un
}

# open_dependencies <body> — "#12 #13" for every named dependency that is
# still open, or nothing. An issue that cannot be read is not counted: a
# number from another repository or a typo must not hold an item forever.
open_dependencies() {
	local n out=""
	for n in $(dependency_refs "$1"); do
		if [[ "$(gh api "repos/$REPO/issues/$n" --jq .state 2>/dev/null)" == "open" ]]; then
			out="${out:+$out }#$n"
		fi
	done
	printf '%s' "$out"
}
