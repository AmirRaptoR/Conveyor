#!/usr/bin/env bash
# Review the pull request for an item, with Codex.
#
# A different agent on purpose: the model that wrote the code is the worst
# reviewer of it. Config: PROMPT (required), REPO.
set -euo pipefail

source "$(dirname "$0")/../_blocked"

: "${PROMPT:?PROMPT is required (set it in this script params: block)}"
: "${REPO:?REPO is required (set it in the source env: block)}"

payload=$(cat)
ref=$(jq -r '.item.ref' <<<"$payload")

pr=$(gh pr list --repo "$REPO" --state open --search "$ref" --json number --jq '.[0].number' 2>/dev/null)
if [[ -z "$pr" ]]; then
	blocked input "no open pull request references #$ref, so there is nothing to review."
fi

echo "reviewing PR #$pr for item #$ref"

full="Pull request #${pr} in ${REPO}, which closes item #${ref}.

${PROMPT}

End your reply with exactly APPROVED or CHANGES_REQUESTED on its own line."

set +e
out=$(codex exec "$full" --skip-git-repo-check 2>&1)
rc=$?
set -e
printf '%s\n' "$out"

[[ $rc -ne 0 ]] && exit $rc

# Exit codes are the routing, so they have to mean the right things here:
#
#   0   approved            -> onSuccess, normally done
#   1   changes requested   -> onFailure, normally back to implementation. The
#                              engine counts these, and maxAttempts forces the
#                              item to onBlocked once the loop has run enough.
#   20  cannot review       -> onBlocked, a human. Not a verdict on the code.
#
# Changes-requested must NOT be 20: blocked clears the attempt counter and goes
# straight to a human, so the rework loop would never happen.
if grep -q 'CHANGES_REQUESTED' <<<"$out"; then
	echo "review requested changes on PR #$pr" >&2
	exit 1
fi
exit 0
