#!/usr/bin/env bash
# Sourced by the agent adapters. Not a verb: config resolves script names
# exactly, and `agent:` only ever looks inside agents/<name>/, so a file here
# with a leading underscore can never be mistaken for one.
#
# Every adapter has preflight checks that stop before the model runs — a dirty
# worktree, no pull request to review. Those exited 20 with the reason only in
# the log, and a log is not structured data: the engine hands `move` whatever is
# in $CONVEYOR_RESULT, so the issue ended up wearing a mark with no comment
# beside it and the board could say nothing about why it stopped.

# _write_stop <jq args...> <filter> — the merge blocked and asks share: apply
# filter to whatever is already in $CONVEYOR_RESULT (an empty object if there
# is nothing, or nothing readable), so a field a caller wrote before stopping
# survives being blocked.
_write_stop() {
	[[ -z "${CONVEYOR_RESULT:-}" ]] && return 0
	local tmp base
	tmp=$(mktemp)
	base='{}'
	[[ -s "$CONVEYOR_RESULT" ]] && jq -e . "$CONVEYOR_RESULT" >/dev/null 2>&1 && base=$(cat "$CONVEYOR_RESULT")
	if jq "$@" <<<"$base" >"$tmp" 2>/dev/null; then
		mv "$tmp" "$CONVEYOR_RESULT"
	else
		rm -f "$tmp"
	fi
}

# blocked <kind> "<reason>" — record why a human is needed, then stop.
#
# Writes the convention every agent shares, so one is enough to teach: exit 20,
# with {"blocked": true, "kind": "...", "reason": "..."} in $CONVEYOR_RESULT.
#
# The kind is one word and the board shows only that: a column of paragraphs is
# a column you cannot read across, and telling "the agent ran out of quota" from
# "someone has to decide something" at a glance is most of what a board is for.
# The vocabulary is ours, not the engine's — it never reads it — so keep it
# short, lower case, and the same word for the same situation everywhere:
#
#   decision    a person must choose something before the work can be specified
#   limit       the agent was out of quota; nothing is wrong with the item
#   turns       the agent exhausted its turn budget before finishing; the work
#               so far is real, not a fault, and a resumable session usually
#               sits beside this kind (see agents/claude/_stream:record_session)
#   worktree    the checkout is not in a state the work can start from
#   no-output   the agent finished but produced nothing the provider can see
#   input       the item itself is missing something (no criteria, no PR)
#   dependency  the item names an issue that is still open; clears once it is
#   unfinished  the run stopped itself at its deadline with work pushed and a
#               conversation to resume into (agents/_deadline)
#
# A question can carry `questions`: the AskUserQuestion shape (header,
# question, options[{label, description}], multiSelect), which the board turns
# into a modal a person answers one at a time. The engine passes it through
# unread, like `session`. See decision_brief below for the exact text.
#
# Merges onto whatever is already in $CONVEYOR_RESULT rather than replacing it,
# so a caller that wrote something first — record_session's {"session": "..."}
# is the one case today — is not made to choose between "block" and "keep what
# I already said". Nothing currently writes before calling blocked or asks
# except that one caller, so this changes no existing behaviour.
blocked() {
	local kind=$1 reason=$2
	_write_stop --arg kind "$kind" --arg reason "$reason" '. + {blocked: true, kind: $kind, reason: $reason}'
	echo "blocked ($kind): $reason" >&2
	exit 20
}

# asks <kind> "<question>" — stop because a person has to answer something.
#
# The same mark, with one bit more: `asked`. A stop is one of two things and
# they are not interchangeable. A condition — out of quota, a dirty checkout, a
# network that was down — may have passed by the time anyone looks, so clearing
# it in bulk and trying again is a reasonable thing for a tired operator or a
# timer to do. A question has not passed. Nobody answered it by waiting, and
# handing it back unanswered spends an agent run to be asked it a second time.
#
# So the engine bulk-clears conditions and never bulk-clears questions: not on
# `Unblock all`, not on `retryStalled`, not when an agent's quota returns. The
# only thing that clears a question is a person answering it on the card.
#
# Condition is the default because it is the safe one to get wrong: a condition
# wrongly retried costs one run, a question wrongly cleared costs the run *and*
# asks you the same thing again.
# decision_brief — the paragraph every adapter appends to its prompt saying how
# to stop for a person. One place, so the shape the board reads is the shape
# every agent writes. The shape is AskUserQuestion's: the model already knows
# it, the tool itself is not available in a headless run (verified: `claude -p`
# does not expose it), and options are what turn "a paragraph in a comment"
# into a button a person can press.
decision_brief() {
	cat <<-BRIEF
	If this cannot be done because it needs a decision only a human can make,
	change nothing and write this to the file at ${CONVEYOR_RESULT}:

	  {"blocked": true, "kind": "decision",
	   "reason": "<the decision needed, in one sentence>",
	   "questions": [{"header": "<label, under 12 chars>",
	                  "question": "<the full question, self-contained>",
	                  "options": [{"label": "<1-5 words>", "description": "<what choosing it means>"}],
	                  "multiSelect": false}]}

	One entry per question, two to four options each, the one you would pick
	listed first. This is the AskUserQuestion shape; that tool is not available
	here, so the file is how you ask. A person answers on the board and the
	reply reaches this same conversation. Do not stop for something you can
	verify yourself, and do not stop because a dependency is open — say so in
	one line and continue with what does not depend on it.
	BRIEF
}

asks() {
	local kind=$1 question=$2
	_write_stop --arg kind "$kind" --arg reason "$question" \
		'. + {blocked: true, kind: $kind, reason: $reason, asked: true}'
	echo "asks ($kind): $question" >&2
	exit 20
}
