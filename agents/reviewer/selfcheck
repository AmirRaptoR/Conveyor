#!/usr/bin/env bash
set -euo pipefail

source_dir=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/agents/claude" "$tmp/agents/codex"
cp -R "$source_dir" "$tmp/agents/reviewer"

fail=0
check() {
	if [[ "$2" == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fail=1; fi
}

# Any Claude invocation is a test failure. The fixture exists specifically to
# prove an installed, available Claude backend cannot be selected.
cat >"$tmp/agents/claude/review" <<'SCRIPT'
#!/usr/bin/env bash
printf 'claude-called\n' >>"$CALLS"
exit 99
SCRIPT
cat >"$tmp/agents/claude/status" <<'SCRIPT'
#!/usr/bin/env bash
printf 'claude-status-called\n' >>"$CALLS"
exit 99
SCRIPT

cat >"$tmp/agents/codex/review" <<'SCRIPT'
#!/usr/bin/env bash
payload=$(cat)
printf '%s\t%s\t%s\n' "$CONVEYOR_AGENT_BACKEND" "${MODEL:-}" "$payload" >>"$CALLS"
printf '%s\n' '{"v":1,"outcome":"success"}' >"$CONVEYOR_RESULT"
SCRIPT
cat >"$tmp/agents/codex/status" <<'SCRIPT'
#!/usr/bin/env bash
printf 'codex-status-called\n' >>"$CALLS"
printf '%s\n' '{"state":"ok","summary":"Codex available"}' >"$CONVEYOR_RESULT"
SCRIPT
chmod +x "$tmp/agents/claude/"{review,status} "$tmp/agents/codex/"{review,status}

: >"$tmp/calls"
CONVEYOR_RESULT="$tmp/stage-result.json" CALLS="$tmp/calls" \
	CLAUDE_MODEL=claude-must-not-run CODEX_MODEL=gpt-5.6-sol \
	"$tmp/agents/reviewer/review" <<<'{"item":{"ref":"67"}}' >/dev/null 2>&1
check "review dispatches Codex Sol" "$(head -1 "$tmp/calls")" $'codex\tgpt-5.6-sol\t{"item":{"ref":"67"}}'
check "review never invokes Claude" "$(grep -c 'claude-called' "$tmp/calls" || true)" "0"
check "Codex result is preserved" "$(jq -r .outcome "$tmp/stage-result.json")" "success"

: >"$tmp/calls"
CONVEYOR_RESULT="$tmp/status-result.json" CALLS="$tmp/calls" \
	"$tmp/agents/reviewer/status" >/dev/null 2>&1
check "status delegates to Codex" "$(cat "$tmp/calls")" "codex-status-called"
check "status never probes Claude" "$(grep -c 'claude-status-called' "$tmp/calls" || true)" "0"
check "Codex status is preserved" "$(jq -r .summary "$tmp/status-result.json")" "Codex available"

exit "$fail"
