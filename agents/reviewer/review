#!/usr/bin/env bash
# Codex-only review adapter. Keeping the reviewer alias lets production sources
# change backend policy without teaching the engine schema about model vendors.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
export CONVEYOR_AGENT_BACKEND=codex
if [[ -n "${CODEX_MODEL:-}" ]]; then
	export MODEL=$CODEX_MODEL
fi
echo "Selecting Codex review." >&2
exec "$here/../codex/review"
