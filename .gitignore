# Local runtime state — the reports store lives outside the repo on purpose
# (see docs/decisions): an agent that can run `git clean -xdf` must not be able
# to erase its own audit trail.
/data/
/tmp/

# The working config; conveyor.example.yaml is the tracked template.
/conveyor.yaml
# The binary, and the two names the deploy script builds and rolls back through.
/conveyor
/conveyor.new
/conveyor.prev

# Migration material from the old machine: personal skills, a systemd unit, and
# repos.conf naming private repositories. Local to this machine, not the project.
/conveyor-handoff/
/conveyor-handoff.tar.gz
